# build
dist/
.astro/
node_modules/
__pycache__/
*.pyc

# secrets — never commit
.env
.env.*
!.env.example
supabase/.temp/
supabase/functions/booking-request/content.generated.json

# local tooling
.claude/settings.local.json
screenshots/

# synced from content/images/ by build.py
public/images/
# generated by scripts/flags.mjs from node_modules/flag-icons on every build
public/flags/

# source material kept outside the website repo (knowledge base, brand identity with videos/PDFs)
Armada Residence Knowledge Base/
الهوية النهائية لفنادق أرمادا ريزدنس/
DECISIONS_append_*.md
# the two Wi-Fi password cards (Guest Hub H4, 13 Nov 2026): loaded once on production, never committed — the repo is public
wifi-cards.json
guest-hub-h4-files*.zip

# os / editors
.DS_Store
Thumbs.db
*.log

# legacy site exports (reference only, never built from)
legacy-sites/

# brand source material (café creative work, menu videos, fact-sheet PDFs) — the website uses public/brand/*.svg only.
# Tracked exception: brand/cafe/ملفات الهوية/vector/ (café identity as real vectors — logos, monogram, favicon).
brand/*
!brand/cafe/
brand/cafe/*
!brand/cafe/ملفات الهوية/
brand/cafe/ملفات الهوية/*
!brand/cafe/ملفات الهوية/vector/

# lighthouse / trace reports (summaries are kept)
reports/**/*.json
reports/trace.json

# dashboard (admin/): local env + build output; the example stays tracked
!admin/.env.local.example

# dashboard media «الصور» (1 Nov 2026): derived files and data written by scripts/media-build.mjs on every build
.media-build/
.media-cache/
.media-sample/
content/media.generated.json
# the fees the static site states, from Settings at build time (build.py resolve_fees, 2 Nov 2026)
content/fees.generated.json
content/offers.generated.json
# the articles published from the dashboard «المدونة» (scripts/blog-build.mjs, 3 Nov 2026)
content/articles.generated/
# the FAQ published from the dashboard «الأسئلة الشائعة» (scripts/faq-build.mjs, 3 Nov 2026)
content/faq.generated.json
# «المحتوى والظهور»: published texts, hidden pages, the announcement bar (scripts/content-build.mjs, 3 Nov 2026)
content/content.generated.json
# the guest reviews published from the dashboard «آراء الضيوف» (scripts/reviews-build.mjs, 7 Nov 2026)
content/reviews.generated.json
# the room types of the dashboard «الغرف» (build.py resolve_rooms, 10 Nov 2026)
content/rooms.generated.json
# the partner logos published from the dashboard «شعارات الشركاء» (scripts/partner-logos-build.mjs, 7 Nov 2026);
# their files go to public/images/partner-logos/, already under public/images/ above
content/partner-logos.generated.json
public/images/partner-logos/

# the old dashboard archive (7 Nov 2026): screenshots with guest data — never in git
/archive/
