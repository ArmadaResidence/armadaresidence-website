# Copy to .env for local builds. Never commit .env. Values are provided by Ahmed — none are invented here.

# --- Site (public, baked into the static build) ---
# Full URL of the deployed Supabase Edge Function that receives booking requests, e.g.
#   https://<project-ref>.supabase.co/functions/v1/booking-request
# Leave empty to make the form fall back to a prefilled WhatsApp message (no email is sent).
PUBLIC_BOOKING_ENDPOINT=
# Supabase anon key (public). Sent as the Authorization bearer to the Edge Function.
PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Edge Function secrets (set with `supabase secrets set`, never in the client) ---
# supabase/functions/booking-request reads these from Deno.env
RESEND_API_KEY=
# Senders are fixed in the function (decision 22 Oct 2026): reception notification from
# "Armada Residence Bookings <no-reply@armadaresidence.com>", guest confirmation from
# "أرمادا ريزيدنس | Armada Residence <reservation@armadaresidence.com>". Override only to switch the verified domain:
BOOKING_FROM_RECEPTION=
BOOKING_FROM_GUEST=
# Salt for the per-IP rate-limit hash (any random string; the IP itself is never stored)
BOOKING_IP_SALT=
# Automatically available inside Supabase Edge Functions; listed here only for local `supabase functions serve`
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated origins allowed to call the function (CORS)
BOOKING_ALLOWED_ORIGINS=https://armadaresidence.com,http://localhost:4321
# --- Phase 2a (25 Oct 2026) ---
# Test mode for the booking endpoint and the QA fixtures: requests carrying header x-armada-test with this value are
# stored as is_test and every email goes to Resend's sink. Any random string; its sha256 must also be inserted into
# internal.test_tokens (see supabase/tests/README.md). Supabase secret + local value for scripts/booking-race-check.mjs.
BOOKING_TEST_TOKEN=
# Dashboard origin baked into the emails' "open the inventory calendar" link and the functions' CORS (build.py ADMIN_URL).
ADMIN_URL=https://admin.armadaresidence.com
# Dashboard build (admin/): the project URL and PUBLISHABLE key — public by design, RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Site build: the same publishable key for the two read-only price RPCs (quote_stay, room_from_prices).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
