#!/bin/sh
# Before every push (CLAUDE.md §11): the FAST checks (no browser) on the commit being pushed (its tree exported to a temp
# folder: node scripts/check-all.mjs --commit <sha>). Skipped when that tree already passed on this machine (the commit
# hook records it); check-all prints which. Since 9 Nov 2026 (Ahmed) the browser checks, the pixel guard and the sample
# qa run in GitHub Actions after the push, and the deploy waits for them. Any failure blocks the push; fix the cause,
# never --no-verify.
zero=0000000000000000000000000000000000000000
shas=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a branch being deleted: nothing to check
  case " $shas " in *" $local_sha "*) ;; *) shas="$shas $local_sha" ;; esac
done
for sha in $shas; do
  node scripts/check-all.mjs --commit "$sha" --skip-if-passed </dev/null || exit 1
done
exit 0
