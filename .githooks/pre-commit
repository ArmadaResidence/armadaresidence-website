#!/bin/sh
# Before every commit (CLAUDE.md §11): the FAST checks on the staged snapshot — exactly what this commit records, not
# other uncommitted edits in the folder: build, qa and the static checks that need no browser (typecheck, digits,
# format, auth-emails, whatsapp, offers-engine, turnstile, deploy-alert); a docs-only commit skips the build. No browser
# runs here since 9 Nov 2026 (Ahmed: 4 GB of memory) — every browser check, the pixel guard and the sample qa run in
# GitHub Actions on the push, and the deploy waits for them. The whole suite by hand: node scripts/check-all.mjs.
# A failing check blocks the commit; fix the cause, never --no-verify.
# Enable once per clone: git config core.hooksPath .githooks
exec node scripts/check-all.mjs --staged
