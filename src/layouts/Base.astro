---
import '../styles/global.css';
import { GTM_ID, absoluteUrl, dir, localePath, seo, siteName, type Locale } from '@lib/content';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';

interface Props {
  locale: Locale;
  /** Locale-independent path, e.g. "/airport-road/" */
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: unknown[];
  /** Branch slug for the sticky WhatsApp button; omit for the two-branch chooser. */
  whatsapp?: string;
  ogImage?: string;
  /** Where the language switch goes when this page has no twin (404). Defaults to `path`. */
  switchPath?: string;
  /** Favicon set; the café menu page swaps in the café favicon (brand/cafe identity). */
  icons?: { svg: string; png32: string; apple: string };
  /** /menu/ renders the café's own footer inside .legacy-menu instead of the hotel footer. */
  hideFooter?: boolean;
}

const {
  locale,
  path,
  title,
  description,
  noindex = false,
  jsonld = [],
  whatsapp,
  ogImage = seo.default_og_image,
  switchPath = Astro.props.path,
  icons = { svg: '/favicon.svg', png32: '/icons/favicon-32.png', apple: '/icons/apple-touch-icon.png' },
  hideFooter = false,
} = Astro.props;

const canonical = absoluteUrl(localePath(locale, path));
const arUrl = absoluteUrl(localePath('ar', path));
const enUrl = absoluteUrl(localePath('en', path));
const ogImageUrl = absoluteUrl(ogImage);
const ogLocale = locale === 'ar' ? 'ar_SA' : 'en_US';
const ogLocaleAlt = locale === 'ar' ? 'en_US' : 'ar_SA';
// "</" inside JSON must not terminate the script tag.
const ld = jsonld.map((j) => JSON.stringify(j).replace(/</g, '\\u003c'));
---

<!doctype html>
<html lang={locale} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F3EFE7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0F1F2B" />
    <script is:inline>
      // theme before first paint: stored choice (armada-theme) → else prefers-color-scheme (and follow its changes)
      (function () {
        try {
          var s = localStorage.getItem('armada-theme');
          var m = matchMedia('(prefers-color-scheme: dark)');
          var t = s === 'dark' || s === 'light' ? s : m.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
          if (!s) m.addEventListener('change', function (e) { document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light'); });
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={arUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName(locale)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content={seo.twitter_card} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href={icons.svg} type="image/svg+xml" />
    <link rel="icon" href={icons.png32} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={icons.apple} sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    {ld.map((json) => <script type="application/ld+json" set:html={json} />)}
    <script is:inline define:vars={{ GTM_ID }}>
      window.dataLayer = window.dataLayer || [];
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', GTM_ID);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-porcelain text-ink">
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>
    <Header locale={locale} path={path} switchPath={switchPath} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer locale={locale} switchPath={switchPath} />}
    <WhatsAppButton locale={locale} branch={whatsapp} />
  </body>
</html>
