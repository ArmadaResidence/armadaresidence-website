---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import fontAr400 from '../assets/fonts/ibm-plex-sans-arabic-arabic-400-subset.woff2?url';
import fontAr700 from '../assets/fonts/ibm-plex-sans-arabic-arabic-700-subset.woff2?url';
import fontEn from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { GTM_ID, absoluteUrl, dir, localePath, seo, siteName, turnstileKey, type BookingContext, type Locale } from '@lib/content';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BookingDrawer from '@components/BookingDrawer.astro';
import OfferPopupDialog from '@components/OfferPopup.astro';
import { offerPopup, siteBar } from '@lib/offers-data';
import CookieConsent from '@components/CookieConsent.astro';
import { cookieConsent } from '@lib/content';

interface Props {
  locale: Locale;
  /** Locale-independent path, e.g. "/airport-road/" */
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: unknown[];
  /** Branch slug for the sticky WhatsApp button; omit for the two-branch chooser. */
  whatsapp?: string;
  ogImage?: string;
  /** Open Graph type: "article" on blog posts, "website" elsewhere. */
  ogType?: 'website' | 'article';
  /** Where the language switch goes when this page has no twin (404, a one-language article). Defaults to `path`. */
  switchPath?: string;
  /** false: the page exists in this language only (a one-language article, 3 Nov 2026) — no hreflang alternates */
  alternates?: boolean;
  /** a canonical other than the page itself (an article's SEO field) — an absolute URL */
  canonicalHref?: string;
  /** The 404 page is served at every unknown URL: no canonical, hreflang or og:url (30 Oct 2026) — it has no URL of its own. */
  notFound?: boolean;
  /** Favicon set; the café menu page swaps in the café favicon (brand/cafe identity). */
  icons?: { svg: string; png32: string; apple: string };
  /** /menu/ renders the café's own footer inside .legacy-menu instead of the hotel footer. */
  hideFooter?: boolean;
  /** Booking drawer (item 11): on every site page except /booking/ itself and the legacy sections. */
  bookingDrawer?: boolean;
  /** Branch / room this page books for (branch and room pages): the header, menu and footer booking links prefill
      it (Ahmed, 24 Oct 2026); omitted everywhere else, so those links stay empty. */
  booking?: BookingContext;
}

const {
  locale,
  path,
  title,
  description,
  noindex = false,
  jsonld = [],
  whatsapp,
  ogImage = seo.default_og_image,
  ogType = 'website',
  switchPath = Astro.props.path,
  alternates = true,
  canonicalHref,
  notFound = false,
  icons = { svg: '/favicon.svg', png32: '/icons/favicon-32.png', apple: '/icons/apple-touch-icon.png' },
  hideFooter = false,
  bookingDrawer = true,
  booking,
} = Astro.props;

const canonical = canonicalHref ?? absoluteUrl(localePath(locale, path));
// og:url is always the page itself
const selfUrl = absoluteUrl(localePath(locale, path));
const arUrl = absoluteUrl(localePath('ar', path));
const enUrl = absoluteUrl(localePath('en', path));
const ogImageUrl = absoluteUrl(ogImage);
const ogLocale = locale === 'ar' ? 'ar_SA' : 'en_US';
const ogLocaleAlt = locale === 'ar' ? 'en_US' : 'ar_SA';
// "</" inside JSON must not terminate the script tag.
const ld = jsonld.map((j) => JSON.stringify(j).replace(/</g, '\\u003c'));
// View transitions (item 1, 11 Oct 2026): the site's own pages navigate through Astro's ClientRouter (cross-fade,
// shared room media, header kept still). The legacy sections keep full page loads so their markup and scripts are
// untouched: a page without the router falls back to a normal navigation in both directions.
const legacy = path === '/discover-taif/' || path.startsWith('/partners/');
// Font preload (performance pass, 30 Oct 2026): only the weight the LCP text uses — the body 400 on every Arabic page
// (home, branch, room, /offers/, /careers/ measured), the one variable Manrope file on English pages. Preloading 400 +
// 600 + 700 (11 Oct) put three fonts ahead of the stylesheet on a slow connection; the other weights are fetched when
// the CSS asks for them (font-display: swap, so text shows at once and ends in the web font). Same hashed files the CSS uses.
// 8 Nov 2026 (post-launch session 1): the Arabic home page also preloads the 700 weight — its hero title and the
// «فرعانا» heading are bold and in the first view on a phone; arriving after the first paint, its swap shifted the page.
const preloadFonts = locale === 'ar' ? (path === '/' ? [fontAr400, fontAr700] : [fontAr400]) : [fontEn];
---

<!doctype html>
<html lang={locale} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    {turnstileKey && <meta name="armada-turnstile" content={turnstileKey} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F3EFE7" data-theme-color />
    <script is:inline>
      // theme before first paint (Ahmed, 5 Nov 2026): LIGHT for everyone, whatever the device's system setting; dark only
      // when chosen with the header toggle (armada-theme in localStorage, remembered across pages and visits). The
      // theme-color meta follows the active theme (light porcelain / dark midnight). `js` on <html> gates the
      // scroll-reveal styles (no JS → everything visible). Re-applied after a view-transition swap, which replaces the
      // <html> attributes with the new page's.
      (function () {
        function apply() {
          var s = null;
          try { s = localStorage.getItem('armada-theme'); } catch (e) {}
          var t = s === 'dark' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
          document.documentElement.classList.add('js');
          var meta = document.querySelector('meta[data-theme-color]');
          if (meta) meta.setAttribute('content', t === 'dark' ? '#0F1F2B' : '#F3EFE7');
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    {
      /* the announcement bar (2 Nov 2026; one system since 3 Nov 2026): a stored dismissal of this announcement (an
         offer's slug, or the announcement's id), or its last day passed since the build, hides it before the first paint
         (no shift); re-applied after a view-transition swap */
      siteBar && (
        <>
          <style is:inline>html[data-offer-bar-off] .offer-bar{display:none}</style>
          <script is:inline define:vars={{ barSlug: siteBar.id, barUntil: siteBar.until }}>
            (function () {
              function apply() {
                var off = false;
                try { off = localStorage.getItem('armada-offer-bar') === barSlug; } catch (e) {}
                if (barUntil && new Date(Date.now() + 108e5).toISOString().slice(0, 10) > barUntil) off = true;
                if (off) document.documentElement.setAttribute('data-offer-bar-off', '');
              }
              apply();
              document.addEventListener('astro:after-swap', apply);
            })();
          </script>
        </>
      )
    }
    {preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    {!notFound && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      !notFound && alternates && (
        <>
          <link rel="alternate" hreflang="ar" href={arUrl} />
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="x-default" href={arUrl} />
        </>
      )
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName(locale)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={selfUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content={seo.twitter_card} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href={icons.svg} type="image/svg+xml" />
    <link rel="icon" href={icons.png32} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={icons.apple} sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {!legacy && <ClientRouter fallback="animate" />}
    <slot name="head" />
    {ld.map((json) => <script type="application/ld+json" set:html={json} />)}
    <script is:inline define:vars={{ consentVersion: cookieConsent.version, consentDays: cookieConsent.max_age_days }}>
      // Google Consent Mode v2, advanced (Ahmed, 7 Nov 2026; DECISIONS.md 2026-11-07 «Cookie consent»): the defaults are
      // set before GTM is even queued — analytics and ads denied, functionality and security granted, GTM waits up to
      // 500 ms for an update. A stored choice (localStorage armada-consent: this policy version, under max_age_days old)
      // is applied at once; otherwise <html data-consent-open> shows the banner (CookieConsent.astro) from the first
      // paint — never in an automated browser (the check suite) unless localStorage armada-consent-test = 1.
      (function (w, d) {
        w.dataLayer = w.dataLayer || [];
        w.gtag = function () { w.dataLayer.push(arguments); };
        w.gtag('consent', 'default', {
          ad_storage: 'denied', analytics_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
          functionality_storage: 'granted', security_storage: 'granted', wait_for_update: 500,
        });
        var c = null, test = false;
        try {
          c = JSON.parse(localStorage.getItem('armada-consent') || 'null');
          test = localStorage.getItem('armada-consent-test') === '1';
        } catch (e) {}
        var ok = !!c && c.v === consentVersion && typeof c.t === 'number' && Date.now() - c.t < consentDays * 864e5;
        if (ok) {
          var a = c.analytics ? 'granted' : 'denied', m = c.ads ? 'granted' : 'denied';
          w.gtag('consent', 'update', { analytics_storage: a, ad_storage: m, ad_user_data: m, ad_personalization: m });
        }
        function apply() {
          if (!ok && (!navigator.webdriver || test)) d.documentElement.setAttribute('data-consent-open', '');
        }
        apply();
        // a view-transition swap replaces the <html> attributes with the new page's
        d.addEventListener('astro:after-swap', function () {
          var s = null;
          try { s = JSON.parse(localStorage.getItem('armada-consent') || 'null'); } catch (e) {}
          ok = !!s && s.v === consentVersion && typeof s.t === 'number' && Date.now() - s.t < consentDays * 864e5;
          apply();
        });
      })(window, document);
    </script>
    <script is:inline define:vars={{ GTM_ID }}>
      // GTM (decision 10 Oct 2026, tightened 11 Oct): the dataLayer exists from the first byte and queues every push
      // (gtm.start/gtm.js, page events, booking_request…); the container script itself is injected on the first
      // interaction or 3.5 s after window.load, whichever comes first, so the ~1 MB of tags it pulls (GA4, Ads,
      // Meta, TikTok) never competes with the page's own assets or blocks the main thread while the page settles.
      // GTM replays the queue in order when it loads, so page_view and every earlier event are still recorded.
      (function (w, d, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          var j = d.createElement('script');
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + (l != 'dataLayer' ? '&l=' + l : '');
          d.head.appendChild(j);
        }
        var evs = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        evs.forEach(function (e) { w.addEventListener(e, load, { once: true, passive: true }); });
        function afterLoad() {
          setTimeout(function () {
            if ('requestIdleCallback' in w) w.requestIdleCallback(load, { timeout: 2000 });
            else load();
          }, 3500);
        }
        if (d.readyState === 'complete') afterLoad();
        else w.addEventListener('load', afterLoad, { once: true });
        // client-side navigations (view transitions) → one virtual page view per page; GTM needs a trigger on this event
        var first = true;
        d.addEventListener('astro:page-load', function () {
          if (first) { first = false; return; }
          w[l].push({ event: 'virtual_page_view', page_path: location.pathname, page_location: location.href, page_title: d.title });
        });
      })(window, document, 'dataLayer', GTM_ID);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-porcelain text-ink">
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>
    {/* the cookie banner (7 Nov 2026) first in the reading order, so keyboard and screen-reader users meet it first;
        shown at the bottom of the screen, over the page (position: fixed — nothing moves) */}
    <CookieConsent locale={locale} />
    <Header locale={locale} path={path} switchPath={switchPath} booking={booking} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer locale={locale} switchPath={switchPath} booking={booking} />}
    {/* Sticky WhatsApp (decision 22 Oct 2026): branch/room pages → that branch; /partners/* → sales; elsewhere → chooser. */}
    <WhatsAppButton locale={locale} target={whatsapp ?? (path.startsWith('/partners') ? 'sales' : undefined)} />
    {bookingDrawer && !legacy && <BookingDrawer locale={locale} />}
    {/* the offer pop-up (2 Nov 2026): never on /booking/ and its success page (bookingDrawer is off there) */}
    {offerPopup && bookingDrawer && <OfferPopupDialog locale={locale} path={path} />}
    <script>
      // the visit's first-touch source (3 Nov 2026, part G): kept in sessionStorage until a booking is sent
      import { captureVisit } from '@lib/visit';
      captureVisit();
      import '@lib/reveal';
      import '@lib/counters';
      import '@lib/carousel';
      import '@lib/roombar';
      import '@lib/glow';
      import '@lib/story';
      import '@lib/drawer';
      import '@lib/photo';
      import '@lib/consent';
      import '@lib/slider';
      import '@lib/marquee';
    </script>
  </body>
</html>
