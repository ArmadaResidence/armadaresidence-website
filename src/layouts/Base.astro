---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import fontAr400 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import fontAr600 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-600-normal.woff2?url';
import fontAr700 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-700-normal.woff2?url';
import fontEn from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { GTM_ID, absoluteUrl, dir, localePath, seo, siteName, type BookingContext, type Locale } from '@lib/content';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BookingDrawer from '@components/BookingDrawer.astro';

interface Props {
  locale: Locale;
  /** Locale-independent path, e.g. "/airport-road/" */
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: unknown[];
  /** Branch slug for the sticky WhatsApp button; omit for the two-branch chooser. */
  whatsapp?: string;
  ogImage?: string;
  /** Open Graph type: "article" on blog posts, "website" elsewhere. */
  ogType?: 'website' | 'article';
  /** Where the language switch goes when this page has no twin (404). Defaults to `path`. */
  switchPath?: string;
  /** Favicon set; the café menu page swaps in the café favicon (brand/cafe identity). */
  icons?: { svg: string; png32: string; apple: string };
  /** /menu/ renders the café's own footer inside .legacy-menu instead of the hotel footer. */
  hideFooter?: boolean;
  /** Booking drawer (item 11): on every site page except /booking/ itself and the legacy sections. */
  bookingDrawer?: boolean;
  /** Branch / room this page books for (branch and room pages): the header, menu and footer booking links prefill
      it (Ahmed, 24 Oct 2026); omitted everywhere else, so those links stay empty. */
  booking?: BookingContext;
}

const {
  locale,
  path,
  title,
  description,
  noindex = false,
  jsonld = [],
  whatsapp,
  ogImage = seo.default_og_image,
  ogType = 'website',
  switchPath = Astro.props.path,
  icons = { svg: '/favicon.svg', png32: '/icons/favicon-32.png', apple: '/icons/apple-touch-icon.png' },
  hideFooter = false,
  bookingDrawer = true,
  booking,
} = Astro.props;

const canonical = absoluteUrl(localePath(locale, path));
const arUrl = absoluteUrl(localePath('ar', path));
const enUrl = absoluteUrl(localePath('en', path));
const ogImageUrl = absoluteUrl(ogImage);
const ogLocale = locale === 'ar' ? 'ar_SA' : 'en_US';
const ogLocaleAlt = locale === 'ar' ? 'en_US' : 'ar_SA';
// "</" inside JSON must not terminate the script tag.
const ld = jsonld.map((j) => JSON.stringify(j).replace(/</g, '\\u003c'));
// View transitions (item 1, 11 Oct 2026): the site's own pages navigate through Astro's ClientRouter (cross-fade,
// shared room media, header kept still). The legacy sections keep full page loads so their markup and scripts are
// untouched: a page without the router falls back to a normal navigation in both directions.
const legacy = path === '/discover-taif/' || path.startsWith('/partners/');
// Fonts the first paint needs (performance pass, 11 Oct 2026): body, semibold and heading weights of the page language
// are preloaded so they arrive together (one re-layout, no CSS → @font-face discovery). Same hashed files the CSS uses.
const preloadFonts = locale === 'ar' ? [fontAr400, fontAr600, fontAr700] : [fontEn];
---

<!doctype html>
<html lang={locale} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F3EFE7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0F1F2B" />
    <script is:inline>
      // theme before first paint: stored choice (armada-theme) → else prefers-color-scheme (and follow its changes).
      // `js` on <html> gates the scroll-reveal styles (no JS → everything visible). Both are re-applied after a
      // view-transition swap, which replaces the <html> attributes with the new page's.
      (function () {
        var m = matchMedia('(prefers-color-scheme: dark)');
        function apply() {
          var s = null;
          try { s = localStorage.getItem('armada-theme'); } catch (e) {}
          var t = s === 'dark' || s === 'light' ? s : m.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
          document.documentElement.classList.add('js');
        }
        apply();
        m.addEventListener('change', function () { apply(); });
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    {preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={arUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName(locale)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content={seo.twitter_card} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href={icons.svg} type="image/svg+xml" />
    <link rel="icon" href={icons.png32} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={icons.apple} sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {!legacy && <ClientRouter fallback="animate" />}
    <slot name="head" />
    {ld.map((json) => <script type="application/ld+json" set:html={json} />)}
    <script is:inline define:vars={{ GTM_ID }}>
      // GTM (decision 10 Oct 2026, tightened 11 Oct): the dataLayer exists from the first byte and queues every push
      // (gtm.start/gtm.js, page events, booking_request…); the container script itself is injected on the first
      // interaction or 3.5 s after window.load, whichever comes first, so the ~1 MB of tags it pulls (GA4, Ads,
      // Meta, TikTok) never competes with the page's own assets or blocks the main thread while the page settles.
      // GTM replays the queue in order when it loads, so page_view and every earlier event are still recorded.
      (function (w, d, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          var j = d.createElement('script');
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + (l != 'dataLayer' ? '&l=' + l : '');
          d.head.appendChild(j);
        }
        var evs = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        evs.forEach(function (e) { w.addEventListener(e, load, { once: true, passive: true }); });
        function afterLoad() {
          setTimeout(function () {
            if ('requestIdleCallback' in w) w.requestIdleCallback(load, { timeout: 2000 });
            else load();
          }, 3500);
        }
        if (d.readyState === 'complete') afterLoad();
        else w.addEventListener('load', afterLoad, { once: true });
        // client-side navigations (view transitions) → one virtual page view per page; GTM needs a trigger on this event
        var first = true;
        d.addEventListener('astro:page-load', function () {
          if (first) { first = false; return; }
          w[l].push({ event: 'virtual_page_view', page_path: location.pathname, page_location: location.href, page_title: d.title });
        });
      })(window, document, 'dataLayer', GTM_ID);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-porcelain text-ink">
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>
    <Header locale={locale} path={path} switchPath={switchPath} booking={booking} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer locale={locale} switchPath={switchPath} booking={booking} />}
    {/* Sticky WhatsApp (decision 22 Oct 2026): branch/room pages → that branch; /partners/* → sales; elsewhere → chooser. */}
    <WhatsAppButton locale={locale} target={whatsapp ?? (path.startsWith('/partners') ? 'sales' : undefined)} />
    {bookingDrawer && !legacy && <BookingDrawer locale={locale} />}
    <script>
      import '@lib/reveal';
      import '@lib/counters';
      import '@lib/carousel';
      import '@lib/roombar';
      import '@lib/glow';
      import '@lib/story';
      import '@lib/drawer';
      import '@lib/photo';
    </script>
  </body>
</html>
