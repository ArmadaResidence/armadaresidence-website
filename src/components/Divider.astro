---
/**
 * Decorative bronze divider between big sections (item 12, 11 Oct 2026). brand/ holds no dedicated divider
 * artwork, so the divider is a thin bronze rule with the brand symbol at its centre: the start-side rule is
 * drawn from the start edge (scaleX, slow token), the symbol fades in, then the end-side rule is drawn — once,
 * when 15 % of it is on screen (src/lib/reveal.ts, class reveal-draw). Purely decorative (aria-hidden).
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['divider reveal-draw', className]} aria-hidden="true">
  <span class="divider-line"></span>
  <svg class="divider-mark" viewBox="0 0 1841.6 1985.194" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <g fill="currentColor">
      <path d="M 0 1985.194 L 0 766.244 A 240 240 0 0 1 96.456 573.903 L 425 328.71 L 425 1985.194 Z"></path>
      <path d="M 475.5 1985.194 L 475.5 291.022 L 645.5 164.151 L 645.5 1985.194 Z"></path>
      <path d="M 696 1985.194 L 696 126.463 L 821.097 33.103 A 166.7 166.7 0 0 1 1020.503 33.103 L 1145.6 126.463 L 1145.6 1985.194 L 1010.2 1985.194 L 1010.2 1538.194 A 89.4 74.7 0 0 0 831.4 1538.194 L 831.4 1985.194 Z"></path>
      <path d="M 1196.1 1985.194 L 1196.1 164.151 L 1366.1 291.022 L 1366.1 1985.194 Z"></path>
      <path d="M 1841.6 1985.194 L 1841.6 766.244 A 240 240 0 0 0 1745.144 573.903 L 1416.6 328.71 L 1416.6 1985.194 Z"></path>
    </g>
  </svg>
  <span class="divider-line"></span>
</div>
