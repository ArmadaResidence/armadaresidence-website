---
/**
 * Booking-request form (CLAUDE.md §8; rebuilt 23 Oct 2026 — decisions A2/A3) — one component for the /booking/
 * page and the booking drawer. Every rule lives in supabase/functions/booking-request/rules.ts and is shared with
 * the Edge Function, so the browser and the server validate the same way. Strings come from ui.json; branches,
 * rooms and capacities from content/; countries from libphonenumber-js with self-hosted flags (public/flags/,
 * scripts/flags.mjs — never emoji, never a CDN). `prefix` keeps ids unique when two forms share a page.
 */
import { readFileSync } from 'node:fs';
import { getCountries, getCountryCallingCode } from 'libphonenumber-js/min';
import { branchContact, branchShort, branches, extraBedFeeLine, L, localePath, rooms, ui, type Locale } from '@lib/content';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  prefix?: string;
  class?: string;
}
const { locale, prefix = '', class: className = '' } = Astro.props;
const t = ui(locale);
const f = t.form;
const id = (name: string) => `${prefix}${name}`;

const endpoint = import.meta.env.PUBLIC_BOOKING_ENDPOINT ?? '';
const anonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const bookable = rooms.filter((r) => r.availability !== 'sold_out');

// Countries with a flag on the site, in the page language; Saudi Arabia first (default), then the GCC, then A–Z.
let flagged: string[] = [];
try {
  flagged = JSON.parse(readFileSync('public/flags/index.json', 'utf8'));
} catch {
  flagged = getCountries();
}
const names = new Intl.DisplayNames([locale], { type: 'region' });
const PINNED = ['SA', 'AE', 'KW', 'QA', 'BH', 'OM'];
const countries = getCountries()
  .filter((cc) => flagged.includes(cc))
  .map((cc) => [cc, getCountryCallingCode(cc), names.of(cc) ?? cc] as [string, string, string])
  .sort((a, b) => {
    const pa = PINNED.indexOf(a[0]);
    const pb = PINNED.indexOf(b[0]);
    if (pa !== -1 || pb !== -1) return (pa === -1 ? 99 : pa) - (pb === -1 ? 99 : pb);
    return a[2].localeCompare(b[2], locale);
  });

/** Everything the client script needs, all from content/. */
const clientData = {
  locale,
  endpoint,
  anonKey,
  successPath: localePath(locale, '/booking/success/'),
  partnersPath: localePath(locale, '/partners/enquiry/'),
  branches: branches.map((b) => ({ slug: b.slug, name: L(locale, b, 'name'), short: branchShort(locale, b.slug), whatsapp: branchContact(b.slug).whatsapp })),
  rooms: bookable.map((r) => ({ slug: r.slug, branch: r.branch, name: L(locale, r, 'name'), capacity: r.capacity, extra_beds_max: r.extra_beds_max ?? 0, availability: r.availability })),
  countries,
  strings: {
    anyRoom: f.any_room,
    sending: f.sending,
    submit: f.submit,
    errors: f.errors,
    whatsappMessage: f.whatsapp_message,
    breakfastWith: f.breakfast_with,
    breakfastWithout: f.breakfast_without,
    stayLength: f.stay_length,
    plural: f.plural,
    capacityBranch: f.capacity_branch,
    capacityBranchLink: f.capacity_branch_link,
    bedsAuto: f.extra_beds_auto,
    bedsPlural: f.extra_beds_plural,
    bedsPluralAcc: f.extra_beds_plural_acc,
    capacityBeds: f.capacity_beds,
    capacityNoBeds: f.capacity_no_beds,
    bedsLabel: f.extra_beds,
    countryNone: f.country_none,
    adults: f.adults,
    children: f.children,
  },
};
const inputClass = 'field-input w-full border border-line rounded bg-white';
const latinInput = `${inputClass} latin text-left`;
const err = (name: string) => id(`${name}-error`);
const stepper = (name: 'adults' | 'children' | 'extra_beds', value: number, min: number) => ({ name, value, min, label: f[name] });
---

<form id={id('booking-form')} class:list={['booking-form space-y-6', className]} novalidate data-booking-form>
  <div class="grid gap-5 sm:grid-cols-2">
    {/* 1. Branch first */}
    <div class="sm:col-span-2 field field-select">
      <select id={id('branch')} name="branch" required autocomplete="off" class={inputClass} aria-describedby={err('branch')}>
        <option value="">{f.choose_branch}</option>
        {branches.map((b) => <option value={b.slug}>{L(locale, b, 'name')}</option>)}
      </select>
      <label for={id('branch')} class="field-label">{f.branch}</label>
      <p id={err('branch')} class="field-error hidden" data-error-for="branch"></p>
    </div>

    {/* 2. Room type, filtered by the branch */}
    <div class="sm:col-span-2 field field-select">
      <select id={id('room')} name="room" autocomplete="off" class={inputClass} aria-describedby={err('room')}>
        <option value="">{f.any_room}</option>
        {bookable.map((r) => <option value={r.slug} data-branch={r.branch} data-capacity={r.capacity}>{L(locale, r, 'name')}</option>)}
      </select>
      <label for={id('room')} class="field-label">{f.room_type}</label>
      <p id={err('room')} class="field-error hidden" data-error-for="room"></p>
    </div>

    {/* 3. Dates: ISO text field (Western digits whatever the locale) + the native picker; no past dates (Asia/Riyadh) */}
    {
      (['check_in', 'check_out'] as const).map((name) => (
        <div class="field" data-date-field>
          <input
            id={id(name)}
            name={name}
            type="text"
            inputmode="numeric"
            autocomplete="off"
            placeholder={f.date_format}
            pattern="\d{4}-\d{2}-\d{2}"
            maxlength="10"
            required
            lang="en"
            dir="ltr"
            class:list={[latinInput, 'pe-11']}
            aria-describedby={err(name)}
            data-date-text
          />
          <label for={id(name)} class="field-label">{f[name]}</label>
          <input type="date" tabindex="-1" aria-hidden="true" lang="en" class="absolute bottom-0 right-10 w-px h-px opacity-0" data-date-picker />
          <button type="button" class="field-icon absolute right-0 top-0 h-14 w-10 grid place-items-center text-bronze hover:text-bronze-text" aria-label={f.open_calendar} data-date-open>
            <Icon name="calendar" size={20} />
          </button>
          <p id={err(name)} class="field-error hidden" data-error-for={name} />
        </div>
      ))
    }
    <p class="sm:col-span-2 -mt-2 text-sm text-ink-muted hidden" data-nights aria-live="polite"></p>

    {/* 4. Guests: steppers, digits only. Adults ≤ room capacity + extra beds (rooms.json); children are not limited
        beyond a technical bound. Extra beds: 0–2 per room type, hidden when the room (or, with «أي غرفة متاحة», the
        whole branch) takes none; the fee sentence comes from pricing.json (the one allowed price line). */}
    <fieldset class="sm:col-span-2" aria-describedby={`${err('adults')} ${id('capacity-note')}`}>
      <legend class="text-sm font-semibold text-midnight mb-2">{f.guests}</legend>
      <div class="grid gap-4 grid-cols-2">
        {
          [stepper('adults', 2, 1), stepper('children', 0, 0), stepper('extra_beds', 0, 0)].map((s) => (
            <div class:list={['stepper', s.name === 'extra_beds' ? 'col-span-2 sm:col-span-1 hidden' : '']} data-stepper={s.name}>
              <label for={id(s.name)} class="block text-xs text-ink-muted mb-1">{s.label}</label>
              <div class="flex items-stretch border border-line rounded bg-white h-12" dir="ltr">
                <button type="button" class="stepper-btn" data-step="-1" aria-controls={id(s.name)} aria-label={f.guests_dec.replace('{field}', s.label)}>
                  <Icon name="minus" size={18} />
                </button>
                <input
                  id={id(s.name)}
                  name={s.name}
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  autocomplete="off"
                  maxlength="2"
                  value={String(s.value)}
                  data-min={s.min}
                  data-max={s.name === 'extra_beds' ? '0' : '20'}
                  lang="en"
                  class="latin w-full min-w-0 text-center bg-transparent text-midnight font-semibold focus:outline-none"
                  aria-describedby={s.name === 'adults' ? err('adults') : s.name === 'extra_beds' ? `${id('extra-beds-note')} ${err('extra_beds')}` : undefined}
                />
                <button type="button" class="stepper-btn" data-step="1" aria-controls={id(s.name)} aria-label={f.guests_inc.replace('{field}', s.label)}>
                  <Icon name="plus" size={18} />
                </button>
              </div>
            </div>
          ))
        }
      </div>
      <p id={err('adults')} class="field-error hidden" data-error-for="adults"></p>
      <p id={err('extra_beds')} class="field-error hidden" data-error-for="extra_beds"></p>
      <p class="hidden mt-2 text-sm text-midnight bg-porcelain rounded px-3 py-2" data-beds-auto aria-live="polite"></p>
      <p id={id('extra-beds-note')} class="hidden mt-2 text-xs text-ink-muted" data-beds-fee>{extraBedFeeLine(locale)}</p>
      <p id={id('capacity-note')} class="hidden mt-2 text-sm text-ink-muted" data-capacity-note></p>
    </fieldset>

    {/* 5. Breakfast: required choice, no default (decision A2) */}
    <fieldset class="sm:col-span-2" data-breakfast aria-describedby={err('breakfast')}>
      <legend class="text-sm font-semibold text-midnight mb-2">{f.breakfast}</legend>
      <div class="grid grid-cols-2 gap-3">
        {
          (['with', 'without'] as const).map((v) => (
            <label class="choice">
              <input type="radio" name="breakfast" value={v} class="sr-only peer" required />
              <span class="choice-box">{v === 'with' ? f.breakfast_with : f.breakfast_without}</span>
            </label>
          ))
        }
      </div>
      <p id={err('breakfast')} class="field-error hidden" data-error-for="breakfast"></p>
    </fieldset>

    {/* 6. Name */}
    <div class="sm:col-span-2 field">
      <input id={id('name')} name="name" type="text" autocomplete="name" autocapitalize="words" spellcheck="false" required maxlength="120" placeholder=" " class={inputClass} aria-describedby={err('name')} />
      <label for={id('name')} class="field-label">{f.full_name}</label>
      <p id={err('name')} class="field-error hidden" data-error-for="name"></p>
    </div>

    {/* 7. Phone (WhatsApp), required: country selector with self-hosted flags + national number, stored as E.164 */}
    <div class="sm:col-span-2" data-phone-group>
      <label for={id('phone')} class="block text-sm font-semibold text-midnight mb-2">{f.phone}</label>
      <div class="relative flex gap-2" dir="ltr">
        <input type="hidden" name="country" value="SA" data-country-value />
        <button
          type="button"
          class="country-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls={id('country-list')}
          aria-label={`${f.country_code}: ${countries[0][2]} +${countries[0][1]}`}
          data-country-btn
        >
          <img src="/flags/sa.png" alt="" aria-hidden="true" width="24" height="18" class="rounded-sm" data-country-flag data-flag-src="/flags/sa.png" />
          <span class="latin font-semibold" data-country-code>+966</span>
          <Icon name="chevron" size={14} class="text-ink-muted" />
        </button>
        <input
          id={id('phone')}
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel-national"
          required
          maxlength="20"
          lang="en"
          class="flex-1 min-w-0 h-14 px-3 border border-line rounded bg-white latin text-left text-midnight"
          aria-describedby={`${id('phone-hint')} ${err('phone')}`}
          data-phone-input
        />
        <div class="country-pop hidden" data-country-pop>
          <input
            type="search"
            class="w-full h-11 px-3 border border-line rounded bg-white text-sm"
            placeholder={f.country_search}
            aria-label={f.country_search}
            aria-controls={id('country-list')}
            autocomplete="off"
            dir={locale === 'ar' ? 'rtl' : 'ltr'}
            data-country-search
          />
          <ul id={id('country-list')} role="listbox" aria-label={f.country_code} class="country-list" data-country-list tabindex="-1"></ul>
        </div>
      </div>
      <p id={id('phone-hint')} class="text-xs text-ink-muted mt-1">{f.phone_hint}</p>
      <p id={err('phone')} class="field-error hidden" data-error-for="phone"></p>
    </div>

    {/* 8. Email, optional; validated when present */}
    <div class="sm:col-span-2 field">
      <input id={id('email')} name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" lang="en" dir="ltr" placeholder=" " class={latinInput} aria-describedby={`${id('email-hint')} ${err('email')}`} />
      <label for={id('email')} class="field-label">{f.email}</label>
      <p id={id('email-hint')} class="text-xs text-ink-muted mt-1">{f.email_hint}</p>
      <p id={err('email')} class="field-error hidden" data-error-for="email"></p>
    </div>

    <div class="sm:col-span-2 field field-textarea">
      <textarea id={id('notes')} name="notes" rows="3" maxlength="1000" autocomplete="off" placeholder=" " class={inputClass} aria-describedby={id('notes-hint')}></textarea>
      <label for={id('notes')} class="field-label">{f.notes}</label>
      <p id={id('notes-hint')} class="text-xs text-ink-muted mt-1">{f.notes_hint}</p>
    </div>
  </div>

  {/* Honeypot: invisible to people and assistive tech; a bot that fills it gets a fake success and nothing is stored. */}
  <div class="absolute -start-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
    <label for={id('website')}>Website</label>
    <input id={id('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="text-xs text-ink-muted">
    {f.consent}
    <a href={localePath(locale, '/policies/')} class="font-semibold text-bronze hover:text-bronze-text ms-1">{f.consent_link}</a>.
  </p>

  <p class="hidden text-sm font-semibold text-midnight bg-porcelain rounded px-4 py-3" data-summary aria-live="polite"></p>
  <p class="hidden bg-porcelain border border-line text-sm text-red-800 rounded px-4 py-3" data-form-error role="alert"></p>

  <div class="flex flex-wrap items-center gap-3">
    <button type="submit" class="inline-flex items-center gap-2 bg-bronze-deep text-white font-semibold px-6 py-3 rounded hover:bg-bronze-text transition-colors disabled:opacity-70" data-submit>
      <span class="spinner hidden" aria-hidden="true" data-spinner></span>
      <span data-submit-label>{f.submit}</span>
      <Icon name="arrow" size={18} class="icon-arrow rtl:rotate-180" />
    </button>
    {/* WhatsApp hand-off (23 Oct 2026): a real button, always offered; it validates like the submit, then opens wa.me
        from inside the click handler (popup blockers allow it) and never navigates this page. */}
    <button type="button" class="inline-flex items-center gap-2 border border-midnight text-midnight font-semibold px-5 py-3 rounded hover:bg-midnight hover:text-white transition-colors" data-wa-send>
      <Icon name="whatsapp" size={18} />
      <span>{f.whatsapp_fallback}</span>
    </button>
  </div>

  <script type="application/json" data-booking-data set:html={JSON.stringify(clientData).replace(/</g, '\\u003c')} />
</form>

<script>
  import { bindOnce, onPageLoad } from '@lib/client';
  import {
    addDays,
    bedsNeeded,
    branchMaxAdults,
    branchMaxExtraBeds,
    E164,
    nightsBetween,
    plural,
    riyadhToday,
    validateBooking,
    type BookingInput,
    type FieldError,
  } from '../../supabase/functions/booking-request/rules.ts';

  type Plurals = Record<'nights' | 'adults' | 'children', Record<'one' | 'two' | 'few' | 'many', string>>;
  type Data = {
    locale: string;
    endpoint: string;
    anonKey: string;
    successPath: string;
    partnersPath: string;
    branches: { slug: string; name: string; short: string; whatsapp: string }[];
    rooms: { slug: string; branch: string; name: string; capacity: number; extra_beds_max: number; availability: string }[];
    countries: [string, string, string][];
    strings: {
      anyRoom: string;
      sending: string;
      submit: string;
      errors: Record<string, string>;
      whatsappMessage: string;
      breakfastWith: string;
      breakfastWithout: string;
      stayLength: string;
      plural: Plurals;
      capacityBranch: string;
      capacityBranchLink: string;
      bedsAuto: string;
      bedsPlural: Record<'one' | 'two' | 'few' | 'many', string>;
      bedsPluralAcc: Record<'one' | 'two' | 'few' | 'many', string>;
      capacityBeds: string;
      capacityNoBeds: string;
      bedsLabel: string;
      countryNone: string;
      adults: string;
      children: string;
    };
  };

  type PhoneLib = typeof import('libphonenumber-js/min');
  let phoneLib: PhoneLib | null = null;
  let phoneLibLoading: Promise<PhoneLib | null> | null = null;
  /** libphonenumber-js (min metadata) is loaded on first interaction, not with the page. */
  function loadPhoneLib(): Promise<PhoneLib | null> {
    if (phoneLib) return Promise.resolve(phoneLib);
    phoneLibLoading ??= import('libphonenumber-js/min')
      .then((m) => (phoneLib = m))
      .catch(() => null);
    return phoneLibLoading;
  }

  /** ٠١٢… / ۰۱۲… → 0-9 (phones, dates and counts are typed with Arabic keyboards too). */
  const latinDigits = (s: string) => s.replace(/[٠-٩]/g, (c) => String(c.charCodeAt(0) - 0x0660)).replace(/[۰-۹]/g, (c) => String(c.charCodeAt(0) - 0x06f0));

  /** E.164 for a number typed in the national form (or with +/00), valid for the chosen country. */
  function phoneToE164(raw: string, country: string): string | null {
    const v = latinDigits(raw).replace(/[\s\-().]/g, '').replace(/^00/, '+');
    if (!v) return null;
    if (phoneLib) {
      const n = v.startsWith('+') ? phoneLib.parsePhoneNumberFromString(v) : phoneLib.parsePhoneNumberFromString(v, country as never);
      return n && n.isValid() ? n.number : null;
    }
    // library not loaded (offline): the server still validates per country
    return E164.test(v) ? v : null;
  }

  function initForm(form: HTMLFormElement) {
    const data = JSON.parse(form.querySelector('[data-booking-data]')?.textContent || '{}') as Data;
    const S = data.strings;
    const el = <T extends Element = HTMLInputElement>(name: string) => form.elements.namedItem(name) as unknown as T;
    const branchSel = el<HTMLSelectElement>('branch');
    const roomSel = el<HTMLSelectElement>('room');
    const checkIn = el('check_in');
    const checkOut = el('check_out');
    const adultsIn = el('adults');
    const childrenIn = el('children');
    const bedsIn = el('extra_beds');
    const bedsWrap = form.querySelector<HTMLElement>('[data-stepper="extra_beds"]')!;
    const bedsAutoNote = form.querySelector<HTMLElement>('[data-beds-auto]')!;
    const bedsFee = form.querySelector<HTMLElement>('[data-beds-fee]')!;
    const nameIn = el('name');
    const phoneIn = form.querySelector<HTMLInputElement>('[data-phone-input]')!;
    const emailIn = el('email');
    const notesIn = el<HTMLTextAreaElement>('notes');
    const countryVal = form.querySelector<HTMLInputElement>('[data-country-value]')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const spinner = form.querySelector<HTMLElement>('[data-spinner]')!;
    const formError = form.querySelector<HTMLElement>('[data-form-error]')!;
    const waSend = form.querySelector<HTMLButtonElement>('[data-wa-send]')!;
    const summary = form.querySelector<HTMLElement>('[data-summary]')!;
    const nightsLine = form.querySelector<HTMLElement>('[data-nights]')!;
    const capNote = form.querySelector<HTMLElement>('[data-capacity-note]')!;
    const touched = new Set<string>();
    let sending = false;
    /** once the guest sets the extra beds themselves, the auto-fill stops overriding them */
    let bedsTouched = false;

    form.addEventListener('focusin', () => void loadPhoneLib(), { once: true });

    // ── dates: native picker behind an ISO text field; min = today in Asia/Riyadh ───────────────────────────
    const today = riyadhToday();
    const pickers = new Map<HTMLInputElement, HTMLInputElement>();
    form.querySelectorAll<HTMLElement>('[data-date-field]').forEach((wrap) => {
      const text = wrap.querySelector<HTMLInputElement>('[data-date-text]')!;
      const picker = wrap.querySelector<HTMLInputElement>('[data-date-picker]')!;
      const open = wrap.querySelector<HTMLButtonElement>('[data-date-open]')!;
      pickers.set(text, picker);
      const showPicker = () => {
        if (text.value && /^\d{4}-\d{2}-\d{2}$/.test(text.value)) picker.value = text.value;
        try {
          if (typeof (picker as HTMLInputElement & { showPicker?: () => void }).showPicker === 'function') (picker as HTMLInputElement & { showPicker: () => void }).showPicker();
          else {
            picker.focus();
            picker.click();
          }
        } catch {
          /* no picker available: the guest types the date */
        }
      };
      open.addEventListener('click', showPicker);
      text.addEventListener('click', showPicker);
      picker.addEventListener('change', () => {
        if (!picker.value) return;
        text.value = picker.value;
        text.dispatchEvent(new Event('change', { bubbles: true }));
        touched.add(text.name);
        validateField(text.name);
      });
      text.addEventListener('input', () => {
        text.value = latinDigits(text.value).replace(/[^\d-]/g, '').slice(0, 10);
      });
    });
    const setMin = (input: HTMLInputElement, value: string) => {
      const p = pickers.get(input);
      if (p) p.min = value;
    };
    setMin(checkIn, today);
    setMin(checkOut, addDays(today, 1));
    checkIn.addEventListener('change', () => {
      if (/^\d{4}-\d{2}-\d{2}$/.test(checkIn.value)) {
        setMin(checkOut, addDays(checkIn.value, 1));
        if (checkOut.value && checkOut.value <= checkIn.value) checkOut.value = '';
      }
      refresh();
    });
    checkOut.addEventListener('change', refresh);

    // ── room list filtered by branch ─────────────────────────────────────────────────────────────────────
    /**
     * Select the room option for `slug` that belongs to the selected branch. Room slugs repeat across branches
     * (king-room, one-bedroom-suite, two-bedroom-suite), so `roomSel.value = slug` would pick the first match —
     * often the other branch's option, which is disabled and therefore left out of the submitted form data
     * (bug found in the 23 Oct live test: Shafa Road room CTAs were sent as «أي غرفة متاحة»).
     */
    function selectRoom(slug: string): boolean {
      const b = branchSel.value;
      const opt = Array.from(roomSel.options).find((o) => o.value === slug && !o.disabled && (!o.dataset.branch || !b || o.dataset.branch === b));
      if (opt) opt.selected = true;
      else roomSel.selectedIndex = 0;
      return !!opt;
    }
    function filterRooms() {
      const b = branchSel.value;
      for (const opt of Array.from(roomSel.options)) {
        const ob = opt.dataset.branch;
        if (!ob) continue;
        opt.hidden = Boolean(b) && ob !== b;
        opt.disabled = opt.hidden;
      }
      // keep the same room type when the new branch has it, otherwise «أي غرفة متاحة»
      const current = roomSel.selectedOptions[0];
      if (current && current.disabled) selectRoom(current.value);
    }
    branchSel.addEventListener('change', () => {
      filterRooms();
      bedsTouched = false;
      refresh();
    });
    roomSel.addEventListener('change', () => {
      bedsTouched = false;
      refresh();
    });

    // ── steppers: digits only, clamped ───────────────────────────────────────────────────────────────────
    form.querySelectorAll<HTMLElement>('[data-stepper]').forEach((wrap) => {
      const input = wrap.querySelector<HTMLInputElement>('input')!;
      const min = Number(input.dataset.min);
      // max is read on every use: the extra-beds stepper's max follows the selected room / branch
      const clamp = (n: number) => Math.min(Number(input.dataset.max), Math.max(min, Number.isFinite(n) ? n : min));
      const key = wrap.dataset.stepper === 'extra_beds' ? 'extra_beds' : 'adults';
      const changed = () => {
        if (key === 'extra_beds') bedsTouched = true;
        touched.add(key);
        refresh();
        validateField('adults');
        validateField('extra_beds');
      };
      wrap.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) =>
        btn.addEventListener('click', () => {
          input.value = String(clamp(Number(input.value || min) + Number(btn.dataset.step)));
          changed();
        }),
      );
      input.addEventListener('input', () => {
        input.value = latinDigits(input.value).replace(/\D/g, '').slice(0, 2);
        refresh();
      });
      input.addEventListener('blur', () => {
        input.value = String(clamp(Number(input.value === '' ? min : input.value)));
        changed();
      });
    });

    // ── country selector: button + searchable listbox, flags loaded only while the list is open ───────────
    const cBtn = form.querySelector<HTMLButtonElement>('[data-country-btn]')!;
    const cFlag = form.querySelector<HTMLImageElement>('[data-country-flag]')!;
    const cCode = form.querySelector<HTMLElement>('[data-country-code]')!;
    const cPop = form.querySelector<HTMLElement>('[data-country-pop]')!;
    const cSearch = form.querySelector<HTMLInputElement>('[data-country-search]')!;
    const cList = form.querySelector<HTMLUListElement>('[data-country-list]')!;
    const flagBase = (cFlag.dataset.flagSrc || '/flags/sa.png').replace(/sa\.png$/, '');
    const flagSrc = (cc: string) => `${flagBase}${cc.toLowerCase()}.png`;
    const norm = (s: string) => s.toLowerCase().replace(/[ً-ٰٟ]/g, '').replace(/[أإآ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي');
    let visible: [string, string, string][] = [];
    let active = 0;
    const optId = (cc: string) => `${form.id}-cc-${cc}`;

    function renderList() {
      const q = norm(latinDigits(cSearch.value.trim()).replace(/^\+/, ''));
      visible = data.countries.filter(([cc, code, name]) => !q || norm(name).includes(q) || code.startsWith(q) || cc.toLowerCase() === q);
      active = Math.max(0, visible.findIndex(([cc]) => cc === countryVal.value));
      if (active === -1) active = 0;
      cList.replaceChildren();
      if (!visible.length) {
        const li = document.createElement('li');
        li.className = 'country-empty';
        li.textContent = S.countryNone;
        cList.append(li);
        cSearch.removeAttribute('aria-activedescendant');
        return;
      }
      for (const [i, [cc, code, name]] of visible.entries()) {
        const li = document.createElement('li');
        li.id = optId(cc);
        li.setAttribute('role', 'option');
        li.className = 'country-opt';
        li.dataset.cc = cc;
        li.setAttribute('aria-selected', String(cc === countryVal.value));
        if (i === active) li.classList.add('is-active');
        const img = document.createElement('img');
        img.src = flagSrc(cc);
        img.alt = '';
        img.setAttribute('aria-hidden', 'true');
        img.width = 24;
        img.height = 18;
        img.loading = 'lazy';
        img.decoding = 'async';
        const n = document.createElement('span');
        n.className = 'flex-1 truncate';
        n.textContent = name;
        const c = document.createElement('span');
        c.className = 'latin text-ink-muted';
        c.dir = 'ltr';
        c.textContent = `+${code}`;
        li.append(img, n, c);
        cList.append(li);
      }
      setActive(active, false);
    }
    function setActive(i: number, scroll = true) {
      const opts = cList.querySelectorAll<HTMLElement>('.country-opt');
      if (!opts.length) return;
      active = (i + opts.length) % opts.length;
      opts.forEach((o, k) => o.classList.toggle('is-active', k === active));
      const cur = opts[active];
      cSearch.setAttribute('aria-activedescendant', cur.id);
      if (scroll) cur.scrollIntoView({ block: 'nearest' });
    }
    const popOpen = () => cBtn.getAttribute('aria-expanded') === 'true';
    function openPop() {
      cBtn.setAttribute('aria-expanded', 'true');
      cPop.classList.remove('hidden');
      cSearch.value = '';
      renderList();
      cSearch.focus();
    }
    function closePop(refocus: boolean) {
      if (!popOpen()) return;
      cBtn.setAttribute('aria-expanded', 'false');
      cPop.classList.add('hidden');
      if (refocus) cBtn.focus();
    }
    function choose(cc: string) {
      const row = data.countries.find(([c]) => c === cc);
      if (!row) return;
      countryVal.value = cc;
      cFlag.src = flagSrc(cc);
      cCode.textContent = `+${row[1]}`;
      cBtn.setAttribute('aria-label', `${cBtn.getAttribute('aria-label')!.split(':')[0]}: ${row[2]} +${row[1]}`);
      closePop(false);
      phoneIn.focus();
      if (touched.has('phone')) validateField('phone');
      refresh();
    }
    cBtn.addEventListener('click', () => (popOpen() ? closePop(true) : openPop()));
    cSearch.addEventListener('input', renderList);
    cSearch.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); const cc = visible[active]?.[0]; if (cc) choose(cc); }
      else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); closePop(true); }
      else if (e.key === 'Tab') closePop(false);
    });
    cList.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('.country-opt');
      if (li?.dataset.cc) choose(li.dataset.cc);
    });
    // outside tap closes the list (listener lives on the form, so it goes away with the page)
    form.addEventListener('pointerdown', (e) => {
      if (popOpen() && !cPop.contains(e.target as Node) && !cBtn.contains(e.target as Node)) closePop(false);
    });
    form.closest('dialog')?.addEventListener('pointerdown', (e) => {
      if (popOpen() && !form.contains(e.target as Node)) closePop(false);
    });
    phoneIn.addEventListener('input', () => {
      phoneIn.value = latinDigits(phoneIn.value).replace(/[^\d+\s\-()]/g, '');
    });

    // ── prefill (?branch=&room= on the page, or the link that opened the drawer) ─────────────────────────
    const prefill = (branch: string | null, room: string | null) => {
      if (branch && data.branches.some((b) => b.slug === branch)) branchSel.value = branch;
      filterRooms();
      if (room) selectRoom(room);
      refresh();
    };
    // (applied at the end of initForm, once every helper below exists)

    // ── validation (rules.ts, shared with the Edge Function) ─────────────────────────────────────────────
    const ctx = () => ({
      branches: data.branches.map((b) => b.slug),
      rooms: data.rooms,
      today: riyadhToday(),
      phone: (raw: string, country: string) => phoneToE164(raw, country),
    });
    const collect = (): BookingInput => {
      const fd = new FormData(form);
      const v = (k: string) => String(fd.get(k) ?? '').trim();
      return {
        branch: v('branch'),
        room: v('room'),
        check_in: v('check_in'),
        check_out: v('check_out'),
        adults: v('adults'),
        children: v('children') || '0',
        extra_beds: v('extra_beds') || '0',
        breakfast: v('breakfast'),
        name: v('name'),
        phone: v('phone'),
        country: v('country'),
        email: v('email'),
        notes: v('notes'),
      };
    };
    const FIELD_OF: Record<string, string> = { children: 'adults' };
    const message = (field: string, code: FieldError): string => {
      const e = S.errors;
      if (code === 'extra_beds') return e.extra_beds;
      if (code === 'required' && field === 'breakfast') return e.breakfast;
      const map: Partial<Record<FieldError, string>> = {
        required: e.required, branch: e.required, room: e.required, date_format: e.date_format, past: e.past, dates: e.dates,
        adults: e.adults, children: e.adults, extra_beds: e.extra_beds, breakfast: e.breakfast, name: e.name, phone: e.phone, email: e.email,
      };
      return map[code] ?? e.required;
    };
    function control(field: string): HTMLElement | null {
      if (field === 'breakfast') return form.querySelector<HTMLElement>('input[name="breakfast"]');
      if (field === 'phone') return phoneIn;
      return form.elements.namedItem(field) as HTMLElement | null;
    }
    function showError(field: string, msg: string | null) {
      const box = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      if (box) {
        box.textContent = msg ?? '';
        box.classList.toggle('hidden', !msg);
      }
      if (field === 'breakfast') {
        form.querySelectorAll<HTMLInputElement>('input[name="breakfast"]').forEach((r) => r.setAttribute('aria-invalid', msg ? 'true' : 'false'));
        form.querySelector('[data-breakfast]')?.classList.toggle('is-invalid', !!msg);
      } else if (field === 'adults') {
        [adultsIn, childrenIn].forEach((i) => i.closest('.stepper')?.classList.toggle('is-invalid', !!msg));
        adultsIn.setAttribute('aria-invalid', msg ? 'true' : 'false');
      } else control(field)?.setAttribute('aria-invalid', msg ? 'true' : 'false');
    }
    const FIELDS = ['branch', 'room', 'check_in', 'check_out', 'adults', 'extra_beds', 'breakfast', 'name', 'phone', 'email'];
    function errorsNow() {
      const r = validateBooking(collect(), ctx());
      return r.ok ? {} : (r.errors as Record<string, FieldError>);
    }
    function validateField(field: string) {
      const errs = errorsNow();
      const f = FIELD_OF[field] ?? field;
      const code = errs[f] ?? (f === 'adults' ? errs.children : undefined);
      showError(f, code ? message(f, code) : null);
    }
    function validateAll(): boolean {
      const errs = errorsNow();
      let first: HTMLElement | null = null;
      for (const f of FIELDS) {
        const code = errs[f] ?? (f === 'adults' ? errs.children : undefined);
        showError(f, code ? message(f, code) : null);
        if (code && !first) first = f === 'adults' ? adultsIn : f === 'extra_beds' ? bedsIn : control(f);
        touched.add(f);
      }
      if (first) first.focus();
      return !first;
    }
    for (const f of ['branch', 'room', 'check_in', 'check_out', 'name', 'email']) {
      const c = control(f);
      c?.addEventListener('blur', () => {
        if (f === 'name' && (c as HTMLInputElement).value.trim() === '' && !touched.has(f)) return;
        touched.add(f);
        validateField(f);
      });
      c?.addEventListener('input', () => touched.has(f) && validateField(f));
      c?.addEventListener('change', () => touched.has(f) && validateField(f));
    }
    phoneIn.addEventListener('blur', async () => {
      if (!phoneIn.value.trim() && !touched.has('phone')) return;
      touched.add('phone');
      await loadPhoneLib();
      validateField('phone');
    });
    phoneIn.addEventListener('input', () => touched.has('phone') && validateField('phone'));
    form.querySelectorAll<HTMLInputElement>('input[name="breakfast"]').forEach((r) =>
      r.addEventListener('change', () => {
        touched.add('breakfast');
        validateField('breakfast');
        refresh();
      }),
    );

    // ── live helpers: nights line, capacity note, summary line ───────────────────────────────────────────
    const P = S.plural;
    function nightsNow(): number {
      const a = checkIn.value;
      const b = checkOut.value;
      if (!/^\d{4}-\d{2}-\d{2}$/.test(a) || !/^\d{4}-\d{2}-\d{2}$/.test(b) || b <= a) return 0;
      return nightsBetween(a, b);
    }
    function refresh() {
      const n = nightsNow();
      nightsLine.textContent = n ? S.stayLength.replace('{nights}', plural(P.nights, n)) : '';
      nightsLine.classList.toggle('hidden', !n);

      const adults = Number(adultsIn.value || 0);
      const kids = Number(childrenIn.value || 0);
      const room = data.rooms.find((r) => r.slug === roomSel.value && r.branch === branchSel.value);
      // extra beds: allowed up to the room's extra_beds_max, or the branch's highest with «أي غرفة متاحة»
      const bedsMax = room ? room.extra_beds_max : branchSel.value ? branchMaxExtraBeds(data.rooms, branchSel.value) : 0;
      bedsIn.dataset.max = String(bedsMax);
      bedsWrap.classList.toggle('hidden', bedsMax === 0);
      bedsFee.classList.toggle('hidden', bedsMax === 0);
      if (bedsMax === 0) bedsIn.value = '0';
      else if (Number(bedsIn.value || 0) > bedsMax) bedsIn.value = String(bedsMax);
      // more adults than the room takes → set the extra beds to the difference when it fits, and say so
      bedsAutoNote.classList.add('hidden');
      if (room) {
        const need = bedsNeeded(room, adults);
        if (need > 0 && need <= bedsMax && Number(bedsIn.value || 0) < need && !bedsTouched) {
          bedsIn.value = String(need);
          bedsAutoNote.textContent = S.bedsAuto.replace('{beds}', plural(S.bedsPluralAcc, need)).replace('{capacity}', String(room.capacity));
          bedsAutoNote.classList.remove('hidden');
        } else if (need > 0 && need <= bedsMax && Number(bedsIn.value || 0) === need && !bedsTouched) {
          bedsAutoNote.textContent = S.bedsAuto.replace('{beds}', plural(S.bedsPluralAcc, need)).replace('{capacity}', String(room.capacity));
          bedsAutoNote.classList.remove('hidden');
        }
      }
      const beds = Number(bedsIn.value || 0);
      capNote.replaceChildren();
      capNote.classList.add('hidden');
      // non-blocking notes (rule change 23 Oct 2026): party size never stops the request; reception coordinates
      if (room && adults > room.capacity + beds && bedsAutoNote.classList.contains('hidden')) {
        capNote.textContent =
          room.extra_beds_max === 0
            ? S.capacityNoBeds.replace('{capacity}', String(room.capacity))
            : S.capacityBeds.replace('{adults}', String(adults)).replace('{capacity}', String(room.capacity));
        capNote.classList.remove('hidden');
      }
      if (branchSel.value && !room) {
        const max = branchMaxAdults(data.rooms, branchSel.value);
        if (max && adults > max) {
          capNote.append(S.capacityBranch.replace('{max}', String(max)) + ' ');
          const a = document.createElement('a');
          a.href = data.partnersPath;
          a.className = 'font-semibold text-bronze hover:text-bronze-text underline';
          a.textContent = S.capacityBranchLink;
          capNote.append(a);
          capNote.classList.remove('hidden');
        }
      }
      if (touched.has('adults')) validateField('adults');
      if (touched.has('extra_beds')) validateField('extra_beds');

      const b = data.branches.find((x) => x.slug === branchSel.value);
      const breakfast = form.querySelector<HTMLInputElement>('input[name="breakfast"]:checked')?.value;
      const parts: string[] = [];
      if (b) parts.push(b.short);
      if (n) parts.push(plural(P.nights, n));
      if (adults) parts.push(plural(P.adults, adults));
      if (kids) parts.push(plural(P.children, kids));
      if (beds) parts.push(plural(S.bedsPlural, beds));
      if (breakfast) parts.push(breakfast === 'with' ? S.breakfastWith : S.breakfastWithout);
      summary.textContent = parts.join(' · ');
      summary.classList.toggle('hidden', !b);
    }

    // ── WhatsApp hand-off with every field ───────────────────────────────────────────────────────────────
    /** wa.me link to the branch's number with every filled field, one line per field (form labels, page language);
        a line whose field is still empty (dates, breakfast, name, phone, email, notes) is left out. */
    function whatsappUrl(p: BookingInput): string {
      const b = data.branches.find((x) => x.slug === p.branch)!;
      const r = data.rooms.find((x) => x.slug === p.room && x.branch === p.branch);
      const n = nightsNow();
      const phone = p.phone ? (phoneToE164(p.phone, p.country || 'SA') ?? p.phone) : '';
      const vals: Record<string, string> = {
        branch: b.name,
        room: r ? r.name : S.anyRoom,
        check_in: p.check_in,
        check_out: p.check_out,
        nights: n ? plural(P.nights, n) : '',
        adults: String(p.adults || ''),
        children: String(p.children || '0'),
        extra_beds: String(p.extra_beds || '0'),
        breakfast: p.breakfast === 'with' ? S.breakfastWith : p.breakfast === 'without' ? S.breakfastWithout : '',
        name: p.name,
        phone,
        email: p.email,
        notes: p.notes,
      };
      const msg = S.whatsappMessage
        .split('\n')
        .filter((line) => [...line.matchAll(/\{(\w+)\}/g)].every((m) => vals[m[1]]))
        .map((line) => line.replace(/\{(\w+)\}/g, (_, k: string) => vals[k] ?? ''))
        .join('\n');
      return `https://wa.me/${b.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(msg)}`;
    }
    /** Hand-off validation: the branch is required; every other field is checked only once the guest filled it. */
    function validateFilled(): boolean {
      const errs = errorsNow();
      const filled = (f: string) => {
        if (f === 'branch' || f === 'adults' || f === 'extra_beds' || f === 'room') return true;
        if (f === 'breakfast') return !!form.querySelector('input[name="breakfast"]:checked');
        if (f === 'phone') return !!phoneIn.value.trim();
        return !!(control(f) as HTMLInputElement | null)?.value.trim();
      };
      let first: HTMLElement | null = null;
      for (const f of FIELDS) {
        const code = errs[f] ?? (f === 'adults' ? errs.children : undefined);
        if (!filled(f)) {
          if (!touched.has(f)) showError(f, null);
          continue;
        }
        showError(f, code ? message(f, code) : null);
        if (code && !first) first = f === 'adults' ? adultsIn : f === 'extra_beds' ? bedsIn : control(f);
      }
      if (first) first.focus();
      return !first;
    }
    // Synchronous from click to window.open (no await): a popup opened later than the click is blocked. On mobile
    // wa.me hands over to the WhatsApp app. The current page is never navigated.
    waSend.addEventListener('click', () => {
      if (!validateFilled()) return;
      const p = collect();
      window.open(whatsappUrl(p), '_blank', 'noopener');
      const w = window as unknown as { dataLayer?: unknown[] };
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ event: 'whatsapp_click', destination: p.branch, source: 'booking_form', page_path: location.pathname, page_location: location.href });
    });
    function showFallback(msg: string) {
      formError.textContent = msg;
      formError.classList.remove('hidden');
      waSend.scrollIntoView({ block: 'nearest' });
    }
    function setSending(on: boolean) {
      sending = on;
      submitBtn.disabled = on;
      submitBtn.setAttribute('aria-busy', String(on));
      spinner.classList.toggle('hidden', !on);
      submitLabel.textContent = on ? S.sending : S.submit;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return; // no double submit
      formError.classList.add('hidden');
      await loadPhoneLib();
      if (!validateAll()) return;
      const p = collect();
      const r = validateBooking(p, ctx());
      if (!r.ok) return;
      const d = r.data;
      if (!data.endpoint) {
        // no endpoint configured for this build → point to the WhatsApp hand-off, never a silent failure
        // (no window.open here: after the await above a popup would be blocked)
        showFallback(S.errors.server);
        return;
      }
      setSending(true);
      let leaving = false;
      try {
        const headers: Record<string, string> = { 'Content-Type': 'application/json' };
        if (data.anonKey) {
          headers['Authorization'] = `Bearer ${data.anonKey}`;
          headers['apikey'] = data.anonKey;
        }
        const body = {
          locale: data.locale,
          branch: d.branch,
          room: d.room,
          check_in: d.check_in,
          check_out: d.check_out,
          adults: String(d.adults),
          children: String(d.children),
          extra_beds: String(d.extra_beds),
          breakfast: d.breakfast,
          name: d.name,
          phone: d.phone,
          country: p.country,
          email: d.email,
          notes: d.notes,
          website: String(new FormData(form).get('website') ?? ''),
          page: location.href,
        };
        const res = await fetch(data.endpoint, { method: 'POST', headers, body: JSON.stringify(body) });
        const json = (await res.json().catch(() => ({}))) as { ok?: boolean; ref?: string; error?: string };
        if (!res.ok || !json.ok || !json.ref) throw new Error(json.error || `HTTP ${res.status}`);
        const params = new URLSearchParams({
          ref: json.ref,
          branch: d.branch,
          room: d.room || 'any',
          nights: String(d.nights),
          breakfast: d.breakfast,
          beds: String(d.extra_beds),
          nc: d.needs_coordination ? '1' : '0',
          c: d.email ? 'email' : 'whatsapp',
        });
        leaving = true;
        location.assign(`${data.successPath}?${params.toString()}`);
      } catch {
        showFallback(S.errors.server);
      } finally {
        if (!leaving) setSending(false);
      }
    });

    const q = new URLSearchParams(location.search);
    prefill(q.get('branch'), q.get('room'));
    form.addEventListener('booking:prefill', (e) => {
      const d = (e as CustomEvent<{ branch?: string | null; room?: string | null }>).detail || {};
      if (!d.branch) branchSel.value = '';
      prefill(d.branch ?? null, d.room ?? null);
    });
    refresh();
  }

  onPageLoad(() => {
    document.querySelectorAll<HTMLFormElement>('form[data-booking-form]').forEach((form) => {
      if (bindOnce(form)) initForm(form);
    });
  });
</script>
