---
/**
 * Booking-request form (CLAUDE.md §8; rebuilt 23 Oct 2026 — decisions A2/A3) — one component for the /booking/
 * page and the booking drawer. Every rule lives in supabase/functions/booking-request/rules.ts and is shared with
 * the Edge Function, so the browser and the server validate the same way. Strings come from ui.json; branches,
 * rooms and capacities from content/; the phone field with its country selector is the shared PhoneField.astro
 * (28 Oct 2026 — the same component and behaviour as the partners enquiry wizard). `prefix` keeps ids unique when
 * two forms share a page.
 */
import { branchContact, branchShort, branches, extraBedFeeLine, L, localePath, marketingConsent, rooms, ui, type Locale } from '@lib/content';
import { promoCodesLive } from '@lib/offers-data';
import Icon from './Icon.astro';
import DateRangeField from './DateRangeField.astro';
import PhoneField from './PhoneField.astro';
import MarketingConsent from './MarketingConsent.astro';

interface Props {
  locale: Locale;
  prefix?: string;
  class?: string;
}
const { locale, prefix = '', class: className = '' } = Astro.props;
const t = ui(locale);
const f = t.form;
const id = (name: string) => `${prefix}${name}`;

const endpoint = import.meta.env.PUBLIC_BOOKING_ENDPOINT ?? '';
const anonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
// runtime prices (phase 2a): the two read-only RPCs live on the same Supabase project as the booking function
const supabaseUrl = (() => {
  try {
    return endpoint ? new URL(endpoint).origin : '';
  } catch {
    return '';
  }
})();
const bookable = rooms.filter((r) => r.availability !== 'sold_out');

/** Everything the client script needs, all from content/ (the country list travels in PhoneField's own JSON). */
const clientData = {
  locale,
  endpoint,
  anonKey,
  supabaseUrl,
  quote: t.quote,
  /** the promo-code field exists only while a code can be used («العروض», 2 Nov 2026) */
  promo: promoCodesLive,
  successPath: localePath(locale, '/booking/success/'),
  /** the marketing consent's version (club.json) — what the server records when the box is ticked */
  consentVersion: marketingConsent.version,
  partnersPath: localePath(locale, '/partners/enquiry/'),
  branches: branches.map((b) => ({ slug: b.slug, name: L(locale, b, 'name'), short: branchShort(locale, b.slug), whatsapp: branchContact(b.slug).whatsapp })),
  rooms: bookable.map((r) => ({ slug: r.slug, branch: r.branch, name: L(locale, r, 'name'), capacity: r.capacity, extra_beds_max: r.extra_beds_max ?? 0, availability: r.availability })),
  strings: {
    anyRoom: f.any_room,
    roomCleared: f.room_cleared,
    sending: f.sending,
    submit: f.submit,
    errors: f.errors,
    whatsappMessage: f.whatsapp_message,
    breakfastWith: f.breakfast_with,
    breakfastWithout: f.breakfast_without,
    stayLength: f.stay_length,
    plural: f.plural,
    capacityBranch: f.capacity_branch,
    capacityBranchLink: f.capacity_branch_link,
    bedsAuto: f.extra_beds_auto,
    bedsPlural: f.extra_beds_plural,
    bedsPluralAcc: f.extra_beds_plural_acc,
    capacityBeds: f.capacity_beds,
    capacityNoBeds: f.capacity_no_beds,
    bedsLabel: f.extra_beds,
    adults: f.adults,
    children: f.children,
  },
};
const promo = (t.quote as unknown as { promo: Record<string, string> }).promo;
const inputClass = 'field-input w-full border border-line rounded bg-white';
const latinInput = `${inputClass} latin text-left`;
const err = (name: string) => id(`${name}-error`);
const stepper = (name: 'adults' | 'children' | 'extra_beds', value: number, min: number) => ({ name, value, min, label: f[name] });
---

<form id={id('booking-form')} class:list={['booking-form space-y-6', className]} novalidate data-booking-form>
  <div class="grid gap-5 sm:grid-cols-2">
    {/* 1. Branch first */}
    <div class="sm:col-span-2 field field-select">
      <select id={id('branch')} name="branch" required autocomplete="off" class={inputClass} aria-describedby={err('branch')}>
        <option value="">{f.choose_branch}</option>
        {branches.map((b) => <option value={b.slug}>{L(locale, b, 'name')}</option>)}
      </select>
      <label for={id('branch')} class="field-label">{f.branch}</label>
      <p id={err('branch')} class="field-error hidden" data-error-for="branch"></p>
    </div>

    {/* 2. Room type: with no branch chosen every bookable room, grouped by branch (25 Oct 2026, Ahmed) — picking one
        selects its branch; with a branch only that branch's group. Shared slugs stay branch-specific (data-branch). */}
    <div class="sm:col-span-2 field field-select">
      <select id={id('room')} name="room" autocomplete="off" class={inputClass} aria-describedby={`${err('room')} ${id('room-note')}`}>
        <option value="">{f.any_room}</option>
        {branches.map((b) => (
          <optgroup label={branchShort(locale, b.slug)} data-branch={b.slug}>
            {bookable.filter((r) => r.branch === b.slug).map((r) => <option value={r.slug} data-branch={r.branch} data-capacity={r.capacity}>{L(locale, r, 'name')}</option>)}
          </optgroup>
        ))}
      </select>
      <label for={id('room')} class="field-label">{f.room_type}</label>
      <p id={err('room')} class="field-error hidden" data-error-for="room"></p>
      <p id={id('room-note')} class="hidden mt-2 text-sm text-ink-muted" data-room-note aria-live="polite"></p>
    </div>

    {/* 3. Dates: calendar range picker, no typing (decision 23 Oct 2026); ISO values in hidden inputs; no past days
        (Asia/Riyadh), departure after arrival, up to the end of next year */}
    <DateRangeField
      locale={locale}
      variant="booking"
      names={['check_in', 'check_out']}
      ids={[id('check_in'), id('check_out')]}
      labels={[f.check_in, f.check_out]}
      errorIds={[err('check_in'), err('check_out')]}
      class="sm:col-span-2"
    />
    <p class="sm:col-span-2 -mt-2 text-sm text-ink-muted hidden" data-nights aria-live="polite"></p>

    {/* 4. Guests: steppers, digits only. Adults ≤ room capacity + extra beds (rooms.json); children are not limited
        beyond a technical bound. Extra beds: 0–2 per room type, hidden when the room (or, with «أي غرفة متاحة», the
        whole branch) takes none; the fee sentence comes from pricing.json (the one allowed price line). */}
    <fieldset class="sm:col-span-2" aria-describedby={`${err('adults')} ${id('capacity-note')}`}>
      <legend class="text-sm font-semibold text-midnight mb-2">{f.guests}</legend>
      <div class="grid gap-4 grid-cols-2">
        {
          [stepper('adults', 2, 1), stepper('children', 0, 0), stepper('extra_beds', 0, 0)].map((s) => (
            <div class:list={['stepper', s.name === 'extra_beds' ? 'col-span-2 sm:col-span-1 hidden' : '']} data-stepper={s.name}>
              <label for={id(s.name)} class="block text-xs text-ink-muted mb-1">{s.label}</label>
              <div class="flex items-stretch border border-line rounded bg-white h-12" dir="ltr">
                <button type="button" class="stepper-btn" data-step="-1" aria-controls={id(s.name)} aria-label={f.guests_dec.replace('{field}', s.label)}>
                  <Icon name="minus" size={18} />
                </button>
                <input
                  id={id(s.name)}
                  name={s.name}
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  autocomplete="off"
                  maxlength="2"
                  value={String(s.value)}
                  data-min={s.min}
                  data-max={s.name === 'extra_beds' ? '0' : '20'}
                  lang="en"
                  class="latin w-full min-w-0 text-center bg-transparent text-midnight font-semibold focus:outline-none"
                  aria-describedby={s.name === 'adults' ? err('adults') : s.name === 'extra_beds' ? `${id('extra-beds-note')} ${err('extra_beds')}` : undefined}
                />
                <button type="button" class="stepper-btn" data-step="1" aria-controls={id(s.name)} aria-label={f.guests_inc.replace('{field}', s.label)}>
                  <Icon name="plus" size={18} />
                </button>
              </div>
            </div>
          ))
        }
      </div>
      <p id={err('adults')} class="field-error hidden" data-error-for="adults"></p>
      <p id={err('extra_beds')} class="field-error hidden" data-error-for="extra_beds"></p>
      <p class="hidden mt-2 text-sm text-midnight bg-porcelain rounded px-3 py-2" data-beds-auto aria-live="polite"></p>
      <p id={id('extra-beds-note')} class="hidden mt-2 text-xs text-ink-muted" data-beds-fee>{extraBedFeeLine(locale)}</p>
      <p id={id('capacity-note')} class="hidden mt-2 text-sm text-ink-muted" data-capacity-note></p>
    </fieldset>

    {/* 5. Breakfast: required choice, no default (decision A2) */}
    <fieldset class="sm:col-span-2" data-breakfast aria-describedby={err('breakfast')}>
      <legend class="text-sm font-semibold text-midnight mb-2">{f.breakfast}</legend>
      <div class="grid grid-cols-2 gap-3">
        {
          (['with', 'without'] as const).map((v) => (
            <label class="choice">
              <input type="radio" name="breakfast" value={v} class="sr-only peer" required />
              <span class="choice-box">{v === 'with' ? f.breakfast_with : f.breakfast_without}</span>
            </label>
          ))
        }
      </div>
      <p id={err('breakfast')} class="field-error hidden" data-error-for="breakfast"></p>
    </fieldset>

    {/* 5b. Children's ages (Q2, 24 Oct 2026): only when children > 0 AND breakfast = with — they price breakfast and
        nothing else; one select per child, filled by the script */}
    <fieldset class="sm:col-span-2 hidden" data-ages aria-describedby={`${id('ages-hint')} ${err('children_ages')}`}>
      <legend class="text-sm font-semibold text-midnight mb-1">{t.quote.ages_heading}</legend>
      <p id={id('ages-hint')} class="text-xs text-ink-muted mb-2">{t.quote.ages_hint}</p>
      <div class="grid gap-3 grid-cols-2 sm:grid-cols-3" data-ages-list></div>
      <p id={err('children_ages')} class="field-error hidden" data-error-for="children_ages"></p>
    </fieldset>

    {/* 5b. Promo code («العروض», 2 Nov 2026): only while a live offer has one. Upper case, checked by quote_stay with the
        price (the status under the field) and again by the server on submit (an invalid code is a field error). */}
    {
      promoCodesLive && (
        <div class="sm:col-span-2 field" data-promo-field>
          <input id={id('promo_code')} name="promo_code" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="20" lang="en" dir="ltr" placeholder=" " class={`${latinInput} uppercase`} aria-describedby={`${id('promo-status')} ${err('promo_code')}`} />
          <label for={id('promo_code')} class="field-label">{f.promo}</label>
          <p id={id('promo-status')} class="hidden text-xs text-midnight font-semibold mt-1" data-promo-status role="status" aria-live="polite"></p>
          <p id={err('promo_code')} class="field-error hidden" data-error-for="promo_code"></p>
        </div>
      )
    }

    {/* 5c. Price for the chosen dates (decision 4): read at runtime from quote_stay; nothing is baked into the page.
        Hidden until a room type and both dates are set; «أي غرفة متاحة» shows the pick-room hint only. */}
    <div class="sm:col-span-2 hidden rounded border border-line bg-porcelain p-4" data-quote aria-live="polite">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-bronze-text">{t.quote.heading}</h3>
        <span class="hidden text-xs font-semibold rounded-full px-2.5 py-1" data-quote-badge></span>
      </div>
      <p class="hidden text-sm text-ink-muted" data-quote-note></p>
      <table class="w-full text-sm hidden" data-quote-table>
        <tbody>
          <tr data-quote-row="room"><td class="py-0.5"></td><td class="py-0.5 text-end font-semibold latin" dir="auto"></td></tr>
          <tr data-quote-row="breakfast" class="hidden"><td class="py-0.5">{t.quote.breakfast_line}</td><td class="py-0.5 text-end font-semibold" dir="auto"></td></tr>
          <tr data-quote-row="beds" class="hidden"><td class="py-0.5"></td><td class="py-0.5 text-end font-semibold" dir="auto"></td></tr>
          <tr data-quote-row="discount" class="hidden"><td class="py-0.5"></td><td class="py-0.5 text-end font-semibold" dir="auto"></td></tr>
          <tr data-quote-row="total" class="border-t border-line"><td class="pt-1.5 font-bold">{t.quote.total_line}</td><td class="pt-1.5 text-end font-bold text-midnight" dir="auto"></td></tr>
        </tbody>
      </table>
      <details class="hidden mt-2 text-xs text-ink-muted" data-quote-nights>
        <summary class="cursor-pointer">{t.quote.per_night}</summary>
        <ul class="mt-1 grid gap-0.5" data-quote-nights-list></ul>
      </details>
      <p class="hidden mt-2 text-xs text-ink-muted" data-quote-pay>{t.quote.pay_at_hotel}</p>
      <p class="hidden mt-2 text-sm font-semibold text-red-800" data-quote-changed role="status">{t.quote.price_changed}</p>
    </div>

    {/* 6. Name */}
    <div class="sm:col-span-2 field">
      <input id={id('name')} name="name" type="text" autocomplete="name" autocapitalize="words" spellcheck="false" required maxlength="120" placeholder=" " class={inputClass} aria-describedby={err('name')} />
      <label for={id('name')} class="field-label">{f.full_name}</label>
      <p id={err('name')} class="field-error hidden" data-error-for="name"></p>
    </div>

    {/* 7. Phone (WhatsApp), required: the shared field — country selector with self-hosted flags + national number,
        stored as E.164 (src/components/PhoneField.astro, src/lib/country-select.ts) */}
    <PhoneField locale={locale} variant="booking" id={id('phone')} name="phone" countryName="country" label={f.phone} hint={f.phone_hint} hintId={id('phone-hint')} errorId={err('phone')} />

    {/* 8. Email, optional; validated when present */}
    <div class="sm:col-span-2 field">
      <input id={id('email')} name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" lang="en" dir="ltr" placeholder=" " class={latinInput} aria-describedby={`${id('email-hint')} ${err('email')}`} />
      <label for={id('email')} class="field-label">{f.email}</label>
      <p id={id('email-hint')} class="text-xs text-ink-muted mt-1">{f.email_hint}</p>
      <p id={err('email')} class="field-error hidden" data-error-for="email"></p>
    </div>

    <div class="sm:col-span-2 field field-textarea">
      <textarea id={id('notes')} name="notes" rows="3" maxlength="1000" autocomplete="off" placeholder=" " class={inputClass} aria-describedby={id('notes-hint')}></textarea>
      <label for={id('notes')} class="field-label">{f.notes}</label>
      <p id={id('notes-hint')} class="text-xs text-ink-muted mt-1">{f.notes_hint}</p>
    </div>

    {/* 9. Marketing consent (Ahmed, 3 Nov 2026): one optional box, unticked; never required to book, never changes the
        price or the confirmation — offers by WhatsApp and email and ads on the platforms (club.json → consent) */}
    <div class="sm:col-span-2">
      <MarketingConsent locale={locale} id={id('marketing_consent')} name="marketing_consent" hook="data-marketing-consent" />
    </div>
  </div>

  {/* Honeypot: invisible to people and assistive tech; a bot that fills it gets a fake success and nothing is stored. */}
  <div class="absolute -start-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
    <label for={id('website')}>Website</label>
    <input id={id('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="text-xs text-ink-muted">
    {f.consent}
    <a href={localePath(locale, '/policies/')} class="font-semibold link-bronze ms-1">{f.consent_link}</a>.
  </p>

  <p class="hidden text-sm font-semibold text-midnight bg-porcelain rounded px-4 py-3" data-summary aria-live="polite"></p>
  <p class="hidden bg-porcelain border border-line text-sm text-red-800 rounded px-4 py-3" data-form-error role="alert"></p>

  <div class="flex flex-wrap items-center gap-3">
    <button type="submit" class="inline-flex items-center gap-2 bg-bronze-deep text-white font-semibold px-6 py-3 rounded hover:bg-bronze-text transition-colors disabled:opacity-70" data-submit>
      <span class="spinner hidden" aria-hidden="true" data-spinner></span>
      <span data-submit-label>{f.submit}</span>
      <Icon name="arrow" size={18} class="icon-arrow rtl:rotate-180" />
    </button>
    {/* WhatsApp hand-off (23 Oct 2026): a real button, always offered; it validates like the submit, then opens wa.me
        from inside the click handler (popup blockers allow it) and never navigates this page. */}
    <button type="button" class="inline-flex items-center gap-2 border border-midnight text-midnight font-semibold px-5 py-3 rounded hover:bg-midnight hover:text-white transition-colors" data-wa-send>
      <Icon name="whatsapp" size={18} />
      <span>{f.whatsapp_fallback}</span>
    </button>
  </div>

  <script type="application/json" data-booking-data set:html={JSON.stringify(clientData).replace(/</g, '\\u003c')} />
</form>

<script>
  import { afterPaint, bindOnce, onPageLoad } from '@lib/client';

  // post-launch session 1 (8 Nov 2026, mobile LCP): the drawer's form is not part of the first view, so it starts once
  // the page has painted (afterPaint). A booking link pressed before that asks for it at once (`booking:init`,
  // dispatched by drawer.ts, which waits for `booking:ready` while the code arrives). The /booking/ page's own form
  // starts immediately. 9 Nov 2026: the form's code is a separate module (src/lib/booking-form.ts) imported when the
  // form starts, so nothing of it is requested before the first paint; a failed load marks the form
  // (`booking:failed`) and the drawer's link falls back to the booking page.
  onPageLoad(() => {
    document.querySelectorAll<HTMLFormElement>('form[data-booking-form]').forEach((form) => {
      if (!bindOnce(form)) return;
      const start = () => {
        if (!bindOnce(form, 'booking-init')) return;
        form.setAttribute('data-booking-loading', '');
        import('@lib/booking-form')
          // a task of its own after the module's evaluation, so the two never add up to one long task
          .then((m) => new Promise<void>((r) => setTimeout(r, 0)).then(() => m.startBookingForm(form)))
          .catch(() => form.dispatchEvent(new CustomEvent('booking:failed')))
          .finally(() => form.removeAttribute('data-booking-loading'));
      };
      if (form.closest('[data-booking-drawer]')) {
        form.addEventListener('booking:init', start);
        afterPaint(start);
      } else start();
    });
  });
</script>
