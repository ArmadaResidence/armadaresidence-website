---
/**
 * Split-screen branch chooser on the home page (item 4, 11 Oct 2026): two full-bleed panes (Airport Road / Shafa
 * Road), each with its photo, type, name, two lines and a button. Hover or keyboard focus widens the pane to 58 %
 * and dims the other one; the widening is done by scaling the media layer (transform only — the text columns keep
 * their 50 % and nothing re-lays out). Under md the panes stack as two near-full-height cards.
 * Facts come from branches.json / contact.json only. Photos (4 Nov 2026): each pane shows its branch's published cover
 * («الصور», merged by content.ts — the same photo as the branch page's cover), else the brand-pattern placeholder.
 * The whole card opens the branch page (Ahmed, 5 Nov 2026): ONE link per card, the branch name, stretched over the
 * pane by its ::after (no nested links); «عرض الفرع» is its look only; the phone stays its own link above the stretch
 * and still dials. Hover and focus act on the whole card, with a ring around it. CSS in global.css (.split-*).
 * Under the text only (Ahmed, 7 Nov 2026): the midnight gradient is as tall as the card's text (+ a soft 4rem edge
 * above it) instead of the whole card, so the rest of the photo shows; its strength is measured per cover at build time
 * (photos-engine cardScrim → --card-a-lg / --card-a-m), 0.9 without a measure. A branch's «صورة الجوال» (9:16) fills the
 * card under 768 px; without one the phone gets the desktop cover as before.
 */
import { branchContact, branchPath, fill, L, paragraphs, photoProps, photosOf, telHref, ui, type Branch, type Locale } from '@lib/content';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  locale: Locale;
  branches: Branch[];
}
const { locale, branches } = Astro.props;
const t = ui(locale);
const firstSentence = (text: string) => {
  const p = paragraphs(text)[0] ?? '';
  const m = p.match(/^[^.؟!?]+[.؟!?]/);
  return (m ? m[0] : p).trim();
};
---

<div class="split reveal-group enter-m" data-split>
  {
    branches.map((b) => {
      const name = L(locale, b, 'name');
      const href = branchPath(locale, b.slug);
      const c = branchContact(b.slug);
      const cover = photosOf(b)[0];
      const cs = cover?.card_scrim;
      return (
        <article class="split-pane" style={cs ? `--card-a-lg:${cs.lg};--card-a-m:${cs.m}` : undefined}>
          <div class="split-media" aria-hidden="true">
            <div class="split-media-inner">
              {cover ? (
                // the phone photo (9:16) is shown scaled to the ~1:2 card's height: a little wider than the screen
                <Photo {...photoProps(locale, cover, { mobileSizes: '120vw' })} sizes="(min-width: 768px) 58vw, 100vw" class="photo-fill split-photo" imgClass="w-full h-full object-cover" />
              ) : (
                <Placeholder label={fill(t.photo_pending_alt, { subject: name })} class="photo-fill rounded-none" />
              )}
            </div>
            <div class="split-shade" />
          </div>
          <div class="split-gradient" aria-hidden="true" />
          <div class="split-body">
            <p class="text-xs font-semibold uppercase tracking-wide text-bronze-bright">{L(locale, b, 'type')}</p>
            <h3 class="mt-2 text-2xl md:text-3xl font-bold text-porcelain">
              <a href={href} class="split-title-link" data-split-link><span class="split-title-text">{name}</span></a>
            </h3>
            <p class="mt-2 text-porcelain/90">{L(locale, b, 'tagline')}</p>
            <p class="split-desc mt-1 text-sm text-porcelain/75 max-w-md">{firstSentence(L(locale, b, 'description'))}</p>
            <div class="split-actions mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
              <span class="split-cta inline-flex items-center gap-2 bg-bronze-deep text-white text-sm font-semibold px-4 py-2.5 rounded transition-colors" aria-hidden="true">
                <span>{t.home.view_branch}</span>
                <Icon name="arrow" size={16} class="icon-arrow rtl:rotate-180" />
              </span>
              <a href={telHref(c.phone)} class="split-phone latin inline-flex items-center gap-2 text-sm text-porcelain/85 hover:text-white" dir="ltr">
                <Icon name="phone" size={16} />
                <span>{c.phone_display}</span>
              </a>
            </div>
          </div>
        </article>
      );
    })
  }
</div>
