---
/**
 * Progressive photo (item 13, 11 Oct 2026): a box with the final aspect ratio (width/height → no layout shift),
 * a brand-tinted placeholder underneath (and an optional tiny blurred LQIP from `lqip`), and the real image
 * fading in from a soft blur once it has decoded (src/lib/photo.ts adds .is-loaded; no JS → the image just
 * shows). Ready for the branch / room photo set: pass src, srcset, sizes, alt (page language, from content/),
 * width, height. Use loading="eager" + fetchpriority="high" only for the LCP image.
 */
interface Props {
  src: string;
  srcset?: string;
  /** AVIF widths of the same photo (scripts/photos-import.mjs); given → <picture> offers AVIF first, WebP stays the img */
  avifSrcset?: string;
  sizes?: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** tiny data: URI (≈ 16 px wide) shown blurred under the photo while it loads */
  lqip?: string;
  class?: string;
  imgClass?: string;
  draggable?: boolean;
  /** «صورة الجوال» (7 Nov 2026): the phone files of the same photo (another crop or its own phone photo) — given, the
   *  <picture> serves them under 768 px (AVIF then WebP); without them a phone gets the desktop set, as before */
  mobile?: { srcset: string; avifSrcset?: string; width: number; height: number; sizes?: string };
}
const { src, srcset, avifSrcset, sizes, alt, width, height, loading = 'lazy', fetchpriority, lqip, class: className = '', imgClass = '', draggable, mobile } = Astro.props;
const PHONE = '(max-width: 767px)';
const style = lqip ? `background-image:url("${lqip}")` : undefined;
const img = {
  src,
  srcset,
  sizes,
  alt,
  width,
  height,
  loading,
  fetchpriority,
  decoding: 'async' as const,
  draggable: draggable === false ? ('false' as const) : undefined,
};
---

<span class:list={['photo', className]} style={style} data-photo>
  {
    avifSrcset || mobile ? (
      /* display: contents keeps the img the box's direct layout child */
      <picture class="contents">
        {mobile?.avifSrcset && <source media={PHONE} type="image/avif" srcset={mobile.avifSrcset} sizes={mobile.sizes ?? sizes} width={mobile.width} height={mobile.height} />}
        {mobile && <source media={PHONE} type="image/webp" srcset={mobile.srcset} sizes={mobile.sizes ?? sizes} width={mobile.width} height={mobile.height} />}
        {avifSrcset && <source type="image/avif" srcset={avifSrcset} sizes={sizes} />}
        <img {...img} class:list={['photo-img', imgClass]} />
      </picture>
    ) : (
      <img {...img} class:list={['photo-img', imgClass]} />
    )
  }
</span>
