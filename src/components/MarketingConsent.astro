---
/**
 * The ONE marketing consent line (Ahmed, 4 Nov 2026; wording of 6 Nov 2026): the box, the shared text of club.json →
 * consent (its current version is what the forms send) and «سياسة الخصوصية» / "Privacy Policy" to the privacy section
 * «عضوية إياب والتسويق» (/policies/#club). Unticked by default.
 * Used by the booking form (optional, unticked) and the club form (required there). The label is the text alone, so the
 * box's accessible name is the consent itself; the link follows it on the same line.
 */
import { clubPrivacyHref, consentLinkText, marketingConsent, type Locale } from '@lib/content';

interface Props {
  locale: Locale;
  id: string;
  name: string;
  required?: boolean;
  describedBy?: string;
  /** data-* hook of the box (data-marketing-consent / data-club-consent) */
  hook: string;
}
const { locale, id, name, required = false, describedBy, hook } = Astro.props;
---

<div class="flex items-start gap-3 text-sm leading-relaxed text-ink">
  <input id={id} name={name} type="checkbox" value="yes" class="mt-1 size-5 accent-bronze-deep shrink-0" required={required} aria-describedby={describedBy} {...{ [hook]: '' }} />
  <span>
    <label for={id}>{locale === 'ar' ? marketingConsent.ar : marketingConsent.en}</label>
    <a href={clubPrivacyHref(locale)} class="link-bronze underline underline-offset-2 ms-1" data-consent-details>{consentLinkText(locale)}</a>
  </span>
</div>
