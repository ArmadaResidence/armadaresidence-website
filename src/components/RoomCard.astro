---
import {
  branchBySlug,
  fill,
  guestsWord,
  L,
  photoProps,
  photosOf,
  roomFeatureLabels,
  roomPath,
  soldOutLabel,
  ui,
  type Locale,
  type Room,
} from '@lib/content';
import Photo from './Photo.astro';
import Placeholder from './Placeholder.astro';
import PriceBlock from './PriceBlock.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  room: Room;
  showBranch?: boolean;
}
const { locale, room, showBranch = false } = Astro.props;
const t = ui(locale);
const branch = branchBySlug(room.branch);
const name = L(locale, room, 'name');
const href = roomPath(locale, room);
const soldOut = room.availability === 'sold_out';
// The cover from scripts/photos-import.mjs; none yet → the placeholder (legacy_main_image is never rendered).
const cover = photosOf(room)[0];
const photoLabel = fill(t.photo_pending_alt, { subject: `${name} — ${L(locale, branch, 'name')}` });
// Chips = structural features only (kitchen, living room, balcony, jacuzzi); equipment is on the room page.
const features = roomFeatureLabels(locale, room);
const meta = [
  fill(t.room.size_value, { size: room.size_m2 }),
  L(locale, room, 'bed'),
  `${t.room.included_guests} ${guestsWord(locale, room.included_guests)}`,
];
---

<article class="bg-white border border-line rounded-card overflow-hidden flex flex-col">
  <div class="relative">
    <a href={href} tabindex="-1" aria-hidden="true" class:list={['relative block', soldOut && 'opacity-60']} transition:name={`room-media-${room.branch}-${room.slug}`}>
      {
        cover ? (
          <Photo {...photoProps(locale, cover)} sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw" imgClass="w-full h-auto" />
        ) : (
          <Placeholder label={photoLabel} class="rounded-b-none" />
        )
      }
    </a>
    {/* the badge sits outside the faded link so it keeps full contrast (white on midnight 14.8:1; 4.1:1 at 60 %) */}
    {
      soldOut && (
        <span class="absolute top-3 start-3 bg-midnight text-white text-xs font-semibold px-2.5 py-1 rounded" aria-hidden="true">
          {soldOutLabel(locale, room)}
        </span>
      )
    }
  </div>
  <div class="p-5 flex flex-col gap-3 flex-1">
    <div>
      {showBranch && <p class="text-xs text-bronze-text font-semibold mb-1">{L(locale, branch, 'name')}</p>}
      <h3 class="text-lg font-semibold text-midnight">
        <a href={href} class="hover:text-bronze-text">{name}</a>
      </h3>
      {soldOut && <p class="sr-only">{soldOutLabel(locale, room)}</p>}
      <p class="text-sm text-ink-muted mt-1">{meta.join(' · ')}</p>
    </div>
    {
      features.length > 0 && (
        <ul class="flex flex-wrap gap-1.5">
          {features.map((f) => (
            <li class="text-xs bg-porcelain text-ink px-2 py-1 rounded">{f}</li>
          ))}
        </ul>
      )
    }
    <div class="mt-auto pt-2 border-t border-line">
      <PriceBlock locale={locale} room={room} mode="card" />
      <a href={href} class="mt-3 inline-flex items-center gap-1 text-sm font-semibold link-bronze">
        <span>{t.branch.view_room}</span>
        <Icon name="arrow" size={16} class="icon-arrow rtl:rotate-180" />
      </a>
    </div>
  </div>
</article>
