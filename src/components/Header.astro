---
import { bookingPath, branches, contact, localePath, offersPageLive, otherLocale, siteName, ui, type BookingContext, type Locale } from '@lib/content';
import Icon from './Icon.astro';
import { galleryLive } from '@lib/gallery';
import { siteBar } from '@lib/offers-data';
import OfferBar from './OfferBar.astro';

interface Props {
  locale: Locale;
  path: string;
  switchPath?: string;
  /** branch / room pages: «احجز الآن» prefills that branch (and room) — Ahmed, 24 Oct 2026 */
  booking?: BookingContext;
}
const { locale, path, switchPath = path, booking } = Astro.props;
const bookHref = bookingPath(locale, booking);
const t = ui(locale);
const other = otherLocale(locale);

// «فروعنا» (Ahmed, 3 Nov 2026) replaces the two branch items: one entry per property the site shows, in branches.json
// order — its short name (the part of the name after «–») and its type; a branch hidden in «المحتوى والظهور» is left out
const properties = branches.map((b) => {
  const name = locale === 'ar' ? b.name_ar : b.name_en;
  return { slug: b.slug, path: `/${b.slug}/`, short: name.split(/\s+[–-]\s+/).pop() || name, type: locale === 'ar' ? b.type_ar : b.type_en };
});
const lead: { key: keyof typeof t.nav; path: string }[] = [{ key: 'home', path: '/' }];
const nav: { key: keyof typeof t.nav; path: string }[] = [
  // the gallery or the offers page hidden in «المحتوى والظهور» (3 Nov 2026) has no link;
  // the gallery appears once /gallery/ exists (≥ 6 published photos — Ahmed, 2 Nov 2026)
  ...(galleryLive ? [{ key: 'gallery' as const, path: '/gallery/' }] : []),
  { key: 'discover-taif', path: '/discover-taif/' },
  { key: 'blog', path: '/blog/' },
  ...(offersPageLive ? [{ key: 'offers' as const, path: '/offers/' }] : []),
  { key: 'contact', path: '/contact/' },
  { key: 'policies', path: '/policies/' },
];
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
const partnersActive = path.startsWith('/partners/');
// the ink sits under «فروعنا» on a property page and every page under it (rooms, the hall)
const propertiesActive = properties.some((b) => path.startsWith(b.path));
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:start-2 focus:z-[100] focus:bg-white focus:px-4 focus:py-2 focus:rounded"
  >{t.skip_to_content}</a
>
{siteBar && <OfferBar locale={locale} />}
<header class="sticky top-0 z-40" transition:name="site-header" transition:animate="none">
  {/* utility row: partners link + reception line (CLAUDE.md §6b) */}
  <div class="relative bg-midnight text-porcelain text-xs overflow-hidden">
    <div class="absolute inset-0 pattern-bg" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 h-8 flex items-center justify-between gap-4">
      {/* Partners button (raised and refined — Ahmed, 2 Nov 2026; replaces the hairline pill of 23 Oct): a bronze
          gradient with a top highlight and a soft shadow, secondary to «احجز الآن»; hover lifts it and one light sweep
          crosses it (src/styles/motion.css → .partners-pill; CSS only) */}
      <a
        href={localePath(locale, '/partners/')}
        class:list={['partners-pill', partnersActive ? 'is-current' : '']}
        aria-current={partnersActive ? 'page' : undefined}
        data-partners-pill
      >
        <span>{t.nav.partners}</span>
        <Icon name="arrow" size={12} class="icon-arrow rtl:rotate-180" />
        <span class="pill-sweep" aria-hidden="true"></span>
      </a>
      <span class="hidden sm:inline text-porcelain/75">{locale === 'ar' ? contact.working_hours_ar : contact.working_hours_en}</span>
    </div>
  </div>
  <div class="bg-white border-b border-line">
    {/* logo: h-8 → clear space X = half the symbol height = 16px; px-5 / h-16 keep ≥ 1X on every side */}
    <div class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between gap-4">
      <a href={localePath(locale, '/')} class="shrink-0 flex items-center" aria-label={siteName(locale)}>
        <img src="/brand/logo-horizontal.svg" alt={siteName(locale)} width="143" height="32" class="h-8 w-auto dark:hidden" />
        <img src="/brand/logo-horizontal_Porcelain.svg" alt={siteName(locale)} width="143" height="32" class="h-8 w-auto hidden dark:block" />
      </a>

      {/* desktop nav: one bronze ink line slides between items (item 5); without JS the active item keeps a static line */}
      <nav class="hidden lg:flex relative items-center gap-3 xl:gap-5 text-sm font-medium" aria-label={t.nav.menu} data-nav>
        {
          lead.map((n) => (
            <a
              href={localePath(locale, n.path)}
              class:list={['nav-link py-2 whitespace-nowrap transition-colors', isActive(n.path) ? 'text-midnight' : 'text-ink-muted hover:text-midnight']}
              aria-current={isActive(n.path) ? 'page' : undefined}
            >
              {t.nav[n.key]}
            </a>
          ))
        }
        {/* «فروعنا»: a disclosure (WAI-ARIA disclosure pattern) — click, or hover with a mouse; Tab walks its links, Esc
            closes it and returns to the button; without JS it opens on hover / focus-within (motion.css) */}
        {
          properties.length > 0 && (
            <div class="nav-props" data-nav-props>
              <button
                type="button"
                class:list={['nav-link nav-props-toggle py-2 whitespace-nowrap transition-colors inline-flex items-center gap-1', propertiesActive ? 'text-midnight' : 'text-ink-muted hover:text-midnight']}
                aria-expanded="false"
                aria-controls="nav-props-panel"
                data-current={propertiesActive ? '' : undefined}
                data-nav-props-toggle
              >
                <span>{t.nav.properties}</span>
                <svg class="nav-props-chevron" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                  <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
              <div id="nav-props-panel" class="nav-props-panel bg-white border border-line rounded shadow-lg" data-nav-props-panel>
                <ul class="py-2">
                  {properties.map((b) => (
                    <li>
                      <a
                        href={localePath(locale, b.path)}
                        class="nav-props-link block px-4 py-2 hover:bg-porcelain"
                        aria-current={path === b.path ? 'page' : undefined}
                        data-property={b.slug}
                      >
                        <span class="block font-semibold text-midnight whitespace-nowrap">{b.short}</span>
                        <span class="block text-xs font-normal text-ink-muted whitespace-nowrap">{b.type}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )
        }
        {
          nav.map((n) => (
            <a
              href={localePath(locale, n.path)}
              class:list={['nav-link py-2 whitespace-nowrap transition-colors', isActive(n.path) ? 'text-midnight' : 'text-ink-muted hover:text-midnight']}
              aria-current={isActive(n.path) ? 'page' : undefined}
            >
              {t.nav[n.key]}
            </a>
          ))
        }
        <span class="nav-ink" aria-hidden="true"></span>
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={localePath(other, switchPath)}
          hreflang={other}
          lang={other}
          class:list={['text-sm font-medium px-3 py-2 rounded hover:bg-porcelain', other === 'en' ? 'font-en' : 'font-ar']}
          >{t.switch_to}</a
        >
        <button
          type="button"
          class="inline-flex items-center justify-center w-10 h-10 rounded hover:bg-porcelain text-midnight"
          data-theme-toggle
          aria-label={t.theme.toggle}
          title={t.theme.toggle}
          data-label-dark={t.theme.to_dark}
          data-label-light={t.theme.to_light}
        >
          {/* moon ↔ sun (item 5): two glyphs cross-fade with a rotate/scale — transform + opacity only, so Safari lands
              on a clean final icon too (CSS cx/cy/r are not animatable there) */}
          <svg class="theme-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path class="theme-moon" fill="currentColor" d="M12.3 2.5a9.5 9.5 0 109.2 12.1 1 1 0 00-1.3-1.2 7 7 0 01-8.9-8.9 1 1 0 00-1-1.3z"></path>
            <g class="theme-sun" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4" fill="currentColor" stroke="none"></circle>
              <line x1="12" y1="1.5" x2="12" y2="3.5"></line>
              <line x1="12" y1="20.5" x2="12" y2="22.5"></line>
              <line x1="1.5" y1="12" x2="3.5" y2="12"></line>
              <line x1="20.5" y1="12" x2="22.5" y2="12"></line>
              <line x1="4.6" y1="4.6" x2="6" y2="6"></line>
              <line x1="18" y1="18" x2="19.4" y2="19.4"></line>
              <line x1="4.6" y1="19.4" x2="6" y2="18"></line>
              <line x1="18" y1="6" x2="19.4" y2="4.6"></line>
            </g>
          </svg>
        </button>
        <a
          href={bookHref}
          class="hidden sm:inline-flex items-center whitespace-nowrap bg-bronze-deep text-white text-sm font-semibold px-4 py-2 rounded hover:bg-bronze-text transition-colors"
          >{t.nav.book}</a
        >
        <button
          type="button"
          class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded hover:bg-porcelain"
          aria-controls="mobile-nav"
          aria-expanded="false"
          data-menu-toggle
        >
          <span class="sr-only">{t.nav.menu}</span>
          <Icon name="menu" size={24} class="icon-open" />
          <Icon name="close" size={24} class="icon-close hidden" />
        </button>
      </div>
    </div>

    <nav id="mobile-nav" class="lg:hidden hidden border-t border-line bg-white" aria-label={t.nav.menu}>
      <ul class="px-5 py-2">
        {
          lead.map((n) => (
            <li>
              <a
                href={localePath(locale, n.path)}
                class:list={['block py-3 border-b border-line font-medium', isActive(n.path) ? 'text-bronze-text' : 'text-midnight']}
                aria-current={isActive(n.path) ? 'page' : undefined}
              >
                {t.nav[n.key]}
              </a>
            </li>
          ))
        }
        {/* «فروعنا» as a subheading with the properties under it (no extra tap) */}
        {
          properties.length > 0 && (
            <li class="border-b border-line pb-1">
              <span id="mobile-props-heading" class="block pt-3 pb-1 text-xs font-semibold text-bronze-text">{t.nav.properties}</span>
              <ul aria-labelledby="mobile-props-heading">
                {properties.map((b) => (
                  <li>
                    <a
                      href={localePath(locale, b.path)}
                      class:list={['block py-2 ps-3 font-medium', path.startsWith(b.path) ? 'text-bronze-text' : 'text-midnight']}
                      aria-current={path === b.path ? 'page' : undefined}
                      data-property={b.slug}
                    >
                      <span class="block">{b.short}</span>
                      <span class="block text-xs font-normal text-ink-muted">{b.type}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          )
        }
        {
          nav.map((n) => (
            <li>
              <a
                href={localePath(locale, n.path)}
                class:list={[
                  'block py-3 border-b border-line font-medium',
                  isActive(n.path) ? 'text-bronze-text' : 'text-midnight',
                ]}
                aria-current={isActive(n.path) ? 'page' : undefined}
              >
                {t.nav[n.key]}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={localePath(locale, '/partners/')}
            class:list={['block py-3 border-b border-line font-medium', partnersActive ? 'text-bronze-text' : 'text-midnight']}
          >
            {t.nav.partners}
          </a>
        </li>
        <li class="py-3">
          <a
            href={bookHref}
            class="block text-center bg-bronze-deep text-white font-semibold px-4 py-3 rounded"
            >{t.nav.book}</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { bindOnce, onOutsidePress, onPageLeave, onPageLoad, reducedMotion } from '@lib/client';

  // nav ink: remembered across client-side navigations so it slides from the previous item to the new one
  let inkMemory: { x: string; w: string } | null = null;
  let activeNav: HTMLElement | null = null;
  onPageLeave(() => {
    const ink = document.querySelector<HTMLElement>('[data-nav] .nav-ink');
    inkMemory = ink && ink.classList.contains('is-on') ? { x: ink.style.getPropertyValue('--x'), w: ink.style.getPropertyValue('--w') } : null;
  });

  onPageLoad(() => {
    // light / dark toggle — the initial value is set on <html> by Base.astro before first paint
    const theme = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (theme && bindOnce(theme)) {
      const sync = () => {
        const dark = document.documentElement.getAttribute('data-theme') === 'dark';
        theme.setAttribute('aria-pressed', String(dark));
        theme.title = dark ? theme.dataset.labelLight || '' : theme.dataset.labelDark || '';
      };
      theme.addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('armada-theme', next);
        } catch {}
        sync();
      });
      sync();
    }
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const nav = document.getElementById('mobile-nav');
    if (btn && nav && bindOnce(btn)) {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        nav.classList.toggle('hidden', open);
        btn.querySelector('.icon-open')?.classList.toggle('hidden', !open);
        btn.querySelector('.icon-close')?.classList.toggle('hidden', open);
      });
    }

    const navEl = document.querySelector<HTMLElement>('[data-nav]');
    const ink = navEl?.querySelector<HTMLElement>('.nav-ink');
    if (navEl && ink && bindOnce(navEl)) {
      const links = Array.from(navEl.querySelectorAll<HTMLAnchorElement>('.nav-link'));
      activeNav = navEl.querySelector<HTMLElement>('.nav-link[aria-current], .nav-link[data-current]');
      const place = (a: HTMLElement, animate: boolean) => {
        if (!animate || reducedMotion()) ink.style.transition = 'none';
        // measured against the nav itself (the «فروعنا» wrapper is not the offset parent, but rects never depend on it)
        ink.style.setProperty('--x', `${a.getBoundingClientRect().left - navEl.getBoundingClientRect().left}px`);
        ink.style.setProperty('--w', String(a.offsetWidth));
        ink.classList.add('is-on');
        if (!animate || reducedMotion()) {
          void ink.offsetWidth;
          ink.style.transition = '';
        }
      };
      const rest = (animate: boolean) => (activeNav ? place(activeNav, animate) : ink.classList.remove('is-on'));
      if (inkMemory) {
        ink.style.transition = 'none';
        ink.style.setProperty('--x', inkMemory.x);
        ink.style.setProperty('--w', inkMemory.w);
        ink.classList.add('is-on');
        void ink.offsetWidth;
        ink.style.transition = '';
        rest(true);
      } else rest(false);
      links.forEach((a) => a.addEventListener('mouseenter', () => place(a, true)));
      navEl.addEventListener('mouseleave', () => rest(true));
      // focus inside the «فروعنا» panel keeps the ink under its button
      navEl.addEventListener('focusin', (e) => {
        const el = e.target as HTMLElement;
        const target = el.closest('[data-nav-props]')?.querySelector<HTMLElement>('[data-nav-props-toggle]') ?? el;
        if (target.classList.contains('nav-link')) place(target, true);
      });
      navEl.addEventListener('focusout', () => rest(true));
      document.fonts.ready.then(() => rest(false));
      let raf = 0;
      // per page: aborted on the next swap so resize listeners do not pile up across client-side navigations
      const ac = new AbortController();
      document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
      window.addEventListener(
        'resize',
        () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => rest(false));
        },
        { signal: ac.signal },
      );
    }

    // «فروعنا» disclosure (3 Nov 2026): a click toggles it; a mouse hover opens it and leaving closes what the hover
    // opened; Esc closes it and returns focus to the button; an outside press (start and end outside), focus leaving it
    // or a navigation closes it. Document listeners are aborted on the next swap, so nothing piles up.
    const props = document.querySelector<HTMLElement>('[data-nav-props]');
    const toggle = props?.querySelector<HTMLButtonElement>('[data-nav-props-toggle]');
    if (props && toggle && bindOnce(props)) {
      props.setAttribute('data-js', '');
      let by: 'hover' | 'click' | null = null;
      let leaveTimer = 0;
      const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
      const set = (open: boolean, how: 'hover' | 'click' | null = null) => {
        clearTimeout(leaveTimer);
        by = open ? how : null;
        toggle.setAttribute('aria-expanded', String(open));
        props.toggleAttribute('data-open', open);
      };
      toggle.addEventListener('click', () => {
        // a click on a panel the hover opened keeps it open (it now stays until closed)
        if (isOpen() && by === 'hover') by = 'click';
        else set(!isOpen(), 'click');
      });
      props.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        clearTimeout(leaveTimer);
        if (!isOpen()) set(true, 'hover');
      });
      props.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'mouse' || by !== 'hover') return;
        leaveTimer = window.setTimeout(() => set(false), 150);
      });
      props.addEventListener('focusout', (e) => {
        if (isOpen() && by !== 'hover' && !props.contains(e.relatedTarget as Node | null)) set(false);
      });
      props.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
      const ac = new AbortController();
      document.addEventListener(
        'astro:before-swap',
        () => {
          set(false);
          ac.abort();
        },
        { once: true },
      );
      document.addEventListener(
        'keydown',
        (e) => {
          if (e.key !== 'Escape' || !isOpen()) return;
          const inside = props.contains(document.activeElement);
          set(false);
          if (inside) toggle.focus();
        },
        { signal: ac.signal },
      );
      onOutsidePress(() => [props], () => set(false), { signal: ac.signal, active: isOpen });
    }
  });
</script>
