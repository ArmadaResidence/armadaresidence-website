---
import { localePath, otherLocale, siteName, ui, type Locale } from '@lib/content';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  path: string;
  switchPath?: string;
}
const { locale, path, switchPath = path } = Astro.props;
const t = ui(locale);
const other = otherLocale(locale);

const nav: { key: keyof typeof t.nav; path: string }[] = [
  { key: 'home', path: '/' },
  { key: 'airport-road', path: '/airport-road/' },
  { key: 'shafa-road', path: '/shafa-road/' },
  { key: 'offers', path: '/offers/' },
  { key: 'contact', path: '/contact/' },
  { key: 'policies', path: '/policies/' },
];
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:start-2 focus:z-[100] focus:bg-white focus:px-4 focus:py-2 focus:rounded"
  >{t.skip_to_content}</a
>
<header class="bg-white border-b border-line sticky top-0 z-40">
  <div class="mx-auto max-w-6xl px-4 h-16 flex items-center justify-between gap-4">
    <a href={localePath(locale, '/')} class="shrink-0 flex items-center" aria-label={siteName(locale)}>
      <img src="/brand/logo-horizontal.svg" alt={siteName(locale)} width="178" height="40" class="h-9 w-auto" />
    </a>

    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium" aria-label={t.nav.menu}>
      {
        nav.map((n) => (
          <a
            href={localePath(locale, n.path)}
            class:list={[
              'py-2 border-b-2 transition-colors',
              isActive(n.path) ? 'border-bronze text-midnight' : 'border-transparent text-ink-muted hover:text-midnight',
            ]}
            aria-current={isActive(n.path) ? 'page' : undefined}
          >
            {t.nav[n.key]}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={localePath(other, switchPath)}
        hreflang={other}
        lang={other}
        class:list={['text-sm font-medium px-3 py-2 rounded hover:bg-porcelain', other === 'en' ? 'font-en' : 'font-ar']}
        >{t.switch_to}</a
      >
      <a
        href={localePath(locale, '/booking/')}
        class="hidden sm:inline-flex items-center bg-bronze text-white text-sm font-semibold px-4 py-2 rounded hover:bg-bronze-deep transition-colors"
        >{t.nav.book}</a
      >
      <button
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded hover:bg-porcelain"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">{t.nav.menu}</span>
        <Icon name="menu" size={24} class="icon-open" />
        <Icon name="close" size={24} class="icon-close hidden" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="lg:hidden hidden border-t border-line bg-white" aria-label={t.nav.menu}>
    <ul class="px-4 py-2">
      {
        nav.map((n) => (
          <li>
            <a
              href={localePath(locale, n.path)}
              class:list={[
                'block py-3 border-b border-line font-medium',
                isActive(n.path) ? 'text-bronze' : 'text-midnight',
              ]}
              aria-current={isActive(n.path) ? 'page' : undefined}
            >
              {t.nav[n.key]}
            </a>
          </li>
        ))
      }
      <li class="py-3">
        <a
          href={localePath(locale, '/booking/')}
          class="block text-center bg-bronze text-white font-semibold px-4 py-3 rounded"
          >{t.nav.book}</a
        >
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('hidden', open);
      btn.querySelector('.icon-open')?.classList.toggle('hidden', !open);
      btn.querySelector('.icon-close')?.classList.toggle('hidden', open);
    });
  }
</script>
