---
import { contact, localePath, otherLocale, siteName, ui, type Locale } from '@lib/content';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  path: string;
  switchPath?: string;
}
const { locale, path, switchPath = path } = Astro.props;
const t = ui(locale);
const other = otherLocale(locale);

const nav: { key: keyof typeof t.nav; path: string }[] = [
  { key: 'home', path: '/' },
  { key: 'airport-road', path: '/airport-road/' },
  { key: 'shafa-road', path: '/shafa-road/' },
  { key: 'discover-taif', path: '/discover-taif/' },
  { key: 'blog', path: '/blog/' },
  { key: 'offers', path: '/offers/' },
  { key: 'contact', path: '/contact/' },
  { key: 'policies', path: '/policies/' },
];
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
const partnersActive = path.startsWith('/partners/');
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:start-2 focus:z-[100] focus:bg-white focus:px-4 focus:py-2 focus:rounded"
  >{t.skip_to_content}</a
>
<header class="sticky top-0 z-40" transition:name="site-header" transition:animate="none">
  {/* utility row: partners link + reception line (CLAUDE.md §6b) */}
  <div class="relative bg-midnight text-porcelain text-xs overflow-hidden">
    <div class="absolute inset-0 pattern-bg" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 h-8 flex items-center justify-between gap-4">
      {/* Partners pill (23 Oct 2026): bronze hairline border, quieter than «اطلب حجزًا»; on the first page view of the
          session the hairline draws around it once (src/styles/motion.css → .partners-pill, script below) */}
      <a
        href={localePath(locale, '/partners/')}
        class:list={['partners-pill', partnersActive ? 'is-current' : '']}
        aria-current={partnersActive ? 'page' : undefined}
        data-partners-pill
      >
        <span>{t.nav.partners}</span>
        <Icon name="arrow" size={12} class="icon-arrow rtl:rotate-180" />
        <svg class="pill-draw" aria-hidden="true" focusable="false"><path data-pill-a pathLength="1"></path><path data-pill-b pathLength="1"></path></svg>
      </a>
      <span class="hidden sm:inline text-porcelain/75">{locale === 'ar' ? contact.working_hours_ar : contact.working_hours_en}</span>
    </div>
  </div>
  <div class="bg-white border-b border-line">
    {/* logo: h-8 → clear space X = half the symbol height = 16px; px-5 / h-16 keep ≥ 1X on every side */}
    <div class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between gap-4">
      <a href={localePath(locale, '/')} class="shrink-0 flex items-center" aria-label={siteName(locale)}>
        <img src="/brand/logo-horizontal.svg" alt={siteName(locale)} width="143" height="32" class="h-8 w-auto dark:hidden" />
        <img src="/brand/logo-horizontal_Porcelain.svg" alt={siteName(locale)} width="143" height="32" class="h-8 w-auto hidden dark:block" />
      </a>

      {/* desktop nav: one bronze ink line slides between items (item 5); without JS the active item keeps a static line */}
      <nav class="hidden lg:flex relative items-center gap-3 xl:gap-5 text-sm font-medium" aria-label={t.nav.menu} data-nav>
        {
          nav.map((n) => (
            <a
              href={localePath(locale, n.path)}
              class:list={['nav-link py-2 whitespace-nowrap transition-colors', isActive(n.path) ? 'text-midnight' : 'text-ink-muted hover:text-midnight']}
              aria-current={isActive(n.path) ? 'page' : undefined}
            >
              {t.nav[n.key]}
            </a>
          ))
        }
        <span class="nav-ink" aria-hidden="true"></span>
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={localePath(other, switchPath)}
          hreflang={other}
          lang={other}
          class:list={['text-sm font-medium px-3 py-2 rounded hover:bg-porcelain', other === 'en' ? 'font-en' : 'font-ar']}
          >{t.switch_to}</a
        >
        <button
          type="button"
          class="inline-flex items-center justify-center w-10 h-10 rounded hover:bg-porcelain text-midnight"
          data-theme-toggle
          aria-label={t.theme.toggle}
          title={t.theme.toggle}
          data-label-dark={t.theme.to_dark}
          data-label-light={t.theme.to_light}
        >
          {/* moon ↔ sun (item 5): two glyphs cross-fade with a rotate/scale — transform + opacity only, so Safari lands
              on a clean final icon too (CSS cx/cy/r are not animatable there) */}
          <svg class="theme-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path class="theme-moon" fill="currentColor" d="M12.3 2.5a9.5 9.5 0 109.2 12.1 1 1 0 00-1.3-1.2 7 7 0 01-8.9-8.9 1 1 0 00-1-1.3z"></path>
            <g class="theme-sun" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4" fill="currentColor" stroke="none"></circle>
              <line x1="12" y1="1.5" x2="12" y2="3.5"></line>
              <line x1="12" y1="20.5" x2="12" y2="22.5"></line>
              <line x1="1.5" y1="12" x2="3.5" y2="12"></line>
              <line x1="20.5" y1="12" x2="22.5" y2="12"></line>
              <line x1="4.6" y1="4.6" x2="6" y2="6"></line>
              <line x1="18" y1="18" x2="19.4" y2="19.4"></line>
              <line x1="4.6" y1="19.4" x2="6" y2="18"></line>
              <line x1="18" y1="6" x2="19.4" y2="4.6"></line>
            </g>
          </svg>
        </button>
        <a
          href={localePath(locale, '/booking/')}
          class="hidden sm:inline-flex items-center whitespace-nowrap bg-bronze-deep text-white text-sm font-semibold px-4 py-2 rounded hover:bg-bronze-text transition-colors"
          >{t.nav.book}</a
        >
        <button
          type="button"
          class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded hover:bg-porcelain"
          aria-controls="mobile-nav"
          aria-expanded="false"
          data-menu-toggle
        >
          <span class="sr-only">{t.nav.menu}</span>
          <Icon name="menu" size={24} class="icon-open" />
          <Icon name="close" size={24} class="icon-close hidden" />
        </button>
      </div>
    </div>

    <nav id="mobile-nav" class="lg:hidden hidden border-t border-line bg-white" aria-label={t.nav.menu}>
      <ul class="px-5 py-2">
        {
          nav.map((n) => (
            <li>
              <a
                href={localePath(locale, n.path)}
                class:list={[
                  'block py-3 border-b border-line font-medium',
                  isActive(n.path) ? 'text-bronze' : 'text-midnight',
                ]}
                aria-current={isActive(n.path) ? 'page' : undefined}
              >
                {t.nav[n.key]}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={localePath(locale, '/partners/')}
            class:list={['block py-3 border-b border-line font-medium', partnersActive ? 'text-bronze' : 'text-midnight']}
          >
            {t.nav.partners}
          </a>
        </li>
        <li class="py-3">
          <a
            href={localePath(locale, '/booking/')}
            class="block text-center bg-bronze-deep text-white font-semibold px-4 py-3 rounded"
            >{t.nav.book}</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { bindOnce, onPageLeave, onPageLoad, reducedMotion } from '@lib/client';

  // Partners pill (23 Oct 2026): on the first page view of the session the bronze hairline draws around the pill
  // once, from the reading-start edge, after the hero entrance — two SVG strokes (top and bottom) drawn with
  // stroke-dashoffset over --motion-slow, the same token as the hero rule. Never layout properties. "Seen" lives in
  // sessionStorage; reduced motion (or no storage) → the static border only.
  const PILL_KEY = 'armada-partners-pill-drawn';
  onPageLoad(() => {
    const pill = document.querySelector<HTMLElement>('[data-partners-pill]');
    if (!pill || !bindOnce(pill)) return;
    let seen = true;
    try {
      seen = sessionStorage.getItem(PILL_KEY) === '1';
      sessionStorage.setItem(PILL_KEY, '1');
    } catch {
      seen = true;
    }
    if (seen || reducedMotion()) return;
    const svg = pill.querySelector<SVGSVGElement>('.pill-draw');
    const a = pill.querySelector<SVGPathElement>('[data-pill-a]');
    const b = pill.querySelector<SVGPathElement>('[data-pill-b]');
    if (!svg || !a || !b) return;
    const { width: w, height: h } = pill.getBoundingClientRect();
    if (!w || !h) return;
    const s = 0.5; // half the 1px stroke, so the line sits on the border
    const r = h / 2;
    const rr = r - s;
    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    // both strokes start at the start-edge middle (LTR: left; RTL mirrors the svg) and meet at the end edge
    a.setAttribute('d', `M ${s} ${r} A ${rr} ${rr} 0 0 1 ${r} ${s} L ${w - r} ${s} A ${rr} ${rr} 0 0 1 ${w - s} ${r}`);
    b.setAttribute('d', `M ${s} ${r} A ${rr} ${rr} 0 0 0 ${r} ${h - s} L ${w - r} ${h - s} A ${rr} ${rr} 0 0 0 ${w - s} ${r}`);
    pill.classList.add('is-drawing');
    a.addEventListener(
      'animationend',
      () => {
        pill.classList.remove('is-drawing');
        pill.classList.add('is-drawn');
      },
      { once: true },
    );
  });

  // nav ink: remembered across client-side navigations so it slides from the previous item to the new one
  let inkMemory: { x: string; w: string } | null = null;
  let activeNav: HTMLElement | null = null;
  onPageLeave(() => {
    const ink = document.querySelector<HTMLElement>('[data-nav] .nav-ink');
    inkMemory = ink && ink.classList.contains('is-on') ? { x: ink.style.getPropertyValue('--x'), w: ink.style.getPropertyValue('--w') } : null;
  });

  onPageLoad(() => {
    // light / dark toggle — the initial value is set on <html> by Base.astro before first paint
    const theme = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (theme && bindOnce(theme)) {
      const sync = () => {
        const dark = document.documentElement.getAttribute('data-theme') === 'dark';
        theme.setAttribute('aria-pressed', String(dark));
        theme.title = dark ? theme.dataset.labelLight || '' : theme.dataset.labelDark || '';
      };
      theme.addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('armada-theme', next);
        } catch {}
        sync();
      });
      sync();
    }
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const nav = document.getElementById('mobile-nav');
    if (btn && nav && bindOnce(btn)) {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        nav.classList.toggle('hidden', open);
        btn.querySelector('.icon-open')?.classList.toggle('hidden', !open);
        btn.querySelector('.icon-close')?.classList.toggle('hidden', open);
      });
    }

    const navEl = document.querySelector<HTMLElement>('[data-nav]');
    const ink = navEl?.querySelector<HTMLElement>('.nav-ink');
    if (navEl && ink && bindOnce(navEl)) {
      const links = Array.from(navEl.querySelectorAll<HTMLAnchorElement>('.nav-link'));
      activeNav = navEl.querySelector<HTMLElement>('.nav-link[aria-current]');
      const place = (a: HTMLElement, animate: boolean) => {
        if (!animate || reducedMotion()) ink.style.transition = 'none';
        ink.style.setProperty('--x', `${a.offsetLeft}px`);
        ink.style.setProperty('--w', String(a.offsetWidth));
        ink.classList.add('is-on');
        if (!animate || reducedMotion()) {
          void ink.offsetWidth;
          ink.style.transition = '';
        }
      };
      const rest = (animate: boolean) => (activeNav ? place(activeNav, animate) : ink.classList.remove('is-on'));
      if (inkMemory) {
        ink.style.transition = 'none';
        ink.style.setProperty('--x', inkMemory.x);
        ink.style.setProperty('--w', inkMemory.w);
        ink.classList.add('is-on');
        void ink.offsetWidth;
        ink.style.transition = '';
        rest(true);
      } else rest(false);
      links.forEach((a) => a.addEventListener('mouseenter', () => place(a, true)));
      navEl.addEventListener('mouseleave', () => rest(true));
      navEl.addEventListener('focusin', (e) => place(e.target as HTMLElement, true));
      navEl.addEventListener('focusout', () => rest(true));
      document.fonts.ready.then(() => rest(false));
      let raf = 0;
      // per page: aborted on the next swap so resize listeners do not pile up across client-side navigations
      const ac = new AbortController();
      document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
      window.addEventListener(
        'resize',
        () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => rest(false));
        },
        { signal: ac.signal },
      );
    }
  });
</script>
