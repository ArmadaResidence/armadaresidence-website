---
/**
 * «راسلنا على واتساب» of a «باقات بسعر خاص» offer (18 Nov 2026): the site's WhatsApp branch chooser limited to the
 * offer's branches — one branch opens its number at once, several open a small chooser (the same look and behaviour as
 * the sticky button's: Esc, a press that starts and ends outside, focus back to the button). Every link carries the
 * offer's prefilled message; numbers come from content/contact.json (offers-data.ts → offerWhatsApp), never from the
 * offer. dataLayer: offer_click { cta: 'whatsapp' } on the button (src/lib/offers.ts) and whatsapp_click on each link.
 */
import Icon from './Icon.astro';
import type { Locale } from '@lib/content';
import { offersText, offerWhatsApp, type Offer } from '@lib/offers-data';

interface Props {
  locale: Locale;
  offer: Offer;
  /** where the card sits (keeps the panel's id unique on a page) */
  placement: string;
  /** a full-width button (the phone layout of the packages card) */
  block?: boolean;
}
const { locale, offer: o, placement, block = false } = Astro.props;
const t = offersText(locale);
const dests = offerWhatsApp(locale, o);
const panelId = `offer-wa-${o.slug}-${placement}`;
const btnClass = [
  'inline-flex items-center justify-center gap-2 bg-bronze-deep text-white! font-semibold px-5 py-3 rounded hover:bg-bronze-text transition-colors',
  block ? 'w-full sm:w-auto' : '',
].join(' ');
---

{
  dests.length === 1 ? (
    <a href={dests[0].href} class={btnClass} rel="noopener" target="_blank" data-offer-cta="whatsapp" data-wa-link data-wa-destination={dests[0].branch}>
      <Icon name="whatsapp" size={18} />
      <span>{t.whatsapp_us}</span>
    </a>
  ) : (
    dests.length > 1 && (
      <div class:list={['relative inline-block', block ? 'w-full sm:w-auto' : '']} data-offer-wa>
        <button type="button" class={btnClass} aria-expanded="false" aria-haspopup="dialog" aria-controls={panelId} data-offer-cta="whatsapp" data-offer-wa-toggle>
          <Icon name="whatsapp" size={18} />
          <span>{t.whatsapp_us}</span>
        </button>
        <div
          id={panelId}
          class="hidden absolute z-20 bottom-full mb-2 start-0 bg-white rounded-card shadow-xl border border-line p-3 w-80 max-w-[calc(100vw-2.5rem)]"
          role="dialog"
          aria-modal="false"
          aria-label={t.whatsapp_choose}
          data-offer-wa-panel
        >
          <p class="text-xs text-ink-muted mb-2">{t.whatsapp_choose}</p>
          <ul class="space-y-2">
            {dests.map((d) => (
              <li>
                <a
                  href={d.href}
                  class="flex items-center justify-between gap-2 rounded px-3 py-2 bg-porcelain text-ink hover:bg-bronze hover:text-white transition-colors"
                  rel="noopener"
                  target="_blank"
                  data-wa-link
                  data-wa-destination={d.branch}
                >
                  <span class="text-sm font-medium">{d.label}</span>
                  <span class="latin text-xs whitespace-nowrap" dir="ltr">
                    {d.phone}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  )
}
