---
/**
 * The «نادي أرمادا ريزيدنس» / Armada Residence Club form (Ahmed, 3 Nov 2026 — DECISIONS.md 2026-11-03 «Phase 2b
 * session 5»): the mobile number (required; the shared PhoneField, Saudi Arabia by default), the name and the email
 * (optional), the ONE marketing consent (club.json → consent, required to join here) with «كيف نستخدم بياناتك» to the
 * privacy section, a honeypot `website`. Rules: rules.ts → validateClubJoin (the club function runs the same).
 * The page language is stored; ?src= (a QR code: breakfast-airport, breakfast-shafa…) and the UTM values of the URL
 * travel with the sign-up. Inline errors on blur and submit with
 * aria-invalid / aria-describedby, focus to the first invalid field, the button disabled with a spinner while sending;
 * success replaces the form (the same message for a number already registered) with «تابعنا على حساباتنا»; dataLayer
 * `club_join` { source } only. Nothing is kept in the browser.
 */
import Icon from './Icon.astro';
import PhoneField from './PhoneField.astro';
import { clubFollowUrl, clubPrivacyHref, clubText, marketingConsent, type Locale } from '@lib/content';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className = '' } = Astro.props;
const c = clubText(locale);
const bookingEndpoint = import.meta.env.PUBLIC_BOOKING_ENDPOINT ?? '';
const endpoint = (() => {
  try {
    return bookingEndpoint ? `${new URL(bookingEndpoint).origin}/functions/v1/club` : '';
  } catch {
    return '';
  }
})();
const clientData = {
  endpoint,
  anonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '',
  locale,
  consentVersion: marketingConsent.version,
  strings: { phone: c.error_phone, consent: c.error_consent, email: c.error_email, network: c.error_network, sending: c.sending, submit: c.submit },
};
---

<div class:list={['bg-white border border-line rounded-card p-5 sm:p-6', className]} data-club-root>
  <form class="grid gap-4" novalidate data-club-form aria-label={c.title}>
    <PhoneField locale={locale} variant="booking" id="club-phone" name="phone" countryName="country" label={c.phone} errorId="club-phone-error" class="!col-span-1" />
    <div>
      <label for="club-name" class="block text-sm font-semibold text-midnight mb-2">{c.name}</label>
      <input id="club-name" name="name" type="text" autocomplete="name" maxlength="80" class="w-full h-12 px-3 border border-line rounded bg-white text-midnight" />
    </div>
    <div>
      <label for="club-email" class="block text-sm font-semibold text-midnight mb-2">{c.email}</label>
      <input id="club-email" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" maxlength="254" dir="ltr" class="w-full h-12 px-3 border border-line rounded bg-white latin text-left text-midnight" aria-describedby="club-email-error" />
      <p id="club-email-error" class="field-error hidden" data-error-for="email"></p>
    </div>
    <div>
      <label class="flex items-start gap-3 text-sm leading-relaxed text-ink">
        <input type="checkbox" name="consent" value="yes" class="mt-1 size-5 accent-bronze-deep shrink-0" aria-describedby="club-consent-error" required data-club-consent />
        <span>{locale === 'ar' ? marketingConsent.ar : marketingConsent.en}</span>
      </label>
      <p id="club-consent-error" class="field-error hidden" data-error-for="consent"></p>
      <a href={clubPrivacyHref(locale)} class="link-bronze inline-block mt-2 ms-8 text-sm underline underline-offset-2">{c.privacy_link}</a>
    </div>
    {/* honeypot: hidden from people and assistive tech; a filled value is dropped by the function */}
    <div class="hidden" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <p class="field-error hidden" role="alert" data-club-summary></p>
    <button type="submit" class="inline-flex items-center justify-center gap-2 w-full sm:w-auto bg-bronze-deep text-white font-semibold px-6 py-3 rounded hover:bg-bronze-text transition-colors disabled:opacity-60" data-club-submit>
      <span class="spinner hidden" aria-hidden="true" data-spinner></span>
      <span data-label>{c.submit}</span>
    </button>
    <script type="application/json" data-club-data set:html={JSON.stringify(clientData).replace(/</g, '\\u003c')} />
  </form>
  <div class="hidden" role="status" tabindex="-1" data-club-done>
    <Icon name="check" size={28} class="text-bronze" />
    <p class="mt-3 text-lg font-semibold text-midnight leading-relaxed">{c.success}</p>
    <a
      href={clubFollowUrl}
      target="_blank"
      rel="noopener"
      class="mt-5 inline-flex items-center justify-center gap-2 border border-bronze-deep text-midnight font-semibold px-5 py-3 rounded hover:bg-porcelain transition-colors"
      data-club-follow
    >
      <span>{c.follow}</span>
      <span class="sr-only">{c.new_tab}</span>
    </a>
  </div>
</div>

<script>
  import { bindOnce, onPageLoad } from '@lib/client';
  import { loadPhoneLib, phoneToE164 } from '@lib/phone';
  import { initCountrySelect } from '@lib/country-select';
  import { firstTouch } from '@lib/visit';
  import { cleanUtm, clubSource, validateClubJoin, type ClubField } from '../../supabase/functions/booking-request/rules.ts';

  type Data = { endpoint: string; anonKey: string; locale: 'ar' | 'en'; consentVersion: string; strings: Record<string, string> };

  function init(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-club-form]');
    const raw = root.querySelector<HTMLScriptElement>('[data-club-data]');
    if (!form || !raw || !bindOnce(form)) return;
    const data = JSON.parse(raw.textContent || '{}') as Data;
    const ac = new AbortController();
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    const select = initCountrySelect(form.querySelector<HTMLElement>('[data-phone-group]')!, { signal: ac.signal });
    form.addEventListener('focusin', () => void loadPhoneLib(), { once: true });
    const phone = form.elements.namedItem('phone') as HTMLInputElement;
    const name = form.elements.namedItem('name') as HTMLInputElement;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const consent = form.elements.namedItem('consent') as HTMLInputElement;
    const honey = form.elements.namedItem('website') as HTMLInputElement;
    const summary = form.querySelector<HTMLElement>('[data-club-summary]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-club-submit]')!;
    const done = root.querySelector<HTMLElement>('[data-club-done]')!;
    const inputs: Record<ClubField, HTMLInputElement> = { phone, email, consent };
    const message: Record<ClubField, string> = { phone: data.strings.phone, email: data.strings.email, consent: data.strings.consent };

    const show = (field: ClubField, on: boolean) => {
      const input = inputs[field];
      const err = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      input.setAttribute('aria-invalid', on ? 'true' : 'false');
      if (err) {
        err.textContent = on ? message[field] : '';
        err.classList.toggle('hidden', !on);
      }
    };
    const errorsOf = () =>
      validateClubJoin(
        { phone: phone.value, country: select?.value() || 'SA', name: name.value, email: email.value, consent: consent.checked },
        { phone: (r: string, cc: string) => phoneToE164(r, cc) },
      );
    const check = (only?: ClubField): ClubField[] => {
      const v = errorsOf();
      const bad = v.ok ? [] : (Object.keys(v.errors) as ClubField[]);
      (only ? [only] : (['phone', 'email', 'consent'] as ClubField[])).forEach((k) => show(k, bad.includes(k)));
      return (['phone', 'email', 'consent'] as ClubField[]).filter((k) => bad.includes(k) && (!only || k === only));
    };
    // an error shows on blur (once something was typed) and clears while typing as soon as the value is right — never
    // on the blur of a press on the button, where hiding a line would move the button away before the click lands
    const showIfBad = (k: ClubField) => {
      const v = errorsOf();
      if (!v.ok && v.errors[k]) show(k, true);
    };
    // the phone is judged only once libphonenumber is there (before it, a national number like 05… cannot pass the
    // shape-only check — on a slow connection that showed a false error and moved the form under the finger)
    phone.addEventListener('blur', async () => {
      if (!phone.value.trim()) return;
      await loadPhoneLib();
      showIfBad('phone');
    });
    email.addEventListener('blur', () => email.value.trim() && showIfBad('email'));
    for (const k of ['phone', 'email'] as const) {
      inputs[k].addEventListener('input', async () => {
        if (inputs[k].getAttribute('aria-invalid') !== 'true') return;
        if (k === 'phone') await loadPhoneLib();
        check(k);
      });
    }
    consent.addEventListener('change', () => check('consent'));

    const busy = (on: boolean) => {
      button.disabled = on;
      button.querySelector('[data-spinner]')?.classList.toggle('hidden', !on);
      button.querySelector('[data-label]')!.textContent = on ? data.strings.sending : data.strings.submit;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      summary.classList.add('hidden');
      await loadPhoneLib();
      const bad = check();
      if (bad.length) {
        inputs[bad[0]].focus();
        return;
      }
      const params = new URLSearchParams(location.search);
      const src = clubSource(params.get('src'));
      const here = cleanUtm({ source: params.get('utm_source'), medium: params.get('utm_medium'), campaign: params.get('utm_campaign'), content: params.get('utm_content') });
      const touch = firstTouch();
      const utm = Object.keys(here).length ? here : cleanUtm({ source: touch?.utm_source, medium: touch?.utm_medium, campaign: touch?.utm_campaign, content: touch?.utm_content });
      const v = errorsOf();
      if (!v.ok) return;
      busy(true);
      try {
        if (!data.endpoint) throw new Error('no endpoint');
        const headers: Record<string, string> = { 'Content-Type': 'application/json' };
        if (data.anonKey) {
          headers['Authorization'] = `Bearer ${data.anonKey}`;
          headers['apikey'] = data.anonKey;
        }
        const res = await fetch(data.endpoint, {
          method: 'POST',
          headers,
          body: JSON.stringify({
            action: 'join',
            phone: v.data.phone,
            country: select?.value() || 'SA',
            name: v.data.name,
            email: v.data.email,
            consent: true,
            consent_version: data.consentVersion,
            lang: data.locale,
            src,
            utm,
            website: honey.value,
          }),
        });
        if (res.status === 422) {
          const j = (await res.json().catch(() => ({}))) as { fields?: Partial<Record<ClubField, string>> };
          const fields = (['phone', 'email', 'consent'] as ClubField[]).filter((k) => j.fields?.[k]);
          if (fields.length) {
            fields.forEach((k) => show(k, true));
            inputs[fields[0]].focus();
            return;
          }
          throw new Error('invalid');
        }
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        select?.reset();
        form.hidden = true;
        done.classList.remove('hidden');
        done.focus();
        (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push({ event: 'club_join', source: src || 'site' });
      } catch {
        summary.textContent = data.strings.network;
        summary.classList.remove('hidden');
      } finally {
        busy(false);
      }
    });
  }

  onPageLoad(() => document.querySelectorAll<HTMLElement>('[data-club-root]').forEach(init));
</script>
