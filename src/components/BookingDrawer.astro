---
/**
 * Booking drawer (item 11, 11 Oct 2026): the same booking-request form as /booking/ inside a native <dialog>.
 * Every link to /booking/ (header button, hero, room and branch CTAs, bottom bar) opens it prefilled from the
 * link's ?branch=&room=; the links keep working as links (no JS, middle-click, /booking/ itself). Slides in from
 * the inline-end side on desktop, rises as a full-height sheet on phones; Esc, the close button and a click on
 * the backdrop close it; <dialog> handles the focus trap and returns focus to the opener.
 */
import BookingForm from './BookingForm.astro';
import Icon from './Icon.astro';
import { ui, type Locale } from '@lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
---

<dialog class="drawer" data-booking-drawer aria-labelledby="drawer-heading">
  <div class="drawer-panel">
    <div class="drawer-head flex items-start justify-between gap-4">
      <div>
        <h2 id="drawer-heading" class="text-2xl font-bold text-midnight">{t.form.heading}</h2>
        <p class="mt-1 text-sm text-ink-muted">{t.form.intro}</p>
      </div>
      <button type="button" class="drawer-close shrink-0 inline-flex items-center justify-center w-10 h-10 rounded hover:bg-porcelain text-midnight" data-drawer-close aria-label={t.nav.close}>
        <Icon name="close" size={22} />
      </button>
    </div>
    <BookingForm locale={locale} prefix="drawer-" class="mt-6" />
  </div>
</dialog>
