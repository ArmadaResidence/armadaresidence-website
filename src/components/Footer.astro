---
import {
  bookingPath,
  branchContact,
  branchPath,
  branches,
  contact,
  footerLine,
  L,
  localePath,
  mailHref,
  offersPageLive,
  otherLocale,
  siteName,
  siteTexts,
  telHref,
  ui,
  type BookingContext,
  type Locale,
} from '@lib/content';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  switchPath: string;
  /** branch / room pages: the booking link prefills that branch (and room) — Ahmed, 24 Oct 2026 */
  booking?: BookingContext;
}
const { locale, switchPath, booking } = Astro.props;
const t = ui(locale);
const other = otherLocale(locale);
const slogan = locale === 'ar' ? siteTexts.slogan_ar : siteTexts.slogan_en;

const siteLinks: { key: keyof typeof t.nav; path: string }[] = [
  // «من نحن» (6 Nov 2026)
  { key: 'about', path: '/about/' },
  { key: 'discover-taif', path: '/discover-taif/' },
  { key: 'blog', path: '/blog/' },
  ...(offersPageLive ? [{ key: 'offers' as const, path: '/offers/' }] : []),
  { key: 'partners', path: '/partners/' },
  { key: 'contact', path: '/contact/' },
  { key: 'faq', path: '/faq/' },
  { key: 'careers', path: '/careers/' },
  // «إياب» (3 Nov 2026)
  { key: 'club', path: '/club/' },
  { key: 'policies', path: '/policies/' },
  { key: 'book', path: '/booking/' },
];

// «تابعنا» (7 Nov 2026): one row above the legal line, only the networks whose account link exists in contact.json
const social: { name: string; url: string }[] = [
  { name: 'Instagram', url: contact.social.instagram },
  { name: 'Facebook', url: contact.social.facebook },
  { name: 'TikTok', url: contact.social.tiktok },
  { name: 'Snapchat', url: contact.social.snapchat },
  { name: 'YouTube', url: contact.social.youtube },
].filter((s) => typeof s.url === 'string' && /^https:\/\//.test(s.url));
---

<footer class="cv-auto relative bg-midnight text-porcelain mt-16 overflow-hidden" data-glow>
  {/* brand pattern: 108px tile, bronze at 7 %, fixed so it does not visibly repeat (Ahmed, 9 Oct 2026) */}
  <div class="absolute inset-0 pattern-bg" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-5 py-12 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-1">
      {/* porcelain logo on midnight at 56 px; stacked lockup → clear space X ≈ 15px, kept by the p-5 wrapper */}
      <div class="p-5 -m-5 inline-block">
        {/* lazy (9 Nov 2026, mobile LCP): the footer is never in the first view, so its logo is not fetched before the paint */}
        <img src="/brand/logo-stacked_Porcelain.svg" alt={siteName(locale)} width="88" height="56" class="h-14 w-auto" loading="lazy" decoding="async" />
      </div>
      <p class="mt-6 text-sm text-porcelain/80">{slogan}</p>
      <p class="mt-4 text-sm text-porcelain/80 flex items-center gap-2">
        <Icon name="clock" size={16} />
        <span>{locale === 'ar' ? contact.working_hours_ar : contact.working_hours_en}</span>
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-bronze mb-3">{t.footer.branches}</h2>
      <ul class="space-y-3 text-sm">
        {
          branches.map((b) => {
            const c = branchContact(b.slug);
            return (
              <li>
                <a href={branchPath(locale, b.slug)} class="inline-block py-1 font-medium hover:text-bronze">
                  {L(locale, b, 'name')}
                </a>
                <br />
                <a href={telHref(c.phone)} class="latin inline-block py-1 text-porcelain/80 hover:text-bronze" dir="ltr">
                  {c.phone_display}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-bronze mb-3">{t.footer.site}</h2>
      <ul class="space-y-2 text-sm">
        {
          siteLinks.map((n) => (
            <li>
              <a href={n.key === 'book' ? bookingPath(locale, booking) : localePath(locale, n.path)} class="inline-block py-0.5 hover:text-bronze">
                {t.nav[n.key]}
              </a>
            </li>
          ))
        }
        <li>
          <a href={localePath(other, switchPath)} hreflang={other} lang={other} class="hover:text-bronze">
            {t.switch_to}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-bronze mb-3">{t.footer.contact}</h2>
      <ul class="space-y-2 text-sm">
        <li>
          <a href={mailHref(contact.emails.reservations)} class="latin hover:text-bronze" dir="ltr">
            {contact.emails.reservations}
          </a>
        </li>
        <li>
          <a href={mailHref(contact.emails.info)} class="latin hover:text-bronze" dir="ltr">
            {contact.emails.info}
          </a>
        </li>
        <li>
          <a href={localePath(locale, contact.menu_url)} class="hover:text-bronze" rel="noopener">{t.cta.menu_link}</a>
        </li>
      </ul>
    </div>
  </div>
  {
    social.length > 0 && (
      <div class="relative border-t border-porcelain/15" data-footer-social>
        <div class="mx-auto max-w-6xl px-5 py-5 flex flex-wrap items-center gap-x-6 gap-y-2">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-bronze">{t.contact.social_heading}</h2>
          <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
            {social.map((s) => (
              <li>
                <a href={s.url} class="latin inline-block py-1.5 hover:text-bronze" rel="noopener">
                  {s.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }
  <div class="relative border-t border-porcelain/15">
    <div class="mx-auto max-w-6xl px-5 py-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <p class="text-xs text-porcelain/70">{footerLine(locale)}</p>
      {/* reopens the cookie banner on its customize view (7 Nov 2026; src/lib/consent.ts) */}
      <button type="button" class="text-xs text-porcelain/80 underline underline-offset-2 py-2 hover:text-bronze" data-cookie-settings>{t.cookies.settings}</button>
    </div>
  </div>
</footer>
