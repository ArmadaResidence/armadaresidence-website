---
/**
 * «اكتشف الطائف» on the home page (7 Nov 2026): the first three places of the Discover Taif guide in its order (the
 * dashboard's place order — taif-guide.json, media_catalog), each with its photo (the cover published in «الصور», else
 * the guide's own), its category, name and short line, linking to the place on /discover-taif/; «كل الأماكن».
 */
import Photo from '../Photo.astro';
import SectionHead from './SectionHead.astro';
import { categoryLabel, L, localePath, placeImage, taifPlaces, ui, type Locale } from '@lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale).home;
const list = taifPlaces.slice(0, 3);
const guide = localePath(locale, '/discover-taif/');
---

{
  list.length > 0 && (
    <section class="cv-auto mx-auto max-w-6xl px-4 py-16" aria-labelledby="home-places-heading" data-home-section="places">
      <SectionHead id="home-places-heading" heading={t.places_heading} link={{ href: guide, label: t.places_all, attr: 'places' }} />
      <ul class="reveal-group mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {list.map((p) => {
          const img = placeImage(locale, p);
          return (
            <li class="flex">
              <a href={`${guide}#place-${p.key}`} class="home-place group w-full bg-white border border-line rounded-card overflow-hidden flex flex-col" data-home-place={p.key}>
                <Photo src={img.src} srcset={img.srcset} sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw" alt={img.alt} width={img.width} height={img.height} class="block aspect-[3/2]" imgClass="home-room-img w-full h-full object-cover" />
                <span class="p-5 flex flex-col gap-1.5">
                  <span class="text-xs font-semibold text-bronze-text">{categoryLabel(locale, p.category)}</span>
                  <span class="text-lg font-semibold text-midnight group-hover:text-bronze-text">{L(locale, p, 'name')}</span>
                  <span class="text-sm text-ink-muted leading-relaxed">{L(locale, p, 'description')}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
