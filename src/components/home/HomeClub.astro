---
/**
 * The «إياب» band above the footer (Ahmed's design, 7 Nov 2026; replaces the slim link band of 3 Nov 2026): eyebrow
 * «مجانًا · برقم جوالك», the name with its descriptor (club.json title), the approved intro line (club.json subtitle),
 * two benefits (no promo codes, no "first to know") and «انضم إلى إياب» → /club/. On midnight with the brand pattern.
 */
import Icon from '../Icon.astro';
import { clubText, localePath, ui, type Locale } from '@lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale).home as unknown as Record<string, string> & { club_benefits: string[] };
const c = clubText(locale);
---

<section class="cv-auto mx-auto max-w-6xl px-4" aria-labelledby="home-club-heading" data-home-section="club">
 <div class="relative overflow-hidden rounded-card bg-midnight text-porcelain" data-glow>
  <div class="absolute inset-0 pattern-bg" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>
  <div class="relative px-6 md:px-12 py-12 grid gap-8 lg:grid-cols-5 lg:items-center">
    <div class="lg:col-span-3">
      <p class="reveal text-sm font-semibold text-bronze-bright mb-3">{t.club_eyebrow}</p>
      <h2 id="home-club-heading" class="reveal text-2xl md:text-3xl font-bold">{c.title}</h2>
      <p class="reveal mt-4 text-porcelain/85 leading-relaxed max-w-2xl" style="--reveal-delay:60ms">{c.subtitle}</p>
    </div>
    <div class="reveal lg:col-span-2 flex flex-col gap-5" style="--reveal-delay:120ms">
      <ul class="grid gap-2.5">
        {
          t.club_benefits.map((b) => (
            <li class="flex items-center gap-2.5">
              <span class="shrink-0 w-7 h-7 rounded-full bg-porcelain/10 text-bronze-bright grid place-items-center">
                <Icon name="check" size={16} />
              </span>
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
      <a href={localePath(locale, '/club/')} class="self-start inline-flex items-center gap-2 bg-bronze-deep text-white font-semibold px-6 py-3 rounded hover:bg-bronze-text transition-colors" data-club-band>
        <span>{c.submit}</span>
        <Icon name="arrow" size={18} class="icon-arrow rtl:rotate-180" />
      </a>
    </div>
  </div>
 </div>
</section>
