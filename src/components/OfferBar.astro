---
/**
 * Announcement bar (2 Nov 2026, «العروض»; one system since 3 Nov 2026 — «المحتوى والظهور» → «شريط الإعلان»): today's
 * published announcement at the very top of every site page (above the sticky header — Bronze Deep under white text,
 * 4.5:1 — in the page flow — the booking drawer, a modal <dialog>, always covers it). A featured offer shows as before:
 * its title + «التفاصيل» (to its card on /offers/ while that page is shown, else the offer's own link); a custom
 * announcement shows its text and, when it has one, its link with its label (a site path follows the page language).
 * × hides it for this visitor (localStorage `armada-offer-bar` = the offer's slug or the announcement's id: a newer one
 * shows again). The head script of Base.astro applies a stored dismissal — and the last day, in case it passed after
 * this build — before the first paint (html[data-offer-bar-off]), so nothing shifts. Renders nothing without a bar.
 */
import Icon from './Icon.astro';
import type { Locale } from '@lib/content';
import { offerAnchor, offerCta, offersText, offerTitle, siteBar } from '@lib/offers-data';
import { localePath, offersPageLive } from '@lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bar = siteBar;
const t = offersText(locale);
const o = bar?.kind === 'offer' ? bar.offer : null;
const offerHref = o ? (offersPageLive && o.show_offers && o.category !== 'dining' ? `${localePath(locale, '/offers/')}#${offerAnchor(o)}` : offerCta(locale, o)?.href ?? null) : null;
const custom = bar?.kind === 'custom' ? bar : null;
const customHref = custom?.link ? (custom.link.startsWith('/') && locale === 'en' && !custom.link.startsWith('/en/') ? `/en${custom.link}` : custom.link) : null;
const external = !!customHref && customHref.startsWith('https://');
---

{
  bar && (
    <div
      class="offer-bar bg-bronze-deep text-white"
      role="region"
      aria-label={t.bar_label}
      data-offer-bar={bar.id}
      data-bar-kind={bar.kind}
      data-offer-category={o ? o.category : undefined}
    >
      <div class="mx-auto max-w-6xl px-4 py-1.5 flex items-center gap-3 text-sm">
        <p class="flex-1 min-w-0 py-1">
          <span class="font-semibold">{o ? offerTitle(locale, o) : locale === 'en' ? custom!.text_en : custom!.text_ar}</span>
          {o && offerHref && (
            <a href={offerHref} class="ms-2 font-semibold underline underline-offset-2 hover:no-underline" data-offer-bar-link>
              {t.bar_details}
            </a>
          )}
          {custom && customHref && (
            <a href={customHref} class="ms-2 font-semibold underline underline-offset-2 hover:no-underline" data-offer-bar-link {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
              {locale === 'en' ? custom.link_label_en : custom.link_label_ar}
            </a>
          )}
        </p>
        <button type="button" class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded hover:bg-white/10" aria-label={t.bar_dismiss} data-offer-bar-close>
          <Icon name="close" size={18} />
        </button>
      </div>
    </div>
  )
}

<script>
  import { bindOnce, onPageLoad } from '@lib/client';

  const KEY = 'armada-offer-bar';
  onPageLoad(() => {
    const bar = document.querySelector<HTMLElement>('[data-offer-bar]');
    if (!bar || !bindOnce(bar)) return;
    const slug = bar.dataset.offerBar || '';
    const custom = bar.dataset.barKind === 'custom';
    const push = (event: 'view' | 'click') => {
      const w = window as unknown as { dataLayer?: unknown[] };
      w.dataLayer = w.dataLayer || [];
      // a featured offer keeps the offers' events; a custom announcement has its own (its id only)
      if (custom) w.dataLayer.push({ event: `announcement_${event}`, announcement_id: slug });
      else w.dataLayer.push({ event: `offer_${event}`, offer_id: slug, category: bar.dataset.offerCategory, placement: 'bar', ...(event === 'click' ? { cta: 'details' } : {}) });
    };
    if (!document.documentElement.hasAttribute('data-offer-bar-off')) push('view');
    bar.querySelector('[data-offer-bar-link]')?.addEventListener('click', () => push('click'));
    bar.querySelector('[data-offer-bar-close]')?.addEventListener('click', () => {
      try {
        localStorage.setItem(KEY, slug);
      } catch {
        /* storage unavailable: hidden for this page only */
      }
      document.documentElement.setAttribute('data-offer-bar-off', '');
      // focus stays in the page: the skip link's target
      const main = document.getElementById('main');
      if (main) {
        main.setAttribute('tabindex', '-1');
        main.focus({ preventScroll: true });
      }
    });
  });
</script>
