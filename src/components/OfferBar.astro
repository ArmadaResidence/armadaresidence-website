---
/**
 * Announcement bar (2 Nov 2026, «العروض»): the one live offer with «شريط الإعلان», at the very top of every site page
 * (above the sticky header — Bronze Deep under white text, 4.5:1 — in the page flow — the booking drawer, a modal <dialog>, always covers it). Title + «التفاصيل»;
 * × hides it for this visitor (localStorage `armada-offer-bar` = the offer's slug: a newer bar offer shows again). The
 * head script of Base.astro applies a stored dismissal — and the end date, in case the offer ended after this build —
 * before the first paint (html[data-offer-bar-off]), so nothing shifts. Renders nothing without a bar offer.
 */
import Icon from './Icon.astro';
import type { Locale } from '@lib/content';
import { barOffer, offerAnchor, offerCta, offersText, offerTitle } from '@lib/offers-data';
import { localePath } from '@lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const o = barOffer;
const t = offersText(locale);
const href = o && (o.show_offers && o.category !== 'dining' ? `${localePath(locale, '/offers/')}#${offerAnchor(o)}` : offerCta(locale, o)?.href ?? `${localePath(locale, '/offers/')}`);
---

{
  o && (
    <div class="offer-bar bg-bronze-deep text-white" role="region" aria-label={t.bar_label} data-offer-bar={o.slug} data-offer-category={o.category}>
      <div class="mx-auto max-w-6xl px-4 py-1.5 flex items-center gap-3 text-sm">
        <p class="flex-1 min-w-0 py-1">
          <span class="font-semibold">{offerTitle(locale, o)}</span>
          <a href={href} class="ms-2 font-semibold underline underline-offset-2 hover:no-underline" data-offer-bar-link>
            {t.bar_details}
          </a>
        </p>
        <button type="button" class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded hover:bg-white/10" aria-label={t.bar_dismiss} data-offer-bar-close>
          <Icon name="close" size={18} />
        </button>
      </div>
    </div>
  )
}

<script>
  import { bindOnce, onPageLoad } from '@lib/client';

  const KEY = 'armada-offer-bar';
  onPageLoad(() => {
    const bar = document.querySelector<HTMLElement>('[data-offer-bar]');
    if (!bar || !bindOnce(bar)) return;
    const slug = bar.dataset.offerBar || '';
    const push = (event: string) => {
      const w = window as unknown as { dataLayer?: unknown[] };
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ event, offer_id: slug, category: bar.dataset.offerCategory, placement: 'bar', ...(event === 'offer_click' ? { cta: 'details' } : {}) });
    };
    if (!document.documentElement.hasAttribute('data-offer-bar-off')) push('offer_view');
    bar.querySelector('[data-offer-bar-link]')?.addEventListener('click', () => push('offer_click'));
    bar.querySelector('[data-offer-bar-close]')?.addEventListener('click', () => {
      try {
        localStorage.setItem(KEY, slug);
      } catch {
        /* storage unavailable: hidden for this page only */
      }
      document.documentElement.setAttribute('data-offer-bar-off', '');
      // focus stays in the page: the skip link's target
      const main = document.getElementById('main');
      if (main) {
        main.setAttribute('tabindex', '-1');
        main.focus({ preventScroll: true });
      }
    });
  });
</script>
