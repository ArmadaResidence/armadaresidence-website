---
/**
 * /blog/ and /en/blog/ (12 Oct 2026): published articles of the page language, newest first, with a tag filter.
 * Without JS every card shows and the filter bar stays hidden; with JS the chips filter in place and the choice is
 * kept in ?tag= (shareable, restored on load and after view-transition navigations).
 */
import Base from '@layouts/Base.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { langPaths } from '@lib/paths';
import { articlePath, articles, publishedSlugs } from '@lib/articles';
import { fill, localePath, pageSeo, ui, type Locale } from '@lib/content';
import { blog, breadcrumbs } from '@lib/jsonld';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const b = t.blog;
const s = pageSeo(locale, 'blog');
const both = new Set(await publishedSlugs());
const list = (await articles(locale)).filter((a) => both.has(a.slug));

// tags in order of frequency, then first appearance
const counts = new Map<string, number>();
for (const a of list) for (const tag of a.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts.keys()].sort((x, y) => (counts.get(y) ?? 0) - (counts.get(x) ?? 0));

const countText = (n: number) => (n === 1 ? b.count_one : n === 2 ? b.count_two : fill(b.count, { n }));
const labels = { count: b.count, one: b.count_one, two: b.count_two };

const jsonld = [
  blog(
    locale,
    s.title,
    s.description,
    list.map((a) => ({ url: articlePath(locale, a.slug), headline: a.title, datePublished: a.date })),
  ),
  breadcrumbs([
    { name: t.nav.home, path: localePath(locale, '/') },
    { name: b.heading, path: localePath(locale, '/blog/') },
  ]),
];
---

<Base locale={locale} path="/blog/" title={s.title} description={s.description} jsonld={jsonld}>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-14">
    <h1 class="text-3xl md:text-4xl font-bold text-midnight">{b.heading}</h1>
    <p class="mt-3 max-w-[60ch] text-ink-muted leading-relaxed">{b.intro}</p>

    <div class="blog-filter mt-8" data-blog-filter data-labels={JSON.stringify(labels)}>
      <p id="blog-filter-label" class="sr-only">{b.filter_label}</p>
      <div class="flex flex-wrap gap-2" role="group" aria-labelledby="blog-filter-label">
        <button type="button" class="tag-chip" data-tag="" aria-pressed="true">{b.all}</button>
        {
          tags.map((tag) => (
            <button type="button" class="tag-chip" data-tag={tag} aria-pressed="false">
              {tag}
            </button>
          ))
        }
      </div>
      <p class="mt-4 text-sm text-ink-muted" role="status" aria-live="polite" data-blog-count>{countText(list.length)}</p>
    </div>

    <div class="reveal-group mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-blog-list>
      {list.map((a) => <ArticleCard locale={locale} article={a} filterable />)}
    </div>
    <p class="hidden mt-6 text-ink-muted" data-blog-empty>{b.empty}</p>
  </section>
</Base>

<script>
  import { bindOnce, onPageLoad } from '@lib/client';

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-blog-filter]');
    if (!root || !bindOnce(root)) return;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-blog-list] > [data-tags]')];
    const count = root.querySelector<HTMLElement>('[data-blog-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
    const labels = JSON.parse(root.dataset.labels || '{}') as { count: string; one: string; two: string };
    const countText = (n: number) => (n === 1 ? labels.one : n === 2 ? labels.two : labels.count.replace('{n}', String(n)));

    const apply = (tag: string, push: boolean) => {
      if (tag && !chips.some((c) => c.dataset.tag === tag)) tag = '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tag === tag)));
      let n = 0;
      for (const card of cards) {
        const show = !tag || (JSON.parse(card.dataset.tags || '[]') as string[]).includes(tag);
        card.hidden = !show;
        if (show) n++;
      }
      count.textContent = countText(n);
      empty?.classList.toggle('hidden', n > 0);
      if (push) {
        const url = new URL(location.href);
        if (tag) url.searchParams.set('tag', tag);
        else url.searchParams.delete('tag');
        history.replaceState(history.state, '', url);
      }
    };

    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.tag || '', true)));
    root.classList.add('is-ready');
    apply(new URLSearchParams(location.search).get('tag') || '', false);
  });
</script>
