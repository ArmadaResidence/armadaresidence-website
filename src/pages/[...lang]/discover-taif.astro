---
/**
 * /discover-taif/ — the legacy "Discover Taif" guide kept as designed (markup, CSS, interactions),
 * scoped under .legacy-discover (src/styles/legacy-discover.css, generated by scripts/legacy-css.py).
 * Only the site header/footer, the SVG brand assets, the facts (content/taif-guide.json) and internal links differ.
 */
import '../../styles/legacy-discover.css';
import '../../styles/legacy-overrides.css';
import Base from '@layouts/Base.astro';
import { langPaths } from '@lib/paths';
import { branchBySlug, branchPath, L, localePath, pageSeo, taif, ui, type Locale } from '@lib/content';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ar = locale === 'ar';
const t = ui(locale);
const s = pageSeo(locale, 'discover-taif');
const places = taif.places;
const hero = taif.hero;
const tx = (a: string, e: string) => (ar ? a : e);

const ICON = {
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>',
  plus: '<svg class="icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>',
  check: '<svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7"/></svg>',
  share: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="18" cy="5.5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="18.5" r="2.6"/><path d="m8.4 10.8 7.2-4M8.4 13.2l7.2 4"/></svg>',
  search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-3.6-3.6"/></svg>',
  close: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>',
  info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.6v.9"/></svg>',
  arch: '<svg class="arch-rule" viewBox="0 0 54 24" aria-hidden="true" focusable="false"><path d="M1 24V10A9 9 0 0 1 10 1h34a9 9 0 0 1 9 9v14"/></svg>',
};

const img = (base: string) => ({ src: `${base}-800.webp`, srcset: `${base}-800.webp 800w, ${base}-1400.webp 1400w` });
const cat = (key: string) => {
  const c = taif.categories.find((x) => x.key === key)!;
  return ar ? c.label_ar : c.label_en;
};
const placesJson = places.map((p) => ({
  id: p.id,
  nameAr: p.name_ar,
  nameEn: p.name_en,
  thumb: `${p.image.base}-800.webp`,
  altAr: p.image.alt_ar,
  altEn: p.image.alt_en,
  maps: p.maps.map((m) => ({ labelAr: m.label_ar, labelEn: m.label_en, url: m.url })),
  branch: L(locale, branchBySlug(p.nearest_branch), 'name'),
  bookHref: `${localePath(locale, '/booking/')}?branch=${p.nearest_branch}`,
}));
const collectionsJson = Object.fromEntries(taif.collections.map((c) => [c.key, { nameAr: c.name_ar, nameEn: c.name_en, places: c.places }]));
const countText = (n: number) => (ar ? `عرض ${n} من ${places.length} وجهة` : `Showing ${n} of ${places.length} places`);
const colCount = (n: number) => (ar ? (n === 2 ? 'وجهتان' : `${n} وجهات`) : `${n} places`);
---

<Base locale={locale} path="/discover-taif/" title={s.title} description={s.description} ogImage={s.ogImage}>
  <div class="legacy-discover" id="top">
    <section class="hero">
      <div class="hero-media">
        <img
          src={img(hero.image).src}
          srcset={img(hero.image).srcset}
          sizes="100vw"
          width="1400"
          height="933"
          fetchpriority="high"
          decoding="async"
          alt={ar ? hero.alt_ar : hero.alt_en}
        />
      </div>
      <div class="hero-veil"></div>
      <svg class="hero-contours" viewBox="0 0 1200 420" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M-20 300 C 160 250, 300 330, 470 288 S 800 200, 980 246 S 1160 300, 1220 268"></path>
        <path d="M-20 352 C 190 300, 330 382, 520 340 S 830 258, 1010 300 S 1170 348, 1220 322"></path>
        <path d="M-20 404 C 210 356, 380 430, 570 392 S 860 316, 1040 356 S 1180 396, 1220 376"></path>
      </svg>
      <div class="hero-body">
        <h1>{tx('اكتشف الطائف', 'Discover Taif')}</h1>
        <p class="hero-title-en">{tx('Discover Taif', 'اكتشف الطائف')}</p>
        <div class="hero-rule"></div>
        <p class="hero-lede">{ar ? hero.lede_ar : hero.lede_en}</p>
        <div class="hero-actions">
          <a class="btn btn-light" href="#places">{tx('ابدأ الاستكشاف', 'Start Exploring')}</a>
          <a class="btn btn-ghost-light" href="#experiences">{tx('كوّن خطتك', 'Build My Plan')}</a>
        </div>
      </div>
    </section>

    <section class="controls section-tight" id="discover" aria-label={tx('البحث والتصفية', 'Search and filters')}>
      <div class="shell controls-inner">
        <div class="search-field">
          <Fragment set:html={ICON.search} />
          <label class="visually-hidden" for="search">{tx('ابحث عن وجهة', 'Search for a place')}</label>
          <input type="search" id="search" autocomplete="off" placeholder={tx('ابحث بالاسم العربي أو الإنجليزي', 'Search by Arabic or English name')} />
          <button type="button" class="search-clear" id="search-clear" aria-label={tx('مسح البحث', 'Clear search')}>
            <Fragment set:html={ICON.close} />
          </button>
        </div>
        <div class="filters" role="group" aria-label={tx('تصفية حسب الفئة', 'Filter by category')}>
          <button type="button" class="chip" data-cat="all" aria-pressed="true" aria-controls="places-grid">{tx('الكل', 'All')}</button>
          {
            taif.categories.map((c) => (
              <button type="button" class="chip" data-cat={c.key} aria-pressed="false" aria-controls="places-grid">
                {ar ? c.label_ar : c.label_en}
              </button>
            ))
          }
        </div>
        <div class="results-bar">
          <p id="result-count" role="status" aria-live="polite">{countText(places.length)}</p>
          <button type="button" class="link-btn" id="clear-filters" hidden>{tx('إعادة ضبط التصفية', 'Reset filters')}</button>
        </div>
      </div>
    </section>

    <section class="collections section" id="experiences">
      <div class="shell">
        <div class="section-head">
          <Fragment set:html={ICON.arch} />
          <h2>{tx('اختر تجربتك', 'Choose Your Experience')}</h2>
          <p class="subtitle">{tx('مجموعات مختارة تجمع وجهات تتناسب مع طبيعة يومك', 'Curated sets that group places suited to the kind of day you have in mind')}</p>
        </div>
        <div class="collection-strip">
          {
            taif.collections.map((c) => (
              <button type="button" class="collection-card" data-collection={c.key} aria-pressed="false" aria-controls="places-grid">
                <img class="arch-mark" src="/brand/symbol.svg" alt="" aria-hidden="true" width="62" height="67" />
                <h3>{ar ? c.name_ar : c.name_en}</h3>
                <span class="count">{colCount(c.places.length)}</span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <section class="places section" id="places">
      <div class="shell">
        <div class="section-head">
          <Fragment set:html={ICON.arch} />
          <h2>{tx('جميع المزارات', 'All Places')}</h2>
          <p class="subtitle">{tx('سبع عشرة وجهة مختارة في الطائف وما حولها', 'Seventeen selected destinations in and around Taif')}</p>
        </div>

        <div class="grid" id="places-grid">
          {
            places.map((p) => {
              const im = img(p.image.base);
              const branch = branchBySlug(p.nearest_branch);
              const multi = p.maps.length > 1;
              const search = [p.name_ar, p.name_en, cat(p.category), p.search_extra].join(' ');
              return (
                <article class="card" data-id={p.id} data-place={p.id} data-cat={p.category} data-search={search}>
                  <div class="card-media">
                    <img
                      src={im.src}
                      srcset={im.srcset}
                      sizes="(min-width: 1000px) 33vw, (min-width: 620px) 50vw, 100vw"
                      width={p.image.width}
                      height={p.image.height}
                      loading="lazy"
                      decoding="async"
                      alt={ar ? p.image.alt_ar : p.image.alt_en}
                    />
                  </div>
                  <div class="card-body">
                    <p class="card-cat">{cat(p.category)}</p>
                    <h3 class="card-title">
                      <span class="name-ar">{p.name_ar}</span>
                      <span class="name-en">{p.name_en}</span>
                    </h3>
                    <p class="card-desc">{ar ? p.description_ar : p.description_en}</p>
                    {p.maps_note_ar && <p class="card-desc card-note">{ar ? p.maps_note_ar : p.maps_note_en}</p>}
                    <p class="card-desc card-note">
                      {t.taif.nearest}:{' '}
                      <a href={branchPath(locale, branch.slug)}>{L(locale, branch, 'name')}</a>
                    </p>
                    <div class="card-actions">
                      <div class="card-actions-row">
                        <button type="button" class="btn btn-outline btn-plan" data-id={p.id} aria-pressed="false" aria-label={tx('أضف إلى خطتي: ', 'Add to My Plan: ') + (ar ? p.name_ar : p.name_en)}>
                          <Fragment set:html={ICON.plus} />
                          <Fragment set:html={ICON.check} />
                          <span class="plan-add">{tx('أضف إلى خطتي', 'Add to My Plan')}</span>
                          <span class="plan-added">{tx('في خطتي', 'In My Plan')}</span>
                        </button>
                        <button type="button" class="btn-icon btn-share" data-id={p.id} aria-label={tx('مشاركة وجهة: ', 'Share place: ') + (ar ? p.name_ar : p.name_en)}>
                          <Fragment set:html={ICON.share} />
                        </button>
                      </div>
                      {p.maps.map((m) => (
                        <a
                          class="btn btn-solid btn-directions"
                          href={m.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={tx('الاتجاهات إلى ', 'Directions to ') + (multi ? (ar ? m.label_ar : m.label_en) : ar ? p.name_ar : p.name_en) + tx(' على خرائط Google', ' on Google Maps')}
                        >
                          <Fragment set:html={ICON.pin} />
                          <span>{ar ? m.label_ar : m.label_en}</span>
                        </a>
                      ))}
                      <a class="btn btn-outline btn-sm" href={`${localePath(locale, '/booking/')}?branch=${branch.slug}`}>
                        {t.taif.book_near}
                      </a>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>

        <div class="empty-state" id="empty-state">
          <img src="/brand/symbol.svg" alt="" aria-hidden="true" width="40" height="43" />
          <p>{tx('لا توجد وجهة مطابقة، جرّب كلمة أخرى أو أعد ضبط التصفية', 'No place matches this search, try another word or reset the filters')}</p>
        </div>
      </div>
    </section>

    <section class="notice section-tight">
      <div class="shell">
        <div class="notice-inner">
          <Fragment set:html={ICON.info} />
          <p>{ar ? taif.notice_ar : taif.notice_en}</p>
        </div>
      </div>
    </section>

    <button type="button" class="plan-fab" id="plan-fab" data-open-plan aria-controls="plan-sheet" aria-label={tx('خطتي', 'My Plan')}>
      <span>{tx('خطتي', 'My Plan')}</span>
      <span class="badge" id="plan-badge" aria-hidden="true">0</span>
    </button>

    <div class="sheet-overlay" id="sheet-overlay"></div>

    <aside class="plan-sheet" id="plan-sheet" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="plan-sheet-title">
      <div class="sheet-grip" aria-hidden="true"></div>
      <div class="sheet-head">
        <h2 id="plan-sheet-title">{tx('خطتي', 'My Plan')}</h2>
        <button type="button" class="sheet-close" id="sheet-close" aria-label={tx('إغلاق خطتي', 'Close My Plan')}>
          <Fragment set:html={ICON.close} />
        </button>
      </div>
      <div class="sheet-body">
        <div class="plan-empty" id="plan-empty">
          <img src="/brand/symbol.svg" alt="" aria-hidden="true" width="38" height="41" />
          <p>{tx('خطتك فارغة، أضف الوجهات التي تودّ زيارتها من بطاقات الدليل', 'Your plan is empty, add the places you would like to visit from the guide cards')}</p>
        </div>
        <ul class="plan-list" id="plan-list"></ul>
      </div>
      <div class="sheet-foot" id="plan-actions" hidden>
        <button type="button" class="btn btn-solid" id="share-plan">{tx('مشاركة خطتي', 'Share My Plan')}</button>
        <button type="button" class="btn btn-outline" id="clear-plan">{tx('مسح خطتي', 'Clear My Plan')}</button>
        <p class="sheet-note">{tx('القائمة محفوظة على جهازك فقط، والترتيب حسب الإضافة ولا يمثل مسار رحلة', 'This list is saved on your device only, the order follows how you added places and is not a suggested route')}</p>
      </div>
    </aside>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script type="application/json" id="places-data" set:html={JSON.stringify(placesJson).replace(/</g, '\\u003c')} />
    <script type="application/json" id="collections-data" set:html={JSON.stringify(collectionsJson).replace(/</g, '\\u003c')} />
  </div>
  <script src="/legacy/discover-taif.js" defer is:inline></script>
</Base>
