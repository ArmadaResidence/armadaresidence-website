---
import Base from '@layouts/Base.astro';
import Icon from '@components/Icon.astro';
import { langPaths } from '@lib/paths';
import {
  branchBySlug,
  branchPath,
  categoryLabel,
  fill,
  L,
  localePath,
  pageSeo,
  placeImage,
  taif,
  ui,
  type Locale,
} from '@lib/content';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const s = pageSeo(locale, 'discover-taif');
const places = taif.places;
const notice = locale === 'ar' ? taif.notice_ar : taif.notice_en;

const planData = {
  key: 'armada_taif_plan',
  places: places.map((p) => ({
    id: p.id,
    name: L(locale, p, 'name'),
    maps: p.maps[0]?.url ?? '',
    branch: p.nearest_branch,
    branchName: L(locale, branchBySlug(p.nearest_branch), 'name'),
    bookHref: `${localePath(locale, '/booking/')}?branch=${p.nearest_branch}`,
  })),
  strings: { add: t.taif.plan_add, remove: t.taif.plan_remove, added: t.taif.plan_added, empty: t.taif.plan_empty, directions: t.taif.directions },
};
---

<Base locale={locale} path="/discover-taif/" title={s.title} description={s.description} ogImage={s.ogImage}>
  <section class="relative bg-midnight text-porcelain overflow-hidden">
    <div class="absolute inset-0 pattern-bg opacity-[0.07]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-14 md:py-20">
      <h1 class="text-3xl md:text-5xl font-bold">{t.taif.heading}</h1>
      <p class="mt-4 text-lg text-porcelain/85 max-w-3xl leading-relaxed">{t.taif.intro}</p>
      <p class="mt-3 text-sm text-bronze font-semibold">{fill(t.taif.count, { n: places.length })}</p>
    </div>
  </section>

  <div class="sticky top-24 z-30 bg-porcelain/95 backdrop-blur border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-3 flex items-center gap-3 overflow-x-auto">
      <div class="flex items-center gap-2 shrink-0" role="group" aria-label={t.taif.filter_label} data-filters>
        <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">{t.taif.all}</button>
        {
          taif.categories.map((c) => (
            <button type="button" class="chip" data-filter={c.key} aria-pressed="false">
              {locale === 'ar' ? c.label_ar : c.label_en}
            </button>
          ))
        }
      </div>
      <button
        type="button"
        class="ms-auto shrink-0 inline-flex items-center gap-2 bg-midnight text-white text-sm font-semibold px-4 py-2 rounded-full hover:bg-bronze transition-colors"
        data-plan-open
        aria-expanded="false"
        aria-controls="plan-drawer"
      >
        <Icon name="star" size={16} />
        <span>{t.taif.plan}</span>
        <span class="latin bg-bronze text-white text-xs rounded-full min-w-5 px-1.5 py-0.5 text-center" data-plan-count>0</span>
      </button>
    </div>
  </div>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-places>
      {
        places.map((p) => {
          const img = placeImage(locale, p);
          const branch = branchBySlug(p.nearest_branch);
          const name = L(locale, p, 'name');
          return (
            <li class="bg-white border border-line rounded-card overflow-hidden flex flex-col" data-place={p.id} data-cat={p.category}>
              <img
                src={img.src}
                srcset={img.srcset}
                sizes="(min-width: 1024px) 384px, (min-width: 640px) 50vw, 100vw"
                width={img.width}
                height={img.height}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                class="w-full aspect-[3/2] object-cover"
              />
              <div class="p-5 flex flex-col gap-3 flex-1">
                <p class="text-xs font-semibold uppercase tracking-wide text-bronze">{categoryLabel(locale, p.category)}</p>
                <h2 class="text-lg font-semibold text-midnight">{name}</h2>
                <p class="text-sm text-ink-muted leading-relaxed">{L(locale, p, 'description')}</p>
                <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
                  {p.maps.map((m) => (
                    <li>
                      <a href={m.url} rel="noopener" target="_blank" class="inline-flex items-center gap-1 font-semibold text-bronze hover:text-bronze-deep">
                        <Icon name="map" size={14} />
                        <span>{p.maps.length > 1 ? (locale === 'ar' ? m.label_ar : m.label_en) : t.taif.directions}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <div class="mt-auto pt-3 border-t border-line text-sm">
                  <p class="text-ink-muted">
                    {t.taif.nearest}:
                    <a href={branchPath(locale, branch.slug)} class="font-semibold text-midnight hover:text-bronze ms-1">
                      {L(locale, branch, 'name')}
                    </a>
                  </p>
                  <div class="mt-3 flex flex-wrap items-center gap-2">
                    <a
                      href={`${localePath(locale, '/booking/')}?branch=${branch.slug}`}
                      class="inline-flex items-center gap-1.5 bg-bronze text-white text-sm font-semibold px-3.5 py-2 rounded hover:bg-bronze-deep transition-colors"
                    >
                      <span>{t.taif.book_near}</span>
                      <Icon name="arrow" size={14} class="rtl:rotate-180" />
                    </a>
                    <button
                      type="button"
                      class="inline-flex items-center gap-1.5 border border-line text-midnight text-sm font-semibold px-3 py-2 rounded hover:border-bronze"
                      data-plan-toggle={p.id}
                      aria-pressed="false"
                    >
                      <Icon name="plus" size={14} class="icon-add" />
                      <Icon name="check" size={14} class="icon-added hidden text-bronze" />
                      <span data-plan-label>{t.taif.plan_add}</span>
                    </button>
                  </div>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
    <p class="hidden mt-8 text-center text-ink-muted" data-empty>{t.taif.empty_filter}</p>

    <div class="mt-12 bg-white border border-line rounded-card p-5 text-sm">
      <h2 class="font-semibold text-midnight">{t.taif.notice_heading}</h2>
      <p class="mt-1 text-ink-muted">{notice}</p>
    </div>
  </section>

  <div id="plan-drawer" class="hidden fixed inset-x-0 bottom-0 z-50 bg-white border-t border-line shadow-2xl max-h-[70vh] overflow-y-auto" role="dialog" aria-label={t.taif.plan}>
    <div class="mx-auto max-w-6xl px-4 py-5">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-midnight">{t.taif.plan}</h2>
        <div class="flex items-center gap-2">
          <button type="button" class="text-sm text-ink-muted hover:text-midnight" data-plan-clear>{t.taif.plan_clear}</button>
          <button type="button" class="w-9 h-9 grid place-items-center rounded hover:bg-porcelain" data-plan-close aria-label={t.taif.plan_close}>
            <Icon name="close" size={20} />
          </button>
        </div>
      </div>
      <p class="text-xs text-ink-muted mt-1">{t.taif.plan_hint}</p>
      <ul class="mt-4 divide-y divide-line" data-plan-list></ul>
      <p class="text-sm text-ink-muted py-6 text-center" data-plan-empty>{t.taif.plan_empty}</p>
    </div>
  </div>

  <script type="application/json" id="plan-data" set:html={JSON.stringify(planData).replace(/</g, '\\u003c')} />
</Base>

<style>
  .chip {
    white-space: nowrap;
    border: 1px solid var(--color-line);
    background: var(--color-white);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
  }
  .chip.is-active {
    background: var(--color-midnight);
    border-color: var(--color-midnight);
    color: var(--color-white);
  }
</style>

<script>
  type PlanData = {
    key: string;
    places: { id: string; name: string; maps: string; branch: string; branchName: string; bookHref: string }[];
    strings: { add: string; remove: string; added: string; empty: string; directions: string };
  };
  const data = JSON.parse(document.getElementById('plan-data')!.textContent || '{}') as PlanData;
  const byId = new Map(data.places.map((p) => [p.id, p]));

  // ---- category filter
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-place]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const key = chip.dataset.filter!;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', String(on));
      });
      let shown = 0;
      cards.forEach((card) => {
        const show = key === 'all' || card.dataset.cat === key;
        card.classList.toggle('hidden', !show);
        if (show) shown++;
      });
      empty.classList.toggle('hidden', shown > 0);
    }),
  );

  // ---- my plan (localStorage, this device only)
  const read = (): string[] => {
    try {
      const v = JSON.parse(localStorage.getItem(data.key) || '[]');
      return Array.isArray(v) ? v.filter((id) => byId.has(id)) : [];
    } catch {
      return [];
    }
  };
  const write = (ids: string[]) => {
    try {
      localStorage.setItem(data.key, JSON.stringify(ids));
    } catch {
      /* storage unavailable */
    }
  };
  const drawer = document.getElementById('plan-drawer')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-plan-open]')!;
  const count = document.querySelector<HTMLElement>('[data-plan-count]')!;
  const list = document.querySelector<HTMLElement>('[data-plan-list]')!;
  const emptyMsg = document.querySelector<HTMLElement>('[data-plan-empty]')!;

  function render() {
    const ids = read();
    count.textContent = String(ids.length);
    document.querySelectorAll<HTMLButtonElement>('[data-plan-toggle]').forEach((b) => {
      const on = ids.includes(b.dataset.planToggle!);
      b.setAttribute('aria-pressed', String(on));
      b.querySelector('.icon-add')?.classList.toggle('hidden', on);
      b.querySelector('.icon-added')?.classList.toggle('hidden', !on);
      b.querySelector('[data-plan-label]')!.textContent = on ? data.strings.added : data.strings.add;
      b.title = on ? data.strings.remove : data.strings.add;
    });
    list.innerHTML = '';
    for (const id of ids) {
      const p = byId.get(id)!;
      const li = document.createElement('li');
      li.className = 'py-3 flex flex-wrap items-center justify-between gap-2 text-sm';
      const name = document.createElement('span');
      name.className = 'font-semibold text-midnight';
      name.textContent = p.name;
      const links = document.createElement('span');
      links.className = 'flex items-center gap-3';
      const maps = document.createElement('a');
      maps.href = p.maps;
      maps.rel = 'noopener';
      maps.target = '_blank';
      maps.className = 'text-bronze font-semibold hover:text-bronze-deep';
      maps.textContent = data.strings.directions;
      const book = document.createElement('a');
      book.href = p.bookHref;
      book.className = 'text-midnight hover:text-bronze';
      book.textContent = p.branchName;
      const rm = document.createElement('button');
      rm.type = 'button';
      rm.className = 'text-ink-muted hover:text-midnight';
      rm.textContent = '×';
      rm.setAttribute('aria-label', data.strings.remove);
      rm.addEventListener('click', () => toggle(id));
      links.append(maps, book, rm);
      li.append(name, links);
      list.appendChild(li);
    }
    emptyMsg.classList.toggle('hidden', ids.length > 0);
  }
  function toggle(id: string) {
    const ids = read();
    const i = ids.indexOf(id);
    if (i >= 0) ids.splice(i, 1);
    else ids.push(id);
    write(ids);
    render();
  }
  document.querySelectorAll<HTMLButtonElement>('[data-plan-toggle]').forEach((b) => b.addEventListener('click', () => toggle(b.dataset.planToggle!)));
  const setOpen = (open: boolean) => {
    drawer.classList.toggle('hidden', !open);
    openBtn.setAttribute('aria-expanded', String(open));
  };
  openBtn.addEventListener('click', () => setOpen(drawer.classList.contains('hidden')));
  document.querySelector('[data-plan-close]')!.addEventListener('click', () => setOpen(false));
  document.querySelector('[data-plan-clear]')!.addEventListener('click', () => {
    write([]);
    render();
  });
  render();
</script>
