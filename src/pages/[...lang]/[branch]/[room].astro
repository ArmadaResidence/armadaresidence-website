---
import Base from '@layouts/Base.astro';
import GallerySlider from '@components/GallerySlider.astro';
import Photo from '@components/Photo.astro';
import Placeholder from '@components/Placeholder.astro';
import PriceBlock from '@components/PriceBlock.astro';
import RoomGrid from '@components/RoomGrid.astro';
import Icon from '@components/Icon.astro';
import { langPaths } from '@lib/paths';
import { hotelRoom } from '@lib/jsonld';
import {
  branchBySlug,
  branchPath,
  fill,
  guestsWord,
  inRoomAmenityLabels,
  L,
  localePath,
  ogImageOf,
  paragraphs,
  photoProps,
  photosOf,
  roomFeatureLabels,
  rooms,
  roomSeo,
  roomsFor,
  ui,
  type Locale,
  type Room,
} from '@lib/content';

export function getStaticPaths() {
  return langPaths().flatMap(({ params, props }) =>
    rooms.map((r) => ({ params: { ...params, branch: r.branch, room: r.slug }, props: { ...props, room: r } })),
  );
}

interface Props {
  locale: Locale;
  room: Room;
}
const { locale, room } = Astro.props;
const t = ui(locale);
const branch = branchBySlug(room.branch);
const s = roomSeo(locale, room);
const name = L(locale, room, 'name');
const branchName = L(locale, branch, 'name');
const path = `/${room.branch}/${room.slug}/`;
const others = roomsFor(room.branch).filter((r) => r.slug !== room.slug);
const features = roomFeatureLabels(locale, room);
const inRoom = inRoomAmenityLabels(locale, room);
const laundry = locale === 'ar' ? room.features.laundry_ar : room.features.laundry_en;
const soldOut = room.availability === 'sold_out';
const photos = photosOf(room);
const g = t.gallery;
const galleryLabels = { previous: g.previous, next: g.next, goTo: g.go_to, open: g.open, close: g.close, of: g.of };
const bookHref = `${localePath(locale, '/booking/')}?branch=${room.branch}&room=${room.slug}`;

const details: { label: string; value: string }[] = [
  { label: t.room.size, value: fill(t.room.size_value, { size: room.size_m2 }) },
  { label: t.room.bed, value: L(locale, room, 'bed') },
  { label: t.room.included_guests, value: guestsWord(locale, room.included_guests) },
  { label: t.room.capacity, value: guestsWord(locale, room.capacity) },
];
---

<Base
  locale={locale}
  path={path}
  title={s.title}
  description={s.description}
  noindex={s.noindex}
  ogImage={ogImageOf(room)}
  jsonld={[hotelRoom(locale, room, branch)]}
  whatsapp={branch.slug}
  booking={soldOut ? { branch: room.branch } : { branch: room.branch, room: room.slug }}
>
  <article class="mx-auto max-w-6xl px-4 pt-10 pb-14">
    <nav aria-label="breadcrumb" class="text-sm text-ink-muted">
      <a href={localePath(locale, '/')} class="hover:text-midnight">{t.nav.home}</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <a href={branchPath(locale, branch.slug)} class="hover:text-midnight">{branchName}</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-midnight">{name}</span>
    </nav>

    <h1 class="mt-6 text-3xl md:text-4xl font-bold text-midnight">{name}</h1>
    <p class="mt-2 text-ink-muted">
      <a href={branchPath(locale, branch.slug)} class="hover:text-midnight">{fill(t.room.in_branch, { branch: branchName })}</a>
      <span aria-hidden="true" class="mx-1">·</span>
      <span>{L(locale, branch, 'type')}</span>
    </p>

    <div class="mt-8 grid gap-8 lg:grid-cols-5">
      <div class="lg:col-span-3">
        {/* Photos from scripts/photos-import.mjs (cover first); none yet → the placeholder. legacy_main_image is never rendered. */}
        <div transition:name={`room-media-${room.branch}-${room.slug}`}>
          {
            photos.length > 1 ? (
              <GallerySlider
                images={photos.map((p) => ({ ...photoProps(locale, p), sizes: '(min-width: 1024px) 680px, 100vw' }))}
                ratio="3 / 2"
                labels={galleryLabels}
              />
            ) : photos.length === 1 ? (
              <Photo {...photoProps(locale, photos[0])} sizes="(min-width: 1024px) 680px, 100vw" loading="eager" fetchpriority="high" class="rounded-card" imgClass="w-full h-auto" />
            ) : (
              <Placeholder label={fill(t.photo_pending_alt, { subject: `${name} — ${branchName}` })} />
            )
          }
        </div>
        <div class="mt-8 prose-armada leading-relaxed">
          {paragraphs(L(locale, room, 'description')).map((p) => <p>{p}</p>)}
        </div>

        <h2 class="reveal mt-10 text-sm font-semibold uppercase tracking-wide text-bronze-text">{t.room.details_heading}</h2>
        <dl class="reveal-group mt-3 grid gap-3 sm:grid-cols-2 text-sm">
          {
            details.map((d) => (
              <div class="bg-white border border-line rounded-card px-4 py-3">
                <dt class="text-ink-muted">{d.label}</dt>
                <dd class="font-semibold text-midnight mt-0.5">{d.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          features.length > 0 && (
            <>
              <h2 class="reveal mt-8 text-sm font-semibold uppercase tracking-wide text-bronze-text">{t.room.features_heading}</h2>
              <ul class="reveal-group mt-3 flex flex-wrap gap-2">
                {features.map((f) => (
                  <li class="inline-flex items-center gap-1.5 text-sm bg-white border border-line px-3 py-1.5 rounded">
                    <Icon name="check" size={14} class="text-bronze" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          inRoom.length > 0 && (
            <>
              <h2 class="reveal mt-8 text-sm font-semibold uppercase tracking-wide text-bronze-text">{t.room.in_room_heading}</h2>
              <ul class="reveal-group mt-3 grid gap-2 sm:grid-cols-2 text-sm">
                {inRoom.map((a) => (
                  <li class="flex items-center gap-2">
                    <Icon name="check" size={14} class="text-bronze shrink-0" />
                    <span>{a}</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }
        {
          laundry && (
            <p class="mt-4 text-sm text-ink-muted">
              {t.room.laundry}: {laundry}
            </p>
          )
        }
      </div>

      {/* desktop: the booking card sticks under the header and follows the scroll to the end of the content row (item 8) */}
      <div class="reveal reveal-lg lg:col-span-2 lg:sticky lg:top-24 self-start" style="--reveal-delay:120ms" data-book-card>
        <PriceBlock locale={locale} room={room} mode="full" />
        <a href={branchPath(locale, branch.slug)} class="mt-4 inline-flex items-center gap-1 text-sm text-ink-muted hover:text-midnight">
          <Icon name="arrow" size={16} class="icon-arrow-back rotate-180 rtl:rotate-0" />
          <span>{t.room.back_to_branch}</span>
        </a>
      </div>
    </div>
  </article>

  {
    /* phones: fixed bottom bar with the room name and the booking CTA once the booking card has scrolled past (item 8);
       never for sold-out rooms (no booking CTA, CLAUDE.md §5) */
    !soldOut && (
      <div class="room-bar lg:hidden" data-room-bar aria-hidden="true" inert>
        <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between gap-3">
          <p class="min-w-0 text-sm leading-tight">
            <strong class="block truncate text-midnight">{name}</strong>
            <span class="block truncate text-ink-muted text-xs">{branchName}</span>
          </p>
          <a href={bookHref} class="shrink-0 inline-flex items-center gap-2 bg-bronze-deep text-white text-sm font-semibold px-4 py-2.5 rounded hover:bg-bronze-text transition-colors">
            <span>{t.nav.book}</span>
            <Icon name="arrow" size={16} class="icon-arrow rtl:rotate-180" />
          </a>
        </div>
      </div>
    )
  }
  {
    others.length > 0 && (
      <section class="cv-auto bg-white border-t border-line">
        <div class="mx-auto max-w-6xl px-4 py-14">
          <h2 class="reveal text-2xl font-bold text-midnight">{fill(t.room.other_rooms, { branch: branchName })}</h2>
          <RoomGrid locale={locale} rooms={others} class="mt-8" />
        </div>
      </section>
    )
  }
</Base>
