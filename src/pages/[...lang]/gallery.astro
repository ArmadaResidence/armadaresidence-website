---
/**
 * /gallery/ — «المعرض» / "Gallery" (Ahmed, 2 Nov 2026; DECISIONS.md 2026-11-02 «Gallery page»): every photo published in
 * the dashboard «الصور» for the branches, the room types, the dining venues and the hall (src/lib/gallery.ts: order,
 * filters, «إظهار في المعرض»). Built only once at least 6 photos qualify — until then no page, no nav link, no sitemap
 * entry (getStaticPaths returns nothing). Fixed 3:2 cells (CLS 0), lazy below the first photo, the pipeline's AVIF +
 * WebP srcsets. Filters: each shown only when it has photos (the branch filters hold every photo of that branch).
 * Lightbox: native <dialog> (inert page behind), arrows (reading direction), Esc, swipe, a visible close button, Tab
 * kept inside, focus back on the thumbnail of the photo last shown; caption = the photo's alt + «1 / 24»; a link to the
 * photo's page. dataLayer: gallery_filter { filter }, gallery_open { category } — nothing personal.
 */
import Base from '@layouts/Base.astro';
import { langPaths } from '@lib/paths';
import { breadcrumbs, collectionPage } from '@lib/jsonld';
import { fill, L, localePath, pageSeo, photoPreload, ui, type Locale } from '@lib/content';
import { galleryFilters, galleryItems, galleryLive, galleryOg, inFilter } from '@lib/gallery';

export function getStaticPaths() {
  return galleryLive ? langPaths() : [];
}

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const g = t.gallery_page;
const s = pageSeo(locale, 'gallery');
const THUMB_SIZES = '(min-width: 1152px) 376px, (min-width: 768px) 33vw, 50vw';
const VIEW_SIZES = '(min-width: 1520px) 1400px, 92vw';
const set = (p: { base: string; widths: number[] }, ext: string) => p.widths.map((w) => `${p.base}-${w}.${ext} ${w}w`).join(', ');
const items = galleryItems.map((it) => {
  const p = it.photo;
  return {
    it,
    alt: L(locale, p, 'alt'),
    src: `${p.base}-${p.widths.includes(800) ? 800 : p.widths[0]}.webp`,
    webp: set(p, 'webp'),
    avif: p.formats?.includes('avif') ? set(p, 'avif') : '',
    filters: galleryFilters.filter((f) => inFilter(it, f)).join(' '),
  };
});
const jsonld = [
  collectionPage(
    locale,
    g.heading,
    s.description,
    localePath(locale, '/gallery/'),
    items.map((x) => ({ url: `${x.it.photo.base}-${x.it.photo.widths.at(-1)}.webp`, caption: x.alt, width: x.it.photo.width, height: x.it.photo.height })),
  ),
  breadcrumbs([
    { name: t.nav.home, path: localePath(locale, '/') },
    { name: g.heading, path: localePath(locale, '/gallery/') },
  ]),
];
const first = galleryItems[0]?.photo;
---

<Base locale={locale} path="/gallery/" title={s.title} description={s.description} ogImage={galleryOg} jsonld={jsonld}>
  {first && <link slot="head" {...photoPreload(first, THUMB_SIZES)} />}
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-14" data-gallery-page data-shown={g.shown} data-go-to={g.go_to}>
    <nav aria-label="breadcrumb" class="text-sm text-ink-muted">
      <a href={localePath(locale, '/')} class="hover:text-midnight">{t.nav.home}</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-midnight">{g.heading}</span>
    </nav>
    <h1 class="mt-6 text-3xl md:text-4xl font-bold text-midnight">{g.heading}</h1>
    <p class="mt-3 max-w-3xl text-lg text-ink-muted">{s.description}</p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label={g.filters} data-gallery-filters>
      {
        galleryFilters.map((f) => (
          <button type="button" class="gallery-filter" aria-pressed={f === 'all' ? 'true' : 'false'} aria-controls="gallery-grid" data-gallery-filter={f}>
            {g.filter[f]}
          </button>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-ink-muted" role="status" aria-live="polite" data-gallery-count>{fill(g.shown, { n: items.length })}</p>

    <ul id="gallery-grid" class="gallery-grid mt-4" data-gallery-grid>
      {
        items.map((x, i) => (
          <li
            data-gallery-item
            data-filters={x.filters}
            data-category={x.it.category}
            data-src={x.src}
            data-srcset={x.webp}
            data-avif={x.avif}
            data-alt={x.alt}
            data-w={x.it.photo.width}
            data-h={x.it.photo.height}
            data-href={x.it.href[locale]}
            data-page={x.it.page[locale]}
          >
            <button type="button" class="gallery-thumb" aria-haspopup="dialog" data-gallery-open>
              <picture>
                {x.avif && <source type="image/avif" srcset={x.avif} sizes={THUMB_SIZES} />}
                <img
                  src={x.src}
                  srcset={x.webp}
                  sizes={THUMB_SIZES}
                  alt={x.alt}
                  width={x.it.photo.width}
                  height={x.it.photo.height}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </picture>
            </button>
          </li>
        ))
      }
    </ul>

    <dialog class="gallery-viewer" aria-label={g.viewer} data-gallery-viewer>
      <div class="gallery-viewer-frame" data-gallery-frame>
        <picture>
          <source type="image/avif" sizes={VIEW_SIZES} data-gallery-v-avif />
          {/* src / alt are set when the viewer opens (aria-hidden until then) */}
          <img class="gallery-viewer-img" alt="" aria-hidden="true" sizes={VIEW_SIZES} width="1400" height="933" data-gallery-v-img />
        </picture>
      </div>
      <div class="gallery-viewer-bar">
        <p class="gallery-viewer-caption" data-gallery-v-caption></p>
        <p class="gallery-viewer-meta">
          <span class="num" dir="ltr" data-gallery-v-counter></span>
          <a class="gallery-viewer-link" href="#" data-gallery-v-link></a>
        </p>
      </div>
      <button type="button" class="gallery-arrow gallery-viewer-close" aria-label={t.gallery.close} data-gallery-v-close>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M5.7 4.3L4.3 5.7 10.6 12l-6.3 6.3 1.4 1.4L12 13.4l6.3 6.3 1.4-1.4L13.4 12l6.3-6.3-1.4-1.4L12 10.6z" /></svg>
      </button>
      <button type="button" class="gallery-arrow gallery-viewer-prev" aria-label={t.gallery.previous} data-gallery-v-prev>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" class="rotate-180 rtl:rotate-0"><path d="M9.3 5.3a1 1 0 011.4 0l6 6a1 1 0 010 1.4l-6 6a1 1 0 01-1.4-1.4L14.6 12 9.3 6.7a1 1 0 010-1.4z" /></svg>
      </button>
      <button type="button" class="gallery-arrow gallery-viewer-next" aria-label={t.gallery.next} data-gallery-v-next>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" class="rtl:rotate-180"><path d="M9.3 5.3a1 1 0 011.4 0l6 6a1 1 0 010 1.4l-6 6a1 1 0 01-1.4-1.4L14.6 12 9.3 6.7a1 1 0 010-1.4z" /></svg>
      </button>
    </dialog>
  </section>
</Base>

<script>
  import { bindOnce, isRtl, onPageLoad } from '@lib/client';

  type DL = { dataLayer?: unknown[] };
  const push = (o: Record<string, string>) => {
    const w = window as unknown as DL;
    w.dataLayer = w.dataLayer || [];
    w.dataLayer.push(o);
  };

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-gallery-page]');
    if (!root || !bindOnce(root)) return;
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-gallery-item]'));
    const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]'));
    const count = root.querySelector<HTMLElement>('[data-gallery-count]')!;
    const dlg = root.querySelector<HTMLDialogElement>('[data-gallery-viewer]')!;
    const img = dlg.querySelector<HTMLImageElement>('[data-gallery-v-img]')!;
    const avif = dlg.querySelector<HTMLSourceElement>('[data-gallery-v-avif]')!;
    const caption = dlg.querySelector<HTMLElement>('[data-gallery-v-caption]')!;
    const counter = dlg.querySelector<HTMLElement>('[data-gallery-v-counter]')!;
    const link = dlg.querySelector<HTMLAnchorElement>('[data-gallery-v-link]')!;
    const closeBtn = dlg.querySelector<HTMLButtonElement>('[data-gallery-v-close]')!;
    const frame = dlg.querySelector<HTMLElement>('[data-gallery-frame]')!;
    let visible = items;
    let at = 0;

    // ── filters ──
    for (const b of filters) {
      b.addEventListener('click', () => {
        const f = b.dataset.galleryFilter || 'all';
        for (const x of filters) x.setAttribute('aria-pressed', String(x === b));
        for (const li of items) li.hidden = !(li.dataset.filters || '').split(' ').includes(f);
        visible = items.filter((li) => !li.hidden);
        count.textContent = (root.dataset.shown || '{n}').replace('{n}', String(visible.length));
        push({ event: 'gallery_filter', filter: f });
      });
    }

    // ── the viewer ──
    const show = (i: number) => {
      if (!visible.length) return;
      at = (i + visible.length) % visible.length;
      const d = visible[at].dataset;
      avif.srcset = d.avif || '';
      img.srcset = d.srcset || '';
      img.src = d.src || '';
      img.alt = d.alt || '';
      img.removeAttribute('aria-hidden');
      img.width = Number(d.w) || 1400;
      img.height = Number(d.h) || 933;
      caption.textContent = d.alt || '';
      counter.textContent = `${at + 1} / ${visible.length}`;
      link.href = d.href || '#';
      link.textContent = (root.dataset.goTo || '{page}').replace('{page}', d.page || '');
    };
    const step = (by: number) => show(at + by);
    for (const li of items) {
      li.querySelector<HTMLButtonElement>('[data-gallery-open]')!.addEventListener('click', () => {
        show(visible.indexOf(li));
        dlg.showModal();
        closeBtn.focus();
        push({ event: 'gallery_open', category: li.dataset.category || '' });
      });
    }
    // focus returns to the thumbnail of the photo last shown
    dlg.addEventListener('close', () => visible[at]?.querySelector<HTMLButtonElement>('[data-gallery-open]')?.focus());
    closeBtn.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-gallery-v-prev]')!.addEventListener('click', () => step(-1));
    dlg.querySelector('[data-gallery-v-next]')!.addEventListener('click', () => step(1));
    dlg.addEventListener('keydown', (e) => {
      // the arrows follow the reading direction: in Arabic the next photo is to the left
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        step((e.key === 'ArrowRight') !== isRtl(dlg) ? 1 : -1);
      } else if (e.key === 'Tab') {
        // keep Tab inside the viewer
        const f = Array.from(dlg.querySelectorAll<HTMLElement>('a[href], button'));
        const i = f.indexOf(document.activeElement as HTMLElement);
        if (e.shiftKey && i <= 0) {
          e.preventDefault();
          f[f.length - 1].focus();
        } else if (!e.shiftKey && i === f.length - 1) {
          e.preventDefault();
          f[0].focus();
        }
      }
    });
    // a press that starts and ends on the backdrop closes (the site's outside-press rule)
    let downOnBackdrop = false;
    dlg.addEventListener('pointerdown', (e) => (downOnBackdrop = e.target === dlg));
    dlg.addEventListener('pointerup', (e) => {
      if (downOnBackdrop && e.target === dlg) dlg.close();
      downOnBackdrop = false;
    });
    // swipe: a horizontal drag over 40 px moves one photo (towards the reading direction's next)
    let x0: number | null = null;
    let y0 = 0;
    frame.addEventListener('pointerdown', (e) => {
      x0 = e.clientX;
      y0 = e.clientY;
    });
    frame.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      const dy = e.clientY - y0;
      x0 = null;
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
      step((dx < 0) !== isRtl(dlg) ? 1 : -1);
    });
    frame.addEventListener('pointercancel', () => (x0 = null));
  });
</script>
