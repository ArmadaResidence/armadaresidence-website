---
/**
 * /_motion/ — internal review page for the polish sprint (item 14, 11 Oct 2026): every motion component with its
 * states on one page, in both languages, noindex and outside the sitemap. The file is named [review].astro
 * because Astro skips files that start with an underscore; getStaticPaths pins the slug to "_motion".
 */
import Base from '@layouts/Base.astro';
import BranchSplit from '@components/BranchSplit.astro';
import BranchStory from '@components/BranchStory.astro';
import Counters from '@components/Counters.astro';
import Divider from '@components/Divider.astro';
import Icon from '@components/Icon.astro';
import Photo from '@components/Photo.astro';
import RoomGrid from '@components/RoomGrid.astro';
import ArticleBody from '@components/ArticleBody.astro';
import { renderBody } from '@lib/articles';
import { langPaths } from '@lib/paths';
import { branchBySlug, branches, localePath, lqip, pageSeo, roomsFor, siteStats, siteTexts, ui, type Locale } from '@lib/content';

export function getStaticPaths() {
  return langPaths().map(({ params, props }) => ({ params: { ...params, review: '_motion' }, props }));
}

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const s = pageSeo(locale, '_motion');
const ar = locale === 'ar';
const airport = branchBySlug('airport-road');
const rooms = roomsFor('airport-road').slice(0, 3);
const title = ar ? siteTexts.hero.title_ar : siteTexts.hero.title_en;
const words = title.split(/\s+/).filter(Boolean);
const alts = t.dining.photo_alts as Record<string, string>;

const tokens: [string, string, string][] = [
  ['--motion-fast', '200ms', ar ? 'تحويم، تركيز، تحوّل الأيقونة، تغييرات الحالة الصغيرة' : 'hover, focus, icon morph, small state changes'],
  ['--motion-base', '400ms', ar ? 'الظهور، اللوحة الجانبية، التلاشي المتقاطع، خط القائمة' : 'reveal, drawer, cross-fade, nav ink'],
  ['--motion-slow', '700ms', ar ? 'رسم الخطوط، خط الهيرو، الاستقرار الطويل' : 'rules being drawn, hero rule, long settles'],
  ['--motion-count', '1200ms', ar ? 'الأرقام التي تعدّ' : 'count-up figures'],
  ['--ease-out', 'cubic-bezier(.22, 1, .36, 1)', ar ? 'الوصول' : 'arriving'],
  ['--ease-in-out', 'cubic-bezier(.65, 0, .35, 1)', ar ? 'الحركة والتحوّل' : 'moving / morphing'],
  ['--ease-in', 'cubic-bezier(.55, 0, 1, .45)', ar ? 'المغادرة' : 'leaving'],
  ['--motion-shift-sm', '16px', ar ? 'النصوص والعناصر الصغيرة' : 'text, small elements'],
  ['--motion-shift-lg', '24px', ar ? 'البطاقات والأقسام والصور' : 'cards, sections, media'],
  ['--motion-stagger', '60ms', ar ? 'بين العناصر الشقيقة' : 'between siblings'],
  ['--motion-stagger-fast', '50ms', ar ? 'بين كلمات الهيرو' : 'between hero words'],
];
const items: { n: number; title: string; note: string }[] = ar
  ? [
      { n: 1, title: 'View Transitions', note: 'انتقل من أي رابط داخلي: تلاشٍ 200ms، الهيدر وزر الواتساب ثابتان، صورة الغرفة عنصر مشترك بين البطاقة والصفحة.' },
      { n: 2, title: 'الظهور مع السكرول', note: 'كل كتلة تظهر مرة واحدة من 15% ظهور، التتابع 60ms بين الأشقاء.' },
      { n: 3, title: 'الهيرو', note: 'الكلمات 50ms ثم الخط البرونزي (700ms) ثم العنوان الفرعي والأزرار — اضغط «إعادة» للتكرار.' },
      { n: 4, title: 'اختيار الفرع', note: 'التحويم أو التركيز يوسّع النصف إلى 58% ويعتّم الآخر؛ على الجوال بطاقتان متتاليتان.' },
      { n: 5, title: 'ميكرو-تفاعلات', note: 'سهم الأزرار 4px، خط القائمة في الهيدر، زر الوضع الليلي (قمر↔شمس)، نبضة الواتساب بعد 5 ثوانٍ، الـlabels العائمة في لوحة الحجز.' },
      { n: 6, title: 'أرقام تعدّ', note: '1.2 ثانية بمنحنى تباطؤ عند 50% ظهور، عرض محجوز للأرقام.' },
      { n: 7, title: 'الغرف على الجوال', note: 'شريط أفقي بـscroll-snap، 85% عرض، نقاط؛ على الديسكتوب الشبكة.' },
      { n: 8, title: 'صفحة الغرفة', note: 'بطاقة الحجز sticky على الديسكتوب وشريط سفلي على الجوال — انظر أي صفحة غرفة.' },
      { n: 9, title: 'توهّج المؤشر', note: 'دائرة برونزية 6% تتبع المؤشر بتأخير على الأسطح الكحلية (ديسكتوب فقط).' },
      { n: 10, title: 'قصة الفرع', note: 'عمود صورة ثابت و4 مشاهد تتبدل مع السكرول.' },
      { n: 11, title: 'لوحة الحجز', note: 'أي رابط إلى /booking/ يفتح اللوحة مع تعبئة مسبقة؛ Esc والنقر خارجها يغلقان.' },
      { n: 12, title: 'الفاصل', note: 'خط برونزي يُرسم من جهة البداية مع رمز الهوية. تغيّر الوزن متخطّى (الخط العربي ثابت الأوزان).' },
      { n: 13, title: 'الصور', note: 'لون الهوية + معاينة 16px ضبابية ثم الصورة تتضح عند التحميل.' },
      { n: 14, title: 'تقليل الحركة', note: 'مع prefers-reduced-motion كل القيم تصبح 0 وتظهر الحالات النهائية فورًا.' },
    ]
  : [
      { n: 1, title: 'View transitions', note: 'Follow any internal link: 200 ms cross-fade, header and WhatsApp button kept still, room media shared between card and page.' },
      { n: 2, title: 'Scroll reveal', note: 'Each block rises once from 15 % visibility, siblings 60 ms apart.' },
      { n: 3, title: 'Hero', note: 'Words 50 ms apart, then the bronze rule (700 ms), then subtitle and buttons — press "replay".' },
      { n: 4, title: 'Branch chooser', note: 'Hover or focus widens a pane to 58 % and dims the other; two stacked cards on phones.' },
      { n: 5, title: 'Micro-interactions', note: 'Button arrows 4 px, nav ink in the header, theme toggle (moon ↔ sun), WhatsApp pulse after 5 s, floating labels in the drawer.' },
      { n: 6, title: 'Counters', note: '1.2 s ease-out at 50 % visibility, reserved digit width.' },
      { n: 7, title: 'Rooms on phones', note: 'Scroll-snap strip, 85 % cards, dots; the grid on desktop.' },
      { n: 8, title: 'Room page', note: 'Sticky booking card on desktop, bottom bar on phones — see any room page.' },
      { n: 9, title: 'Cursor glow', note: 'A 6 % bronze disc trailing the pointer over midnight surfaces (desktop only).' },
      { n: 10, title: 'Branch story', note: 'Sticky picture and four scenes that change it as you scroll.' },
      { n: 11, title: 'Booking drawer', note: 'Any link to /booking/ opens the drawer prefilled; Esc and a click outside close it.' },
      { n: 12, title: 'Divider', note: 'Bronze rule drawn from the start side with the brand symbol. Weight morph skipped (the Arabic font has static weights).' },
      { n: 13, title: 'Photos', note: 'Brand tint + 16 px blurred preview, then the photo sharpens as it loads.' },
      { n: 14, title: 'Reduced motion', note: 'Under prefers-reduced-motion every token is 0 and final states show at once.' },
    ];
const h = ar ? 'مراجعة الحركة' : 'Motion review';
// Blog sample (12 Oct 2026): the same renderer the articles use — :::photo and :::gallery inside Markdown,
// one Reveal per ## section. Approved café photos; alts from ui.json → dining.photo_alts.
const sampleMd = [
  ar ? 'نموذج لمكوّنات المقال: الصورة والمعرض داخل نص Markdown، وكل قسم يظهر عند التمرير.' : 'Sample of the article components: a photo and a gallery inside Markdown, each section revealed on scroll.',
  '',
  ar ? '## صورة داخل المقال' : '## A photo inside the article',
  ':::photo',
  `/images/dining/caesar-salad | ${alts['caesar-salad']} | ${ar ? 'تعليق اختياري تحت الصورة' : 'Optional caption under the photo'}`,
  ':::',
  '',
  ar ? '## معرض داخل المقال' : '## A gallery inside the article',
  ':::gallery',
  ...['cutlet-penne', 'cutlet-alfredo', 'pizza-margherita'].map((s) => `/images/dining/${s} | ${alts[s]}`),
  ':::',
].join('\n');
const sampleSections = await renderBody(sampleMd);

---

<Base locale={locale} path="/_motion/" title={s.title} description={s.description} noindex={true}>
  <section class="hero relative bg-midnight text-porcelain overflow-hidden" data-glow>
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute inset-0 pattern-bg hero-pattern"></div>
      <div class="glow"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-14">
      <p class="text-bronze font-semibold tracking-wide mb-4">{ar ? 'صفحة داخلية — غير مفهرسة' : 'Internal page — not indexed'}</p>
      <h1 class="text-3xl md:text-5xl font-bold leading-tight max-w-3xl" data-hero-demo style={`--hero-rule-delay:${words.length * 50}ms`}>
        {words.map((w, i) => (
          <>
            <span class="hero-word" style={`--i:${i}`}>{w}</span>
            {i < words.length - 1 && ' '}
          </>
        ))}
      </h1>
      <span class="hero-rule" aria-hidden="true" style={`--hero-rule-delay:${words.length * 50}ms`}></span>
      <p class="hero-sub mt-5 text-lg text-porcelain/85 max-w-2xl" style={`--hero-rule-delay:${words.length * 50}ms`}>{h} — {ar ? 'كل مكوّنات السبرنت بحالاتها' : 'every sprint component with its states'}</p>
      <div class="hero-ctas mt-8 flex flex-wrap gap-3" style={`--hero-rule-delay:${words.length * 50}ms`}>
        <button type="button" class="inline-flex items-center gap-2 bg-bronze-deep text-white font-semibold px-6 py-3 rounded hover:bg-bronze-text transition-colors" data-hero-replay>
          <span>{ar ? 'إعادة تشغيل الهيرو' : 'Replay the hero'}</span>
          <Icon name="arrow" size={18} class="icon-arrow rtl:rotate-180" />
        </button>
        <a href={localePath(locale, '/booking/')} class="inline-flex items-center gap-2 border border-porcelain/50 text-porcelain font-semibold px-6 py-3 rounded hover:bg-porcelain hover:text-midnight transition-colors">
          {ar ? 'افتح لوحة الحجز' : 'Open the booking drawer'}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="reveal text-2xl md:text-3xl font-bold text-midnight">{ar ? 'الـtokens' : 'Tokens'}</h2>
    <p class="reveal mt-2 text-ink-muted" style="--reveal-delay:60ms">{ar ? 'القيم الفعلية تُقرأ من CSS الآن:' : 'Live values read from the CSS now:'} <span class="latin" data-token-live></span></p>
    <div class="reveal reveal-lg mt-6 overflow-x-auto" style="--reveal-delay:120ms">
      <table class="w-full text-sm border border-line bg-white rounded-card">
        <thead class="text-bronze text-xs uppercase tracking-wide">
          <tr><th class="text-start p-3">token</th><th class="text-start p-3">{ar ? 'القيمة' : 'value'}</th><th class="text-start p-3">{ar ? 'الاستخدام' : 'use'}</th></tr>
        </thead>
        <tbody>
          {tokens.map(([k, v, use]) => (
            <tr class="border-t border-line"><td class="p-3 latin font-semibold text-midnight" dir="ltr">{k}</td><td class="p-3 latin" dir="ltr">{v}</td><td class="p-3 text-ink-muted">{use}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="cv-auto bg-white border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="reveal text-2xl md:text-3xl font-bold text-midnight">{ar ? 'البنود الـ14' : 'The 14 items'}</h2>
      <ol class="reveal-group mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((it) => (
          <li class="bg-porcelain border border-line rounded-card p-5">
            <span class="latin text-bronze text-sm font-semibold">{String(it.n).padStart(2, '0')}</span>
            <h3 class="mt-1 font-semibold text-midnight">{it.title}</h3>
            <p class="mt-1 text-sm text-ink-muted leading-relaxed">{it.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="reveal text-2xl md:text-3xl font-bold text-midnight">{ar ? 'الأرقام' : 'Counters'}</h2>
    <Counters items={siteStats(locale)} class="mt-8 border-y border-line py-8" />
    <Divider class="mt-14" />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-14">
    <h2 class="reveal text-2xl md:text-3xl font-bold text-midnight">{ar ? 'اختيار الفرع' : 'Branch chooser'}</h2>
    <div class="mt-8"><BranchSplit locale={locale} branches={branches} /></div>
  </section>

  <section class="cv-auto bg-white border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="reveal text-2xl md:text-3xl font-bold text-midnight">{ar ? 'بطاقات الغرف (شريط على الجوال)' : 'Room cards (strip on phones)'}</h2>
      <RoomGrid locale={locale} rooms={rooms} class="mt-8" />
    </div>
  </section>

  <BranchStory locale={locale} branch={airport} />

  <section class="cv-auto mx-auto max-w-6xl px-4 pb-14">
    <h2 class="reveal text-2xl md:text-3xl font-bold text-midnight">{ar ? 'الصور المتدرجة' : 'Progressive photos'}</h2>
    <p class="reveal mt-2 text-ink-muted" style="--reveal-delay:60ms">{ar ? 'أعد تحميل الصفحة مع شبكة بطيئة لرؤية المعاينة الضبابية ثم الصورة.' : 'Reload on a slow network to see the blurred preview, then the photo.'}</p>
    <div class="reveal-group mt-6 grid gap-6 sm:grid-cols-2">
      {['cutlet-penne', 'pizza-margherita'].map((slug) => (
        <Photo
          src={`/images/dining/${slug}-800.webp`}
          srcset={`/images/dining/${slug}-800.webp 800w, /images/dining/${slug}-1400.webp 1400w`}
          sizes="(min-width: 640px) 560px, 100vw"
          alt={alts[slug]}
          width={800}
          height={600}
          lqip={lqip(`/images/dining/${slug}-800.webp`)}
          class="rounded-card"
          imgClass="w-full h-auto"
        />
      ))}
    </div>
  </section>

  <section class="cv-auto mx-auto max-w-6xl px-4 pb-14">
    <h2 class="reveal text-2xl md:text-3xl font-bold text-midnight">{ar ? 'مكوّنات المقال' : 'Article components'}</h2>
    <div class="mt-6">
      <ArticleBody locale={locale} sections={sampleSections} />
    </div>
  </section>

  <section class="cv-auto relative overflow-hidden bg-midnight text-porcelain" data-glow>
    <div class="glow" aria-hidden="true"></div>
    <div class="reveal relative mx-auto max-w-6xl px-4 py-12 flex flex-wrap items-center justify-between gap-6">
      <p class="text-xl font-semibold">{ar ? 'سطح كحلي: حرّك المؤشر هنا لرؤية التوهّج' : 'Midnight surface: move the pointer here for the glow'}</p>
      <a href={localePath(locale, '/airport-road/one-bedroom-suite/')} class="arrow-nudge inline-flex items-center gap-2 bg-bronze-deep text-white font-semibold px-6 py-3 rounded hover:bg-bronze-text transition-colors">
        <span>{ar ? 'صفحة غرفة (sticky + شريط سفلي)' : 'A room page (sticky + bottom bar)'}</span>
        <Icon name="arrow" size={18} class="icon-arrow rtl:rotate-180" />
      </a>
    </div>
  </section>
</Base>

<script>
  import { bindOnce, onPageLoad } from '@lib/client';

  onPageLoad(() => {
    const live = document.querySelector<HTMLElement>('[data-token-live]');
    if (live && bindOnce(live)) {
      const cs = getComputedStyle(document.documentElement);
      live.textContent = ['fast', 'base', 'slow', 'count', 'stagger'].map((k) => `${k} ${cs.getPropertyValue(`--motion-${k}`).trim()}`).join(' · ');
    }
    const btn = document.querySelector<HTMLButtonElement>('[data-hero-replay]');
    if (btn && bindOnce(btn)) {
      btn.addEventListener('click', () => {
        document.querySelectorAll<HTMLElement>('.hero-word, .hero-rule, .hero-sub, .hero-ctas').forEach((el) => {
          el.style.animation = 'none';
          void el.offsetWidth;
          el.style.animation = '';
        });
      });
    }
  });
</script>
