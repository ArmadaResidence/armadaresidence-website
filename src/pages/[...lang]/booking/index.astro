---
import Base from '@layouts/Base.astro';
import BookingForm from '@components/BookingForm.astro';
import { langPaths } from '@lib/paths';
import { pageSeo, ui, type Locale } from '@lib/content';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const f = ui(locale).form;
const s = pageSeo(locale, 'booking');
---

<Base locale={locale} path="/booking/" title={s.title} description={s.description} bookingDrawer={false}>
  <section class="mx-auto max-w-3xl px-4 pt-10 pb-28 sm:pb-14">
    <h1 class="text-3xl md:text-4xl font-bold text-midnight">{f.heading}</h1>
    <p class="mt-3 text-ink-muted">{f.intro}</p>
    <BookingForm locale={locale} class="reveal reveal-lg mt-8 bg-white border border-line rounded-card p-6 md:p-8" />
  </section>
</Base>
