---
import Base from '@layouts/Base.astro';
import Icon from '@components/Icon.astro';
import MarketingConsent from '@components/MarketingConsent.astro';
import { langPaths } from '@lib/paths';
import { branchContact, branchShort, branches, clubText, fill, L, localePath, marketingConsent, pageSeo, seo, ui, waHref, type Locale } from '@lib/content';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const s = pageSeo(locale, 'booking-success');
const club = clubText(locale) as ReturnType<typeof clubText> & { invite: { title: string; text: string; button: string; welcome: string } };
const clubEndpoint = (() => {
  try {
    const b = import.meta.env.PUBLIC_BOOKING_ENDPOINT ?? '';
    return b ? `${new URL(b).origin}/functions/v1/club` : '';
  } catch {
    return '';
  }
})();
// Three variants (phase 2a, DECISIONS.md 2026-10-25): ?s=confirmed → «تم تأكيد حجزك» with the price breakdown from
// sessionStorage (never from the URL); ?s=request&reason=… → the request page plus why it was not instant; otherwise
// the request page as before. WhatsApp (task 5 A, 28 Oct 2026): &wa=1 = the function said YCloud accepted the guest's
// WhatsApp message → the page says it was sent (request / confirmed sentence); without it today's sentence stays.
// Strings for the client script:
const clientData = {
  locale,
  // the confirmed variant's document title (seo.json → pages.booking-success.title_confirmed_*); requests keep s.title
  confirmed_title: L(locale, seo.pages['booking-success'] as Record<string, unknown>, 'title_confirmed'),
  quote: t.quote,
  success: { confirmed_heading: t.success.confirmed_heading, confirmed_body: t.success.confirmed_body, confirmed_steps: t.success.confirmed_steps, fallback_line: t.success.fallback_line, sold_out_race: t.success.sold_out_race, whatsapp_sent_request: t.success.whatsapp_sent_request, whatsapp_sent_confirmed: t.success.whatsapp_sent_confirmed, ref_label: t.success.ref_label, booking_ref_label: t.email.booking_ref_label },
  labels: { nights: t.form.plural.nights, branch: t.form.branch, room: t.form.room_type, check_in: t.form.check_in, check_out: t.form.check_out },
  // «انضم إلى إياب» (9 Nov 2026): the club function, the consent version the card records, its messages
  invite: { clubEndpoint, anonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '', consentVersion: marketingConsent.version, consent: club.error_consent, network: club.error_network, sending: club.sending, button: club.invite.button },
};
---

<Base locale={locale} path="/booking/success/" title={s.title} description={s.description} noindex={s.noindex}>
  <section class="mx-auto max-w-3xl px-4 pt-14 pb-20">
    <div class="reveal reveal-lg enter bg-white border border-line rounded-card p-8 md:p-10" data-success>
      <span class="inline-grid place-items-center w-12 h-12 rounded-full bg-porcelain text-bronze">
        <Icon name="check" size={26} />
      </span>
      <h1 class="mt-5 text-3xl font-bold text-midnight" data-heading>{t.success.heading}</h1>
      <p class="mt-2 text-lg text-ink-muted" data-body>{t.success.body}</p>
      <p class="hidden mt-3 text-sm font-semibold text-midnight bg-porcelain border border-line rounded px-4 py-3" data-fallback role="status"></p>
      <p class="hidden mt-4 text-sm" data-ref-wrap>
        <span class="text-ink-muted" data-ref-label>{t.success.ref_label}: </span>
        <strong class="latin text-midnight" dir="ltr" data-ref></strong>
      </p>

      {/* confirmed only: the stay and the price breakdown (filled from sessionStorage) */}
      <div class="hidden mt-6 rounded border border-line bg-porcelain p-4" data-breakdown>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-bronze-text mb-2">{t.quote.heading}</h2>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm mb-3" data-stay></dl>
        <table class="w-full text-sm">
          <tbody data-rows></tbody>
        </table>
        <p class="mt-2 text-xs text-ink-muted">{t.quote.pay_at_hotel}</p>
      </div>

      {/* «انضم إلى إياب» (Ahmed, 9 Nov 2026): only for a guest who is not a member and did not tick the booking form's
          box — the booking function hands the page a signed invite (sessionStorage, never the URL); the button joins
          with the booking's own name, phone and email once the ONE consent is ticked (source booking-page) */}
      <div class="hidden mt-6 rounded border border-line bg-porcelain p-5" data-eyab-invite data-team-hide>
        <div data-invite-form>
          <h2 class="text-lg font-bold text-midnight">{club.invite.title}</h2>
          <p class="mt-1 text-sm leading-relaxed text-ink">{club.invite.text}</p>
          <div class="mt-4">
            <MarketingConsent locale={locale} id="invite-consent" name="invite_consent" required describedBy="invite-consent-error" hook="data-invite-consent" />
            <p id="invite-consent-error" class="field-error hidden" data-invite-error></p>
          </div>
          <p class="field-error hidden mt-3" role="alert" data-invite-summary></p>
          <button type="button" class="mt-4 inline-flex items-center justify-center gap-2 bg-bronze-deep text-white font-semibold px-6 py-3 rounded hover:bg-bronze-text transition-colors disabled:opacity-60" data-invite-submit>
            <span class="spinner hidden" aria-hidden="true" data-spinner></span>
            <span data-label>{club.invite.button}</span>
          </button>
        </div>
        <p class="hidden items-center gap-2 text-lg font-semibold text-midnight" role="status" tabindex="-1" data-invite-done>
          <Icon name="check" size={22} class="text-bronze" />
          <span>{club.invite.welcome}</span>
        </p>
      </div>

      <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-bronze-text">{t.success.next_heading}</h2>
      <ol class="mt-3 space-y-3 list-decimal ps-5 leading-relaxed" data-steps>
        <li>{t.success.steps[0]}</li>
        <li>{t.success.steps[1]}</li>
        {/* 23 Oct 2026: email given → confirmation by email; no email → the reception confirms on WhatsApp */}
        <li data-next="email">{t.success.steps[2]}</li>
        <li class="hidden" data-next="whatsapp">{t.success.next_whatsapp}</li>
      </ol>
      <p class="mt-4 text-sm text-ink-muted">
        {t.success.policies_note}
        <a href={localePath(locale, '/policies/')} class="font-semibold link-bronze ms-1">{t.nav.policies}</a>.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          branches.map((b) => (
            <a
              href={waHref(branchContact(b.slug).whatsapp)}
              rel="noopener"
              target="_blank"
              class="inline-flex items-center gap-2 bg-midnight text-white font-semibold px-5 py-3 rounded hover:bg-bronze transition-colors"
              data-branch-wa={b.slug}
            >
              <Icon name="whatsapp" size={18} />
              <span>{fill(t.cta.whatsapp_branch, { branch: branchShort(locale, b.slug) })}</span>
            </a>
          ))
        }
        <a href={localePath(locale, '/')} class="inline-flex items-center gap-2 border border-line font-semibold px-5 py-3 rounded hover:bg-porcelain">
          {t.success.back_home}
        </a>
      </div>
      <script type="application/json" data-success-data set:html={JSON.stringify(clientData).replace(/</g, '\\u003c')} />
    </div>
  </section>
</Base>

<script>
  import { isTeamDevice } from '@lib/team';
  import { bindOnce, onPageLoad } from '@lib/client';
  import { money, type Quote } from '@lib/prices';
  import { adUserDataGranted, type UserData } from '@lib/user-data';
  import { plural } from '../../../../supabase/functions/booking-request/rules.ts';

  type Stash = { quote: Quote; room: string; branch: string; check_in: string; check_out: string; adults: number; children: number; breakfast: string; extra_beds: number };

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-success]');
    if (!root || !bindOnce(root)) return;
    const data = JSON.parse(root.querySelector('[data-success-data]')?.textContent || '{}');
    const L = (data.locale === 'en' ? 'en' : 'ar') as 'ar' | 'en';
    const q = new URLSearchParams(location.search);
    const ref = q.get('ref');
    const branch = q.get('branch');
    const confirmed = q.get('s') === 'confirmed';
    const reason = q.get('reason');
    const el = (sel: string) => root.querySelector<HTMLElement>(sel);

    const waSent = q.get('wa') === '1';
    if (q.get('c') === 'whatsapp') {
      el('[data-next="email"]')?.classList.add('hidden');
      el('[data-next="whatsapp"]')?.classList.remove('hidden');
    }
    if (waSent && !confirmed) {
      // the request details already reached the guest's WhatsApp: that sentence replaces today's
      const li = el('[data-next="whatsapp"]')!;
      li.textContent = data.success.whatsapp_sent_request;
      li.classList.remove('hidden');
    }
    if (ref) {
      el('[data-ref]')!.textContent = ref;
      el('[data-ref-wrap]')!.classList.remove('hidden');
    }

    let stash: Stash | null = null;
    if (confirmed && ref) {
      document.title = data.confirmed_title;
      el('[data-heading]')!.textContent = data.success.confirmed_heading;
      el('[data-body]')!.textContent = data.success.confirmed_body;
      el('[data-ref-label]')!.textContent = `${data.success.booking_ref_label}: `;
      const steps = el('[data-steps]')!;
      steps.replaceChildren(
        ...(data.success.confirmed_steps as string[]).map((s) => {
          const li = document.createElement('li');
          li.textContent = s;
          return li;
        }),
      );
      if (waSent) {
        const li = document.createElement('li');
        li.dataset.next = 'whatsapp';
        li.textContent = data.success.whatsapp_sent_confirmed;
        steps.append(li);
      }
      try {
        const raw = sessionStorage.getItem(`armada_confirmed_${ref}`);
        if (raw) stash = JSON.parse(raw) as Stash;
      } catch {
        /* storage unavailable: ref + generic text only */
      }
      if (stash?.quote) {
        const qu = stash.quote;
        const Q = data.quote;
        const dl = el('[data-stay]')!;
        const dd = (k: string, v: string) => {
          const dt = document.createElement('dt');
          dt.className = 'text-ink-muted';
          dt.textContent = k;
          const d = document.createElement('dd');
          d.className = 'font-semibold';
          d.textContent = v;
          dl.append(dt, d);
        };
        dd(data.labels.room, stash.room);
        dd(data.labels.check_in, stash.check_in);
        dd(data.labels.check_out, stash.check_out);
        const rows = el('[data-rows]')!;
        const tr = (k: string, v: string, bold = false) => {
          const r = document.createElement('tr');
          if (bold) r.className = 'border-t border-line';
          const a = document.createElement('td');
          a.className = bold ? 'pt-1.5 font-bold' : 'py-0.5';
          a.textContent = k;
          const b = document.createElement('td');
          b.className = (bold ? 'pt-1.5 font-bold text-midnight' : 'py-0.5 font-semibold') + ' text-end';
          b.textContent = v;
          r.append(a, b);
          rows.append(r);
        };
        const prices = qu.nights.map((n) => Number(n.price));
        const uniform = prices.every((p) => p === prices[0]);
        tr(Q.room_line.replace('{nights}', plural(data.labels.nights, qu.count)), uniform ? `${qu.count} × ${money(prices[0], L)} = ${money(qu.room_total ?? 0, L)}` : money(qu.room_total ?? 0, L));
        if (!uniform) for (const n of qu.nights) tr(n.night, money(Number(n.price), L));
        if (qu.breakfast === 'with' && qu.breakfast_total !== null) tr(Q.breakfast_line, money(qu.breakfast_total, L));
        if (qu.extra_beds > 0) tr(Q.extra_beds_line.replace('{beds}', String(qu.extra_beds)), money(qu.extra_beds_total, L));
        // the offer the server applied (2 Nov 2026, «العروض»): its name and discount, then the total the guest pays
        if (qu.offer && Number(qu.discount) > 0) tr(Q.offer_line.replace('{title}', L === 'en' ? qu.offer.title_en : qu.offer.title_ar), `− ${money(Number(qu.discount), L)}`);
        tr(Q.total_line, money(qu.total ?? 0, L), true);
        el('[data-breakdown]')!.classList.remove('hidden');
      }
    } else if (ref && reason) {
      // request with the reason it was not confirmed instantly (sold_out after a quote = another guest was faster)
      const text = reason === 'sold_out' ? data.success.sold_out_race : data.quote.reasons[reason];
      if (text) {
        el('[data-fallback]')!.textContent = String(data.success.fallback_line).replace('{reason}', text);
        el('[data-fallback]')!.classList.remove('hidden');
      }
    }

    if (ref) {
      // GTM (CLAUDE.md §8 step 5; DASHBOARD-SPEC §7 names; DECISIONS.md 2026-11-09 «Conversion data»): booking_confirmed
      // for an instant booking (GA4 purchase, Meta / TikTok / Snap Purchase), booking_request otherwise (Lead). Pushed
      // ONCE per booking: only while the booking form's one-shot «ticket» (sessionStorage armada_track_<ref>) exists — it
      // is deleted here and the ref remembered (localStorage armada_tracked) — so a reload, a reopened link, a new tab or
      // a shared URL never counts the booking again. value = the total shown to the guest, a number in SAR (none when
      // there was no price); transaction_id = event_id = the booking ref (Meta deduplicates a server-side copy on it);
      // user_data = the hashed email / phone, only with advertising consent (src/lib/user-data.ts). Nothing personal.
      let ticket: { s?: string; value?: number; user?: UserData } | null = null;
      let seen = false;
      try {
        seen = (JSON.parse(localStorage.getItem('armada_tracked') || '[]') as string[]).includes(ref);
      } catch {
        /* no localStorage: the ticket alone keeps it to once */
      }
      try {
        const raw = sessionStorage.getItem(`armada_track_${ref}`);
        if (raw) ticket = JSON.parse(raw);
        sessionStorage.removeItem(`armada_track_${ref}`);
      } catch {
        ticket = null;
      }
      if (ticket && !seen) {
        try {
          const done = (JSON.parse(localStorage.getItem('armada_tracked') || '[]') as string[]).filter((r) => typeof r === 'string');
          localStorage.setItem('armada_tracked', JSON.stringify([...done, ref].slice(-20)));
        } catch {
          /* no localStorage */
        }
        const isConfirmed = ticket.s === 'confirmed';
        const value = typeof ticket.value === 'number' && ticket.value > 0 ? ticket.value : null;
        const w = window as unknown as { dataLayer: unknown[] };
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({
          event: isConfirmed ? 'booking_confirmed' : 'booking_request',
          booking_ref: ref,
          transaction_id: ref,
          event_id: ref,
          branch: branch || '',
          room_type: q.get('room') || 'any',
          nights: Number(q.get('nights') || 0),
          breakfast: q.get('breakfast') === 'with' ? 'with' : q.get('breakfast') === 'without' ? 'without' : '',
          extra_beds: Math.min(2, Math.max(0, Number(q.get('beds') || 0) || 0)),
          needs_coordination: q.get('nc') === '1',
          ...(value !== null ? { value } : {}),
          currency: 'SAR',
          ...(!isConfirmed && reason ? { reason } : {}),
          // a request is a Lead (lead_type names which one); a confirmed booking is the purchase
          ...(!isConfirmed ? { lead_type: 'booking_request' } : {}),
          ...(ticket.user && adUserDataGranted() ? { user_data: ticket.user } : {}),
        });
      }
    }
    // «انضم إلى إياب» (9 Nov 2026): the card only with this booking's invite (a member or a ticked box never gets one)
    let invite = '';
    try {
      if (ref) invite = sessionStorage.getItem(`armada_invite_${ref}`) ?? '';
    } catch {
      /* storage unavailable: no card */
    }
    const card = el('[data-eyab-invite]');
    // an internal device (11 Nov 2026 — src/lib/team.ts): never the card — staff do not join a guest on the guest's behalf
    if (card && ref && !isTeamDevice() && q.get('mc') !== '1' && /^[0-9a-f-]{36}\.[0-9a-f]{32}$/.test(invite) && data.invite.clubEndpoint) {
      card.classList.remove('hidden');
      const box = card.querySelector<HTMLInputElement>('[data-invite-consent]')!;
      const err = card.querySelector<HTMLElement>('[data-invite-error]')!;
      const summary = card.querySelector<HTMLElement>('[data-invite-summary]')!;
      const btn = card.querySelector<HTMLButtonElement>('[data-invite-submit]')!;
      const showErr = (on: boolean) => {
        box.setAttribute('aria-invalid', on ? 'true' : 'false');
        err.textContent = on ? data.invite.consent : '';
        err.classList.toggle('hidden', !on);
      };
      box.addEventListener('change', () => box.checked && showErr(false));
      const busy = (on: boolean) => {
        btn.disabled = on;
        btn.querySelector('[data-spinner]')?.classList.toggle('hidden', !on);
        btn.querySelector('[data-label]')!.textContent = on ? data.invite.sending : data.invite.button;
      };
      const welcome = () => {
        card.querySelector<HTMLElement>('[data-invite-form]')!.hidden = true;
        const done = card.querySelector<HTMLElement>('[data-invite-done]')!;
        done.classList.remove('hidden');
        done.classList.add('flex');
        done.focus();
        try {
          sessionStorage.removeItem(`armada_invite_${ref}`);
        } catch {
          /* nothing kept anyway */
        }
      };
      btn.addEventListener('click', async () => {
        summary.classList.add('hidden');
        if (!box.checked) {
          showErr(true);
          box.focus();
          return;
        }
        busy(true);
        try {
          const headers: Record<string, string> = { 'Content-Type': 'application/json' };
          if (data.invite.anonKey) {
            headers['Authorization'] = `Bearer ${data.invite.anonKey}`;
            headers['apikey'] = data.invite.anonKey;
          }
          const res = await fetch(data.invite.clubEndpoint, {
            method: 'POST',
            headers,
            body: JSON.stringify({ action: 'invite-join', token: invite, consent: true, consent_version: data.invite.consentVersion, lang: L }),
          });
          if (res.status === 422) {
            const j = (await res.json().catch(() => ({}))) as { fields?: { consent?: string } };
            if (j.fields?.consent) {
              showErr(true);
              box.focus();
              return;
            }
            throw new Error('invalid');
          }
          if (!res.ok) throw new Error(String(res.status));
          const j = (await res.json().catch(() => ({}))) as { member?: boolean };
          welcome();
          // GA4 through GTM (consent mode decides, as for every event): the source and the currency (a registration, not a Lead —
          // DECISIONS.md 2026-11-09 «Conversion data»), nothing personal
          if (!j.member) (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push({ event: 'club_join', source: 'booking-page', currency: 'SAR' });
        } catch {
          summary.textContent = data.invite.network;
          summary.classList.remove('hidden');
        } finally {
          busy(false);
        }
      });
    }
    if (branch) {
      root.querySelectorAll<HTMLElement>('[data-branch-wa]').forEach((a) => {
        if (a.dataset.branchWa !== branch) a.classList.add('hidden');
      });
    }
  });
</script>
