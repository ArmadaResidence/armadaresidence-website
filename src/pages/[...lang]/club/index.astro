---
/**
 * «إياب — عضوية أرمادا ريزيدنس» / Eyab — Armada Residence membership (Ahmed, 6 Nov 2026 — DECISIONS.md 2026-11-06 «إياب»;
 * the club page of 3 Nov 2026, DECISIONS.md 2026-11-03 «Phase 2b session 5»):
 * replaces the standalone page of club.armadaresidence.com (which now redirects here with its query string — the QR
 * cards at breakfast point to it). Mobile first: on a 375 px phone the form starts above the fold (title and subtitle
 * only before it); the benefits follow it — beside it from lg. Indexable, in the sitemap, a BreadcrumbList as on the
 * other pages. Copy: content/club.json; titles: seo.json → pages.club.
 */
import Base from '@layouts/Base.astro';
import ClubForm from '@components/ClubForm.astro';
import Icon from '@components/Icon.astro';
import { langPaths } from '@lib/paths';
import { breadcrumbs } from '@lib/jsonld';
import { clubText, localePath, pageSeo, ui, type Locale } from '@lib/content';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const c = clubText(locale);
const s = pageSeo(locale, 'club');
const jsonld = [
  breadcrumbs([
    { name: t.nav.home, path: localePath(locale, '/') },
    { name: c.title, path: localePath(locale, '/club/') },
  ]),
];
---

<Base locale={locale} path="/club/" title={s.title} description={s.description} jsonld={jsonld}>
  <section class="mx-auto max-w-5xl px-4 pt-6 pb-28 sm:pt-10 sm:pb-16">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,27rem)] lg:gap-x-12 items-start">
      <header class="lg:col-start-1 lg:row-start-1">
        <h1 class="text-3xl md:text-4xl font-bold text-midnight">{c.title}</h1>
        {/* the slogan «حيّاك دايم» — the one allowed exception to Modern Standard Arabic (6 Nov 2026) */}
        <p class="mt-2 text-lg md:text-xl font-semibold text-bronze-text" data-club-slogan>{c.slogan}</p>
        <p class="mt-2 text-ink-muted leading-relaxed md:text-lg">{c.subtitle}</p>
      </header>
      <ClubForm locale={locale} class="lg:col-start-2 lg:row-start-1 lg:row-span-2" />
      <section class="lg:col-start-1 lg:row-start-2" aria-labelledby="club-benefits">
        <h2 id="club-benefits" class="text-sm font-semibold uppercase tracking-wide text-bronze-text">{c.benefits_label}</h2>
        <ul class="mt-3 grid gap-3">
          {
            c.benefits.map((b) => (
              <li class="flex items-start gap-3 text-midnight">
                <Icon name="check" size={20} class="mt-0.5 text-bronze shrink-0" />
                <span class="leading-relaxed">{b}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>
</Base>
