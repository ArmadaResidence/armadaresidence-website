---
/**
 * The club emails' unsubscribe page (3 Nov 2026): /club/unsubscribe/?t=<signed token>. On load it asks the club
 * function to withdraw the consent (offers and ads together — public.club_unsubscribe records the withdrawal) and says
 * so; a link that does not verify, or a failure, says that instead (with «حاول مرة أخرى» for a failure). noindex, out
 * of the sitemap (astro.config.mjs). Copy: club.json → unsubscribe.
 */
import Base from '@layouts/Base.astro';
import Icon from '@components/Icon.astro';
import { langPaths } from '@lib/paths';
import { clubText, localePath, pageSeo, type Locale } from '@lib/content';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = clubText(locale);
const u = c.unsubscribe;
const s = pageSeo(locale, 'club-unsubscribe');
const bookingEndpoint = import.meta.env.PUBLIC_BOOKING_ENDPOINT ?? '';
const endpoint = (() => {
  try {
    return bookingEndpoint ? `${new URL(bookingEndpoint).origin}/functions/v1/club` : '';
  } catch {
    return '';
  }
})();
const clientData = { endpoint, anonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '' };
---

<Base locale={locale} path="/club/unsubscribe/" title={s.title} description={s.description} noindex>
  <section class="mx-auto max-w-xl px-4 pt-10 pb-28 sm:pb-16" data-unsub-root>
    <h1 class="text-3xl font-bold text-midnight">{u.title}</h1>
    <div class="mt-6 bg-white border border-line rounded-card p-6" role="status" tabindex="-1" data-unsub-status>
      <p class="text-midnight leading-relaxed" data-state="working">
        <span class="spinner inline-block align-middle me-2" aria-hidden="true"></span>{u.working}
      </p>
      <div class="hidden" data-state="done">
        <Icon name="check" size={28} class="text-bronze" />
        <p class="mt-3 text-lg font-semibold text-midnight leading-relaxed">{u.done}</p>
      </div>
      <div class="hidden" data-state="invalid">
        <p class="text-midnight leading-relaxed">{u.invalid}</p>
        <a href={localePath(locale, '/contact/')} class="link-bronze inline-block mt-3 font-semibold underline underline-offset-2">{u.contact}</a>
      </div>
      <div class="hidden" data-state="failed">
        <p class="text-midnight leading-relaxed">{u.failed}</p>
        <button type="button" class="mt-4 inline-flex items-center gap-2 bg-bronze-deep text-white font-semibold px-5 py-3 rounded hover:bg-bronze-text transition-colors" data-unsub-retry>{u.retry}</button>
      </div>
      <noscript>
        <p class="mt-3 text-midnight">{u.noscript} <a href={localePath(locale, '/contact/')} class="link-bronze underline">{u.contact}</a></p>
      </noscript>
    </div>
    <script type="application/json" data-unsub-data set:html={JSON.stringify(clientData).replace(/</g, '\\u003c')} />
  </section>
</Base>

<script>
  import { bindOnce, onPageLoad } from '@lib/client';

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-unsub-root]');
    if (!root || !bindOnce(root)) return;
    const data = JSON.parse(root.querySelector('[data-unsub-data]')?.textContent || '{}') as { endpoint: string; anonKey: string };
    const status = root.querySelector<HTMLElement>('[data-unsub-status]')!;
    const show = (state: 'working' | 'done' | 'invalid' | 'failed') => {
      status.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => el.classList.toggle('hidden', el.dataset.state !== state));
      if (state !== 'working') status.focus();
    };
    const token = new URLSearchParams(location.search).get('t') ?? '';
    const run = async () => {
      if (!/^[0-9a-f-]{36}\.[0-9a-f]{32}$/.test(token)) return show('invalid');
      show('working');
      try {
        if (!data.endpoint) throw new Error('no endpoint');
        const headers: Record<string, string> = { 'Content-Type': 'application/json' };
        if (data.anonKey) {
          headers['Authorization'] = `Bearer ${data.anonKey}`;
          headers['apikey'] = data.anonKey;
        }
        const res = await fetch(data.endpoint, { method: 'POST', headers, body: JSON.stringify({ action: 'unsubscribe', token }) });
        if (res.status === 422) return show('invalid');
        if (!res.ok) throw new Error(String(res.status));
        show('done');
        (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push({ event: 'club_unsubscribe' });
      } catch {
        show('failed');
      }
    };
    root.querySelector('[data-unsub-retry]')?.addEventListener('click', () => void run());
    void run();
  });
</script>
