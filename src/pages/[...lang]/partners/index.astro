---
/** /partners/ — legacy B2B home (hero-v3, portfolio, units, bento, flow, features, built, final) with facts from content/. */
import Base from '@layouts/Base.astro';
import LpShell from '@components/lp/LpShell.astro';
import LpImg from '@components/lp/LpImg.astro';
import LpShead from '@components/lp/LpShead.astro';
import LpUnitTable from '@components/lp/LpUnitTable.astro';
import { langPaths } from '@lib/paths';
import { pageSeo, type Locale } from '@lib/content';
import { enquiryHref, ICON, lp, lpPath, T, waHrefSales } from '@lib/partners';

export const getStaticPaths = langPaths;
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = pageSeo(locale, 'partners');
const H = lp.hero;
const wa = T(locale, lp.form.wa_intro);
const features = [
  { sec: lp.umrah, img: 'umrah-room', alt: { en: 'King room — Airport Road', ar: 'غرفة كينج — طريق المطار' }, request: 'umrah-group', page: 'groups-umrah', cls: 'dkbg' },
  { sec: lp.corp, img: 'suite-living', alt: { en: 'Suite living room — Airport Road', ar: 'صالة الجناح — طريق المطار' }, request: 'corporate', page: 'corporate', cls: 'rev' },
  { sec: lp.meet, img: 'function-hall', alt: { en: 'The function hall — Airport Road', ar: 'قاعة المناسبات — طريق المطار' }, request: 'event', page: 'meetings-events', cls: 'dkbg' },
];
---

<Base locale={locale} path="/partners/" title={s.title} description={s.description}>
  <LpShell locale={locale}>
    <section class="hero hero-v3">
      <div class="bg" data-depth="0.05"><LpImg name="airport-exterior" alt={T(locale, lp.props.airport.alt)} loading="eager" /></div>
      <div class="scrim"></div>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-copy">
        <p class="hero-brand">{T(locale, H.brand)}</p>
        <h1>{T(locale, H.h1)}</h1>
        <p class="sub">{T(locale, H.sub)}</p>
        <div class="cta">
          <a class="btn" href={lpPath(locale, 'enquiry')}>{T(locale, H.cta1)}</a>
          <a class="btn gh" href="#hotels">{T(locale, H.cta2)}</a>
        </div>
        <p class="hero-meta">{T(locale, H.meta)}</p>
      </div>
    </section>

    <section class="strip">
      <div class="wrap">
        {
          (lp.hero_stats as any[]).map((x) => (
            <div class="it">
              <b>{x.n}</b>
              <i>{T(locale, x.label)}</i>
              <span>{T(locale, x.sub)}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="band portfolio" id="hotels">
      <div class="wrap">
        <LpShead eyebrow={T(locale, { en: 'Our hotels', ar: 'فنادقنا' })} h2={T(locale, lp.proposition.h2)} sub={T(locale, lp.proposition.body)} />
        {
          (lp.portfolio as any[]).map(([key, label, name, facts, cta], i) => {
            const p = lp.props[key];
            return (
              <article class:list={['pf rv', i % 2 && 'rev']} id={`pf-${key}`}>
                <div class="pf-img"><LpImg name={p.img} alt={T(locale, p.alt)} /></div>
                <div class="pf-body">
                  <p class="pf-label">{T(locale, label)}</p>
                  <h3>{T(locale, name)}</h3>
                  <ul class="pf-facts">{(facts as any[]).map((f) => <li>{T(locale, f)}</li>)}</ul>
                  <div class="acts">
                    <a class="btn dk" href={key === 'airport' ? '/airport-road/' : '/shafa-road/'} set:html={ICON.arrow + T(locale, cta)} />
                    <a class="btn ol" href={enquiryHref(locale, 'b2b-rates', key === 'airport' ? 'airport-road' : 'shafa-road')}>{T(locale, lp.ui.req_rates)}</a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <section class="band dk" id="units">
      <div class="wrap">
        <LpShead eyebrow={T(locale, { en: 'The unit collection', ar: 'مجموعة الوحدات' })} h2={T(locale, { en: 'Eight ways to place a guest, across two hotels.', ar: 'ثماني طرق لتسكين الضيف، في فندقين.' })} />
        <LpUnitTable locale={locale} />
      </div>
    </section>

    <section class="band" id="solutions">
      <div class="wrap">
        <LpShead eyebrow={T(locale, lp.why.eyebrow)} h2={T(locale, lp.why.h2)} />
        <div class="bento mt-m">
          {
            (lp.why.items as any[]).map(([ti, bo, cls]) => (
              <div class:list={['bt rv', cls]}>
                <h3>{T(locale, ti)}</h3>
                <p>{T(locale, bo)}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band alt">
      <div class="wrap flow-wrap">
        <LpShead eyebrow={T(locale, lp.flow.eyebrow)} h2={T(locale, lp.flow.h2)} />
        <ol class="flow">
          {
            (lp.flow.steps as any[]).map(([ti, bo], i) => (
              <li class="rv">
                <span class="fn">0{i + 1}</span>
                <div>
                  <h3>{T(locale, ti)}</h3>
                  <p>{T(locale, bo)}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {
      features.map((f) => (
        <section class:list={['feat-sec', f.cls]}>
          <div class="feat-img"><LpImg name={f.img} alt={T(locale, f.alt)} /></div>
          <div class="feat-body rv">
            <p class="eyebrow" set:html={T(locale, f.sec.eyebrow)} />
            <h2 set:html={T(locale, f.sec.h2)} />
            <p class="lede">{T(locale, f.sec.body)}</p>
            <ul class="dash">{(f.sec.list as any[]).map((x) => <li>{T(locale, x)}</li>)}</ul>
            <div class="acts">
              <a class="btn" href={enquiryHref(locale, f.request)} set:html={ICON.arrow + T(locale, f.sec.cta)} />
              <a class="btn gh" href={lpPath(locale, f.page)}>{T(locale, lp.ui.learn_more_v3)}</a>
            </div>
          </div>
        </section>
      ))
    }

    <section class="band built">
      <div class="wrap rv">
        <h2>{T(locale, lp.built.h2)}</h2>
        <p>{T(locale, lp.built.body)}</p>
        <div class="built-nums">
          {
            (lp.hero_stats as any[]).map((x) => (
              <div>
                <b>{x.n}</b>
                <span>{T(locale, x.label)} — {T(locale, x.sub)}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="final">
      <div class="bg"><LpImg name="shafa-exterior" alt={T(locale, lp.props.shafa.alt)} /></div>
      <div class="scrim"></div>
      <div class="wrap rv">
        <h2>{T(locale, lp.final.h2)}</h2>
        <p>{T(locale, lp.final.body)}</p>
        <div class="acts">
          <a class="btn" href={lpPath(locale, 'enquiry')}>{T(locale, lp.ui.req_b2b)}</a>
          <a class="btn gh" href={waHrefSales(wa)} target="_blank" rel="noopener" set:html={ICON.wa + T(locale, lp.ui.whatsapp)} />
          <a class="btn gh" href={`mailto:${lp.contact.email}`} set:html={ICON.mail + T(locale, lp.ui.email_sales)} />
        </div>
      </div>
    </section>
  </LpShell>
</Base>
