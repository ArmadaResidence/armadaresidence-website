---
/**
 * /partners/enquiry/ — legacy three-step wizard; the message now goes to the Edge Function (request_type) with
 * WhatsApp/email as fallbacks. Behaviour in src/lib/partners-enquiry.ts (26 Oct 2026): the contact fields follow the
 * booking form's rules (rules.ts), a saved draft is restored only with a visible notice and a clear button.
 */
import Base from '@layouts/Base.astro';
import LpShell from '@components/lp/LpShell.astro';
import LpPageHero from '@components/lp/LpPageHero.astro';
import DateRangeField from '@components/DateRangeField.astro';
import PhoneField from '@components/PhoneField.astro';
import '../../../styles/partners-phone.css';
import { langPaths } from '@lib/paths';
import { pageSeo, type Locale } from '@lib/content';
import { ICON, lp, T, waHrefSales } from '@lib/partners';
import { ui } from '@lib/content';

export const getStaticPaths = langPaths;
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = pageSeo(locale, 'partners-enquiry');
const F = lp.form;
const fl = F.fields;
const ct = lp.contact;
const wa = T(locale, F.wa_intro);
const req = T(locale, lp.ui.required);
const badEmail = T(locale, lp.ui.bad_email);
const sel = T(locale, { en: 'Select', ar: 'اختر' });
// inline messages: name / email as in the booking form (ui.json), company / phone for this form (partners-pages.json)
const E = ui(locale).form.errors;
const strings = {
  required: req,
  organisation: T(locale, F.errors.company),
  name: E.name,
  phone: T(locale, F.errors.phone),
  email: E.email,
};
---

<Base locale={locale} path="/partners/enquiry/" title={s.title} description={s.description}>
  <LpShell locale={locale}>
    <LpPageHero
      locale={locale}
      eyebrow={T(locale, F.eyebrow)}
      h1={T(locale, F.h1)}
      lead={T(locale, F.lead)}
      img="airport-exterior"
      alt={T(locale, lp.props.airport.alt)}
      crumb={T(locale, { en: 'Contact Sales', ar: 'تواصل مع المبيعات' })}
    />

    <section class="band">
      <div class="wrap">
        <div class="grid cols64">
          <div class="rv">
            <div class="note sent" id="enquiry-sent" hidden>
              <b id="enquiry-sent-title"></b>
              <p id="enquiry-sent-body" style="margin-top:8px"></p>
              <p style="margin-top:8px"><span id="enquiry-sent-ref-label"></span>: <b id="enquiry-sent-ref" dir="ltr"></b></p>
            </div>
            <form class="frm" id="enquiry-form" novalidate>
              <script type="application/json" data-enquiry-strings set:html={JSON.stringify(strings).replace(/</g, '\\u003c')} />
              {/* a restored draft is never silent (26 Oct 2026) */}
              <div class="note lt draft-note" data-draft-notice role="status" hidden>
                <span>{T(locale, F.draft.notice)}</span>
                <button type="button" class="btn ol" data-draft-clear>{T(locale, F.draft.clear)}</button>
              </div>
              <div class="psteps">
                {
                  (F.steps as any[]).map((st, i) => (
                    <div class:list={['pstep', i === 0 && 'on']}>
                      <div class="bar"></div>
                      <span>{T(locale, st)}</span>
                    </div>
                  ))
                }
              </div>

              <div class="fstep on">
                <div class="row c2">
                  <div class="fld"><label for="f-company">{T(locale, fl.company)}<span class="req">*</span></label><input type="text" id="f-company" name="company" required autocomplete="organization" maxlength="160" aria-describedby="f-company-err" /><p class="err" id="f-company-err">{req}</p></div>
                  <div class="fld"><label for="f-person">{T(locale, fl.person)}<span class="req">*</span></label><input type="text" id="f-person" name="person" required autocomplete="name" autocapitalize="words" spellcheck="false" maxlength="120" aria-describedby="f-person-err" /><p class="err" id="f-person-err">{req}</p></div>
                </div>
                <div class="row c2">
                  <div class="fld"><label for="f-email">{T(locale, fl.email)}<span class="req">*</span></label><input type="email" id="f-email" name="email" required dir="ltr" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" aria-describedby="f-email-err" /><p class="err" id="f-email-err">{badEmail}</p></div>
                  {/* the shared phone field with the country selector (28 Oct 2026): hidden `phone_country` carries the ISO
                      code — independent of the business «country» field below */}
                  <PhoneField locale={locale} variant="partners" id="f-phone" name="phone" countryName="phone_country" label={T(locale, fl.phone)} errorText={req} />
                </div>
                {/* Honeypot: invisible to people and assistive tech; a bot that fills it gets a fake success and nothing is stored. */}
                <div style="position:absolute;inset-inline-start:-9999px;width:1px;height:1px;overflow:hidden" aria-hidden="true">
                  <label for="f-website">Website</label><input type="text" id="f-website" name="website" tabindex="-1" autocomplete="off" />
                </div>
                <div class="row c2">
                  <div class="fld"><label for="f-country">{T(locale, fl.country)}</label><input type="text" id="f-country" name="country" autocomplete="country-name" maxlength="60" /><p class="err">{req}</p></div>
                  <div class="fld">
                    <label for="f-biztype">{T(locale, fl.biztype)}<span class="req">*</span></label>
                    <select id="f-biztype" name="biztype" autocomplete="off" required>
                      <option value="">— {sel} —</option>
                      {(F.biztypes as any[]).map(([k, l]) => <option value={k}>{T(locale, l)}</option>)}
                    </select>
                    <p class="err">{req}</p>
                  </div>
                </div>
              </div>

              <div class="fstep">
                <div class="row c2">
                  <div class="fld">
                    <label for="f-reqtype">{T(locale, fl.reqtype)}<span class="req">*</span></label>
                    <select id="f-reqtype" name="reqtype" autocomplete="off" required>
                      <option value="">— {sel} —</option>
                      {(F.reqtypes as any[]).map(([k, l]) => <option value={k}>{T(locale, l)}</option>)}
                    </select>
                    <p class="err">{req}</p>
                  </div>
                  <div class="fld">
                    <label for="f-property">{T(locale, fl.property)}</label>
                    <select id="f-property" name="property" autocomplete="off">
                      <option value="">— {sel} —</option>
                      {(F.properties as any[]).map(([k, l]) => <option value={k}>{T(locale, l)}</option>)}
                    </select>
                    <p class="err">{req}</p>
                  </div>
                </div>
                <div class="row c2">
                  <div class="fld"><label for="f-unittype">{T(locale, fl.unittype)}</label><input type="text" id="f-unittype" name="unittype" autocomplete="off" placeholder={T(locale, F.unittype_placeholder)} /><p class="err">{req}</p></div>
                  <div class="fld">
                    <label for="f-meals">{T(locale, fl.meals)}</label>
                    <select id="f-meals" name="meals" autocomplete="off">
                      <option value="">— {sel} —</option>
                      {(F.meal_opts as any[]).map(([k, l]) => <option value={k}>{T(locale, l)}</option>)}
                    </select>
                    <p class="err">{req}</p>
                  </div>
                </div>
                <div class="row">
                  <div class="fld"><label for="f-notes">{T(locale, fl.notes)}</label><textarea id="f-notes" name="notes" autocomplete="off" placeholder={T(locale, F.placeholder_notes)}></textarea></div>
                </div>
              </div>

              <div class="fstep">
                {/* calendar range picker, same component and rules as the booking form (23 Oct 2026) */}
                <DateRangeField
                  locale={locale}
                  variant="partners"
                  names={['checkin', 'checkout']}
                  ids={['f-checkin', 'f-checkout']}
                  labels={[T(locale, fl.checkin), T(locale, fl.checkout)]}
                  errorText={req}
                />
                <div class="row c2">
                  <div class="fld"><label for="f-guests">{T(locale, fl.guests)}<span class="req">*</span></label><input type="number" id="f-guests" name="guests" autocomplete="off" min="1" inputmode="numeric" required /><p class="err">{req}</p></div>
                  <div class="fld"><label for="f-rooms">{T(locale, fl.rooms)}</label><input type="number" id="f-rooms" name="rooms" autocomplete="off" min="1" inputmode="numeric" /><p class="err">{req}</p></div>
                </div>
                <p class="sla"><Fragment set:html={ICON.clock} />{T(locale, lp.ui.sla)}</p>
              </div>

              <div class="fnav">
                <button type="button" class="btn ol f-back">{T(locale, lp.ui.back)}</button>
                <button type="button" class="btn f-next">{T(locale, lp.ui.next)}</button>
                <button type="submit" class="btn f-send" style="display:none">{T(locale, F.send)}</button>
                <button type="button" class="btn ol f-wa" style="display:none"><Fragment set:html={ICON.wa} />{T(locale, lp.ui.send_wa)}</button>
                <button type="button" class="btn ol f-mail" style="display:none"><Fragment set:html={ICON.mail} />{T(locale, lp.ui.send_mail)}</button>
              </div>
              <p class="err" id="enquiry-error" style="display:none"></p>
            </form>
          </div>

          <aside class="rv">
            <p class="eyebrow">{T(locale, F.direct_lines)}</p>
            <div class="feats" style="grid-template-columns:1fr;margin-top:14px">
              {
                ct.show_name && (
                  <div class="feat">
                    <b>{T(locale, ct.sales_manager_title)}</b>
                    <span dir="ltr">{ct.sales_manager}</span>
                  </div>
                )
              }
              <a class="feat" href={waHrefSales(wa)} target="_blank" rel="noopener">
                <b>{T(locale, lp.ui.whatsapp)}</b>
                <span dir="ltr">{ct.phone_display}</span>
              </a>
              <a class="feat" href={`mailto:${ct.email}`}>
                <b>{T(locale, lp.ui.email_sales)}</b>
                <span dir="ltr">{ct.email}</span>
              </a>
              <a class="feat" href={`mailto:${ct.reservations}`}>
                <b>{T(locale, { en: 'Reservations', ar: 'الحجوزات' })}</b>
                <span dir="ltr">{ct.reservations}</span>
              </a>
              <a class="feat" href={ct.linktree} target="_blank" rel="noopener">
                <b>{T(locale, { en: 'Follow us', ar: 'تابعنا' })}</b>
                <span dir="ltr">linktr.ee/ArmadaR</span>
              </a>
            </div>
            <div class="note lt" style="margin-top:18px" set:html={T(locale, F.what_to_send)} />
            <p class="eyebrow" style="margin-top:22px">{T(locale, F.our_addresses)}</p>
            <div class="feats" style="grid-template-columns:1fr;margin-top:12px">
              <div class="feat"><b>{T(locale, lp.props.airport.name)}</b><span>{T(locale, lp.address.airport)}</span></div>
              <div class="feat"><b>{T(locale, lp.props.shafa.name)}</b><span>{T(locale, lp.address.shafa)}</span></div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </LpShell>
</Base>

<script>
  import { initEnquiry } from '@lib/partners-enquiry';
  initEnquiry();
</script>
