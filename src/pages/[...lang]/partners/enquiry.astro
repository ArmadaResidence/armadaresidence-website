---
/** /partners/enquiry/ — legacy three-step wizard; the message now goes to the Edge Function (request_type) with WhatsApp/email as fallbacks. */
import Base from '@layouts/Base.astro';
import LpShell from '@components/lp/LpShell.astro';
import LpPageHero from '@components/lp/LpPageHero.astro';
import { langPaths } from '@lib/paths';
import { pageSeo, type Locale } from '@lib/content';
import { ICON, lp, T, waHrefSales } from '@lib/partners';

export const getStaticPaths = langPaths;
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = pageSeo(locale, 'partners-enquiry');
const F = lp.form;
const fl = F.fields;
const ct = lp.contact;
const wa = T(locale, F.wa_intro);
const req = T(locale, lp.ui.required);
const badEmail = T(locale, lp.ui.bad_email);
const sel = T(locale, { en: 'Select', ar: 'اختر' });
---

<Base locale={locale} path="/partners/enquiry/" title={s.title} description={s.description}>
  <LpShell locale={locale}>
    <LpPageHero
      locale={locale}
      eyebrow={T(locale, F.eyebrow)}
      h1={T(locale, F.h1)}
      lead={T(locale, F.lead)}
      img="airport-exterior"
      alt={T(locale, lp.props.airport.alt)}
      crumb={T(locale, { en: 'Contact Sales', ar: 'تواصل مع المبيعات' })}
    />

    <section class="band">
      <div class="wrap">
        <div class="grid cols64">
          <div class="rv">
            <div class="note sent" id="enquiry-sent" hidden>
              <b id="enquiry-sent-title"></b>
              <p id="enquiry-sent-body" style="margin-top:8px"></p>
              <p style="margin-top:8px"><span id="enquiry-sent-ref-label"></span>: <b id="enquiry-sent-ref" dir="ltr"></b></p>
            </div>
            <form class="frm" id="enquiry-form" novalidate>
              <div class="psteps">
                {
                  (F.steps as any[]).map((st, i) => (
                    <div class:list={['pstep', i === 0 && 'on']}>
                      <div class="bar"></div>
                      <span>{T(locale, st)}</span>
                    </div>
                  ))
                }
              </div>

              <div class="fstep on">
                <div class="row c2">
                  <div class="fld"><label for="f-company">{T(locale, fl.company)}<span class="req">*</span></label><input type="text" id="f-company" name="company" required /><p class="err">{req}</p></div>
                  <div class="fld"><label for="f-person">{T(locale, fl.person)}<span class="req">*</span></label><input type="text" id="f-person" name="person" required /><p class="err">{req}</p></div>
                </div>
                <div class="row c2">
                  <div class="fld"><label for="f-email">{T(locale, fl.email)}<span class="req">*</span></label><input type="email" id="f-email" name="email" required dir="ltr" inputmode="email" /><p class="err">{badEmail}</p></div>
                  <div class="fld"><label for="f-phone">{T(locale, fl.phone)}<span class="req">*</span></label><input type="tel" id="f-phone" name="phone" required dir="ltr" inputmode="tel" /><p class="err">{req}</p></div>
                </div>
                <div class="row c2">
                  <div class="fld"><label for="f-country">{T(locale, fl.country)}</label><input type="text" id="f-country" name="country" /><p class="err">{req}</p></div>
                  <div class="fld">
                    <label for="f-biztype">{T(locale, fl.biztype)}<span class="req">*</span></label>
                    <select id="f-biztype" name="biztype" required>
                      <option value="">— {sel} —</option>
                      {(F.biztypes as any[]).map(([k, l]) => <option value={k}>{T(locale, l)}</option>)}
                    </select>
                    <p class="err">{req}</p>
                  </div>
                </div>
              </div>

              <div class="fstep">
                <div class="row c2">
                  <div class="fld">
                    <label for="f-reqtype">{T(locale, fl.reqtype)}<span class="req">*</span></label>
                    <select id="f-reqtype" name="reqtype" required>
                      <option value="">— {sel} —</option>
                      {(F.reqtypes as any[]).map(([k, l]) => <option value={k}>{T(locale, l)}</option>)}
                    </select>
                    <p class="err">{req}</p>
                  </div>
                  <div class="fld">
                    <label for="f-property">{T(locale, fl.property)}</label>
                    <select id="f-property" name="property">
                      <option value="">— {sel} —</option>
                      {(F.properties as any[]).map(([k, l]) => <option value={k}>{T(locale, l)}</option>)}
                    </select>
                    <p class="err">{req}</p>
                  </div>
                </div>
                <div class="row c2">
                  <div class="fld"><label for="f-unittype">{T(locale, fl.unittype)}</label><input type="text" id="f-unittype" name="unittype" placeholder={T(locale, F.unittype_placeholder)} /><p class="err">{req}</p></div>
                  <div class="fld">
                    <label for="f-meals">{T(locale, fl.meals)}</label>
                    <select id="f-meals" name="meals">
                      <option value="">— {sel} —</option>
                      {(F.meal_opts as any[]).map(([k, l]) => <option value={k}>{T(locale, l)}</option>)}
                    </select>
                    <p class="err">{req}</p>
                  </div>
                </div>
                <div class="row">
                  <div class="fld"><label for="f-notes">{T(locale, fl.notes)}</label><textarea id="f-notes" name="notes" placeholder={T(locale, F.placeholder_notes)}></textarea></div>
                </div>
              </div>

              <div class="fstep">
                <div class="row c2">
                  <div class="fld"><label for="f-checkin">{T(locale, fl.checkin)}<span class="req">*</span></label><input type="date" id="f-checkin" name="checkin" required /><p class="err">{req}</p></div>
                  <div class="fld"><label for="f-checkout">{T(locale, fl.checkout)}<span class="req">*</span></label><input type="date" id="f-checkout" name="checkout" required /><p class="err">{req}</p></div>
                </div>
                <div class="row c2">
                  <div class="fld"><label for="f-guests">{T(locale, fl.guests)}<span class="req">*</span></label><input type="number" id="f-guests" name="guests" min="1" inputmode="numeric" required /><p class="err">{req}</p></div>
                  <div class="fld"><label for="f-rooms">{T(locale, fl.rooms)}</label><input type="number" id="f-rooms" name="rooms" min="1" inputmode="numeric" /><p class="err">{req}</p></div>
                </div>
                <p class="sla"><Fragment set:html={ICON.clock} />{T(locale, lp.ui.sla)}</p>
              </div>

              <div class="fnav">
                <button type="button" class="btn ol f-back">{T(locale, lp.ui.back)}</button>
                <button type="button" class="btn f-next">{T(locale, lp.ui.next)}</button>
                <button type="submit" class="btn f-send" style="display:none">{T(locale, F.send)}</button>
                <button type="button" class="btn ol f-wa" style="display:none"><Fragment set:html={ICON.wa} />{T(locale, lp.ui.send_wa)}</button>
                <button type="button" class="btn ol f-mail" style="display:none"><Fragment set:html={ICON.mail} />{T(locale, lp.ui.send_mail)}</button>
              </div>
              <p class="err" id="enquiry-error" style="display:none"></p>
            </form>
          </div>

          <aside class="rv">
            <p class="eyebrow">{T(locale, F.direct_lines)}</p>
            <div class="feats" style="grid-template-columns:1fr;margin-top:14px">
              {
                ct.show_name && (
                  <div class="feat">
                    <b>{T(locale, ct.sales_manager_title)}</b>
                    <span dir="ltr">{ct.sales_manager}</span>
                  </div>
                )
              }
              <a class="feat" href={waHrefSales(wa)} target="_blank" rel="noopener">
                <b>{T(locale, lp.ui.whatsapp)}</b>
                <span dir="ltr">{ct.phone_display}</span>
              </a>
              <a class="feat" href={`mailto:${ct.email}`}>
                <b>{T(locale, lp.ui.email_sales)}</b>
                <span dir="ltr">{ct.email}</span>
              </a>
              <a class="feat" href={`mailto:${ct.reservations}`}>
                <b>{T(locale, { en: 'Reservations', ar: 'الحجوزات' })}</b>
                <span dir="ltr">{ct.reservations}</span>
              </a>
              <a class="feat" href={ct.linktree} target="_blank" rel="noopener">
                <b>{T(locale, { en: 'Follow us', ar: 'تابعنا' })}</b>
                <span dir="ltr">linktr.ee/ArmadaR</span>
              </a>
            </div>
            <div class="note lt" style="margin-top:18px" set:html={T(locale, F.what_to_send)} />
            <p class="eyebrow" style="margin-top:22px">{T(locale, F.our_addresses)}</p>
            <div class="feats" style="grid-template-columns:1fr;margin-top:12px">
              <div class="feat"><b>{T(locale, lp.props.airport.name)}</b><span>{T(locale, lp.address.airport)}</span></div>
              <div class="feat"><b>{T(locale, lp.props.shafa.name)}</b><span>{T(locale, lp.address.shafa)}</span></div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </LpShell>
</Base>
