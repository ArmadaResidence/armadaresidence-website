---
import Base from '@layouts/Base.astro';
import BranchSplit from '@components/BranchSplit.astro';
import Counters from '@components/Counters.astro';
import Divider from '@components/Divider.astro';
import Icon from '@components/Icon.astro';
import HomeBlog from '@components/home/HomeBlog.astro';
import HomeClub from '@components/home/HomeClub.astro';
import HomeDining from '@components/home/HomeDining.astro';
import HomeGallery from '@components/home/HomeGallery.astro';
import HomeOffers from '@components/home/HomeOffers.astro';
import HomePlaces from '@components/home/HomePlaces.astro';
import HomeReviews from '@components/home/HomeReviews.astro';
import HomeRooms from '@components/home/HomeRooms.astro';
import { langPaths } from '@lib/paths';
import { organization } from '@lib/jsonld';
import { existsSync, readFileSync } from 'node:fs';
import {
  branches,
  cancellationText,
  fill,
  localePath,
  media,
  pageSeo,
  paragraphs,
  policies,
  siteStats,
  siteTexts,
  ui,
  withFacts,
  type Locale,
} from '@lib/content';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const s = pageSeo(locale, 'home');
const hero = siteTexts.hero;

// Hero (specs approved 30 Oct 2026): content/images/hero/hero.json, written by scripts/photos-import.mjs with the files
// (synced to public/images/ by build.py). The poster is the LCP — <picture> with a 4:5 crop for phones and 16:9 for
// wider screens, AVIF then WebP, eager + fetchpriority high + preloaded; the loop (desktop only, after `load`, never
// with reduced motion / Save-Data) fades in over it once it plays. Until the files arrive the grey placeholder acts as
// poster with a slow Ken Burns move. TODO(photo)
const heroDir = new URL('../../../content/images/hero/', import.meta.url);
interface HeroImage { base: string; widths: number[]; width: number; height: number; position: string }
/** the hero scrim measured at build time on the picture (photos-engine heroScrim) — absent: the CSS default */
interface HeroScrim { m: number; md: number; lg_rtl: number; lg_ltr: number }
interface HeroSlide { poster: HeroImage; poster_mobile: HeroImage; alt_ar: string; alt_en: string; scrim?: HeroScrim }
interface HeroMedia {
  mode?: 'video' | 'still' | 'photos';
  poster: HeroImage;
  poster_mobile: HeroImage;
  video?: { mp4: string; webm: string; mobile_mp4?: string; mobile_webm?: string };
  alt_ar: string;
  alt_en: string;
  scrim?: HeroScrim;
  /** «صور متتابعة» (6 Nov 2026): 3–8 photos, the first = poster above */
  slides?: HeroSlide[];
}
// the dashboard «الصور» (1 Nov 2026): a published hero (media.generated.json) comes first, then the imported one
const heroMedia: HeroMedia | null = media.home?.poster
  ? (media.home as HeroMedia)
  : existsSync(new URL('hero.json', heroDir))
    ? (JSON.parse(readFileSync(new URL('hero.json', heroDir), 'utf8')) as HeroMedia)
    : null;
const heroSet = (img: HeroImage, ext: string) => img.widths.map((w) => `${img.base}-${w}.${ext} ${w}w`).join(', ');
const HERO_MOBILE = '(max-width: 767px)';
const heroSlides = heroMedia?.mode === 'photos' && heroMedia.slides && heroMedia.slides.length > 1 ? heroMedia.slides : null;
const scrimStyle = (sc?: HeroScrim) => (sc ? `--scrim-m:${sc.m};--scrim-md:${sc.md};--scrim-lg-rtl:${sc.lg_rtl};--scrim-lg-ltr:${sc.lg_ltr}` : '');
const posStyle = (sl: { poster: HeroImage; poster_mobile: HeroImage }) => `--hero-pos:${sl.poster.position};--hero-pos-m:${sl.poster_mobile.position}`;
const altOf = (sl: { alt_ar: string; alt_en: string }) => (locale === 'ar' ? sl.alt_ar : sl.alt_en);
/** a transparent pixel: the src of a slideshow photo until the script loads it (after the page's load event) */
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
// og/home.jpg: the poster's 1200 × 630 crop written by scripts/photos-import.mjs; absent → the default OG image
const homeOg = media.home?.og_image ?? (existsSync(new URL('../og/home.jpg', heroDir)) ? '/images/og/home.jpg' : undefined);
const heroPosterAlt = fill(t.photo_pending_alt, { subject: locale === 'ar' ? hero.title_ar : hero.title_en });
const about = siteTexts.about;
const why = siteTexts.why_armada;
const heroCopy = hero as typeof hero & { eyebrow_ar: string; eyebrow_en: string };
// Hero choreography (item 3, 11 Oct 2026): the slogan appears word by word (50 ms apart), the bronze rule is drawn
// from the start side, then the subtitle and the buttons follow. Pure CSS animations (motion.css) — they replay on
// every visit to the home page and collapse to the final state under prefers-reduced-motion.
const heroTitle = locale === 'ar' ? hero.title_ar : hero.title_en;
const heroWords = heroTitle.split(/\s+/).filter(Boolean);
const heroRuleDelay = heroWords.length * 50; // ms: the rule starts when the last word has started
const quickFacts = fill(t.home.quick_facts, {
  check_in: locale === 'ar' ? policies.check_in_ar : policies.check_in_en,
  check_out: locale === 'ar' ? policies.check_out_ar : policies.check_out_en,
  // the short line of the one cancellation policy (policies.json → cancellation, 6 Nov 2026)
  cancellation: cancellationText(locale, 'short'),
});
---

<Base locale={locale} path="/" title={s.title} description={s.description} ogImage={homeOg} jsonld={[organization(locale)]}>
  {
    heroMedia && (
      <Fragment slot="head">
        <link rel="preload" as="image" type="image/avif" media={HERO_MOBILE} imagesrcset={heroSet(heroMedia.poster_mobile, 'avif')} imagesizes="100vw" fetchpriority="high" />
        <link rel="preload" as="image" type="image/avif" media="(min-width: 768px)" imagesrcset={heroSet(heroMedia.poster, 'avif')} imagesizes="100vw" fetchpriority="high" />
      </Fragment>
    )
  }
  <section class="hero relative bg-midnight text-porcelain overflow-hidden lg:min-h-[560px] flex items-center" data-glow>
    <div class="absolute inset-0" aria-hidden={heroMedia ? undefined : 'true'}>
      {
        heroSlides ? (
          // «صور متتابعة» (6 Nov 2026): the first photo is the LCP image (eager, preloaded, high priority); the others
          // carry their sources as data-* and are loaded by the script after the page's load event, one ahead. Only the
          // photos change (7 Nov 2026): the scrim and the text are one fixed layer above them; each photo carries its
          // measured scrim as data-scrim, which the script hands to that layer when the photo comes in
          <div class="absolute inset-0 hero-show" data-hero-show>
            {heroSlides.map((sl, i) => (
              <div class:list={['hero-slide', i === 0 && 'is-active']} data-hero-slide={i} aria-hidden={i === 0 ? undefined : 'true'} data-scrim={sl.scrim ? [sl.scrim.m, sl.scrim.md, sl.scrim.lg_rtl, sl.scrim.lg_ltr].join(',') : undefined} style={posStyle(sl)}>
                <picture>
                  {i === 0 ? (
                    <>
                      <source media={HERO_MOBILE} type="image/avif" srcset={heroSet(sl.poster_mobile, 'avif')} sizes="100vw" />
                      <source media={HERO_MOBILE} type="image/webp" srcset={heroSet(sl.poster_mobile, 'webp')} sizes="100vw" />
                      <source type="image/avif" srcset={heroSet(sl.poster, 'avif')} sizes="100vw" />
                    </>
                  ) : (
                    <>
                      <source media={HERO_MOBILE} type="image/avif" data-srcset={heroSet(sl.poster_mobile, 'avif')} sizes="100vw" />
                      <source media={HERO_MOBILE} type="image/webp" data-srcset={heroSet(sl.poster_mobile, 'webp')} sizes="100vw" />
                      <source type="image/avif" data-srcset={heroSet(sl.poster, 'avif')} sizes="100vw" />
                    </>
                  )}
                  {i === 0 ? (
                    <img
                      class="hero-media hero-photo"
                      src={`${sl.poster.base}-${sl.poster.widths[Math.min(1, sl.poster.widths.length - 1)]}.webp`}
                      srcset={heroSet(sl.poster, 'webp')}
                      sizes="100vw"
                      width={sl.poster.width}
                      height={sl.poster.height}
                      alt={altOf(sl)}
                      loading="eager"
                      fetchpriority="high"
                    />
                  ) : (
                    <img
                      class="hero-media hero-photo"
                      src={BLANK}
                      data-src={`${sl.poster.base}-${sl.poster.widths[Math.min(1, sl.poster.widths.length - 1)]}.webp`}
                      data-srcset={heroSet(sl.poster, 'webp')}
                      sizes="100vw"
                      width={sl.poster.width}
                      height={sl.poster.height}
                      alt={altOf(sl)}
                      decoding="async"
                    />
                  )}
                </picture>
              </div>
            ))}
          </div>
        ) : heroMedia ? (
          <>
            <picture>
              <source media={HERO_MOBILE} type="image/avif" srcset={heroSet(heroMedia.poster_mobile, 'avif')} sizes="100vw" />
              <source media={HERO_MOBILE} type="image/webp" srcset={heroSet(heroMedia.poster_mobile, 'webp')} sizes="100vw" />
              <source type="image/avif" srcset={heroSet(heroMedia.poster, 'avif')} sizes="100vw" />
              <img
                class:list={['hero-media hero-photo', !heroMedia.video && 'hero-kenburns']}
                src={`${heroMedia.poster.base}-${heroMedia.poster.widths[Math.min(1, heroMedia.poster.widths.length - 1)]}.webp`}
                srcset={heroSet(heroMedia.poster, 'webp')}
                sizes="100vw"
                width={heroMedia.poster.width}
                height={heroMedia.poster.height}
                alt={altOf(heroMedia)}
                loading="eager"
                fetchpriority="high"
                style={posStyle(heroMedia)}
              />
            </picture>
            {heroMedia.video && (
              <video
                class="hero-media hero-video"
                muted
                loop
                playsinline
                disablepictureinpicture
                preload="none"
                data-webm={heroMedia.video.webm}
                data-mp4={heroMedia.video.mp4}
                data-webm-m={heroMedia.video.mobile_webm}
                data-mp4-m={heroMedia.video.mobile_mp4}
                style={posStyle(heroMedia)}
                tabindex="-1"
                aria-hidden="true"
              />
            )}
          </>
        ) : (
          <div class="hero-media hero-poster hero-kenburns" role="img" aria-label={heroPosterAlt}>
            <svg viewBox="0 0 1841.6 1985.194" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <g fill="currentColor">
                <path d="M 0 1985.194 L 0 766.244 A 240 240 0 0 1 96.456 573.903 L 425 328.71 L 425 1985.194 Z" />
                <path d="M 475.5 1985.194 L 475.5 291.022 L 645.5 164.151 L 645.5 1985.194 Z" />
                <path d="M 696 1985.194 L 696 126.463 L 821.097 33.103 A 166.7 166.7 0 0 1 1020.503 33.103 L 1145.6 126.463 L 1145.6 1985.194 L 1010.2 1985.194 L 1010.2 1538.194 A 89.4 74.7 0 0 0 831.4 1538.194 L 831.4 1985.194 Z" />
                <path d="M 1196.1 1985.194 L 1196.1 164.151 L 1366.1 291.022 L 1366.1 1985.194 Z" />
                <path d="M 1841.6 1985.194 L 1841.6 766.244 A 240 240 0 0 0 1745.144 573.903 L 1416.6 328.71 L 1416.6 1985.194 Z" />
              </g>
            </svg>
          </div>
        )
      }
      {/* over a real photo or video (Ahmed, 5 Nov 2026): no pattern and no flat tint — one midnight scrim behind the text
          only (7 Nov 2026: the text column, with soft edges; bottom-up on phones); the small hero text keeps WCAG AA on
          any image, white or busy (global.css → .hero-scrim; scripts/hero-scrim-check.mjs). ONE layer for every mode:
          a slideshow changes its strength to the incoming photo's, never fades or moves it */}
      {heroMedia && <div class="absolute inset-0 hero-scrim" style={scrimStyle(heroSlides ? heroSlides[0].scrim : heroMedia.scrim)} data-hero-scrim></div>}
      {/* the placeholder poster only: the flat tint and the brand pattern as a slow depth layer (40 s drift of ~2.5 %
          towards the reading direction with a soft opacity swell) */}
      {!heroMedia && <div class="absolute inset-0 bg-midnight/60"></div>}
      {!heroMedia && <div class="absolute inset-0 pattern-bg hero-pattern"></div>}
      <div class="glow"></div>
    </div>
    <div class:list={['relative w-full mx-auto max-w-6xl px-4 py-14 md:py-28', heroMedia && 'hero-over-photo']}>
      {/* hero (9 Oct 2026): eyebrow = "فنادق أرمادا ريزيدنس", h1 = the slogan; no price line, no city name */}
      <p class={`hero-eyebrow ${heroMedia ? 'text-bronze-bright' : 'text-bronze'} font-semibold tracking-wide mb-4`}>{locale === 'ar' ? heroCopy.eyebrow_ar : heroCopy.eyebrow_en}</p>
      <h1 class="text-3xl md:text-5xl font-bold leading-tight max-w-3xl" style={`--hero-rule-delay:${heroRuleDelay}ms`}>
        {heroWords.map((w, i) => (
          <>
            <span class="hero-word" style={`--i:${i}`}>{w}</span>
            {i < heroWords.length - 1 && ' '}
          </>
        ))}
      </h1>
      <span class="hero-rule" aria-hidden="true" style={`--hero-rule-delay:${heroRuleDelay}ms`}></span>
      <p class="hero-sub mt-5 text-lg md:text-xl text-porcelain/85 max-w-2xl leading-relaxed" style={`--hero-rule-delay:${heroRuleDelay}ms`}>
        {locale === 'ar' ? hero.subtitle_ar : hero.subtitle_en}
      </p>
      <div class="hero-ctas mt-8 flex flex-wrap gap-3" style={`--hero-rule-delay:${heroRuleDelay}ms`}>
        <a
          href={localePath(locale, '/booking/')}
          class="inline-flex items-center gap-2 bg-bronze-deep text-white font-semibold px-6 py-3 rounded hover:bg-bronze-text transition-colors"
        >
          <span>{locale === 'ar' ? hero.cta_primary_ar : hero.cta_primary_en}</span>
          <Icon name="arrow" size={18} class="icon-arrow rtl:rotate-180" />
        </a>
        <a
          href="#branches"
          class="inline-flex items-center gap-2 border border-porcelain/50 text-porcelain font-semibold px-6 py-3 rounded hover:bg-porcelain hover:text-midnight transition-colors"
        >
          {locale === 'ar' ? hero.cta_secondary_ar : hero.cta_secondary_en}
        </a>
      </div>
    </div>
    {
      /* pause / play for the moving hero (WCAG 2.2.2, 6 Nov 2026): shown by the script only while something moves */
      (heroSlides || heroMedia?.video) && (
        <button type="button" class="hero-toggle" data-hero-toggle data-paused="false" aria-label={t.home.hero_pause} data-label-pause={t.home.hero_pause} data-label-play={t.home.hero_play} hidden>
          <svg class="i-pause" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
          <svg class="i-play" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 5.5v13l11-6.5z" /></svg>
        </button>
      )
    }
  </section>

  <section class="bg-white border-b border-line">
    <p class="reveal enter mx-auto max-w-6xl px-4 py-4 text-sm text-ink-muted flex items-center gap-2">
      <Icon name="clock" size={16} class="text-bronze shrink-0" />
      <span>{quickFacts}</span>
    </p>
  </section>

  <section id="branches" class="mx-auto max-w-6xl px-4 py-16 scroll-mt-24">
    <h2 class="reveal enter text-2xl md:text-3xl font-bold text-midnight">{t.home.branches_heading}</h2>
    <p class="reveal enter mt-3 text-ink-muted max-w-2xl" style="--reveal-delay:60ms">{t.home.branches_intro}</p>
    <div class="mt-8">
      <BranchSplit locale={locale} branches={branches} />
    </div>
    <Divider class="mt-16" />
  </section>

  {/* the home sections of 7 Nov 2026 (Ahmed's approved design; DECISIONS.md 2026-11-07 «Home sections») — each renders
      only with its content: rooms flagged for the home page, offers flagged for it, … */}
  <HomeRooms locale={locale} />
  <HomeOffers locale={locale} />

  <section class="cv-auto bg-white border-y border-line" aria-labelledby="home-why-heading" data-home-section="why">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 id="home-why-heading" class="reveal text-2xl md:text-3xl font-bold text-midnight">{locale === 'ar' ? why.heading_ar : why.heading_en}</h2>
      <Counters items={siteStats(locale)} class="mt-8" />
      <ul class="reveal-group mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-why-cards>
        {
          why.items.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 shrink-0 w-8 h-8 rounded-full bg-porcelain text-bronze grid place-items-center">
                <Icon name="check" size={18} />
              </span>
              <div>
                <h3 class="font-semibold text-midnight">{locale === 'ar' ? item.title_ar : item.title_en}</h3>
                {/* the sizes are facts of rooms.json ({shafa_room_min} {airport_room_min} {suite_max}, content.ts → withFacts) */}
                <p class="text-sm text-ink-muted mt-1 leading-relaxed">{withFacts(locale, locale === 'ar' ? item.body_ar : item.body_en)}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="pt-16"></div>
  <HomeDining locale={locale} />
  <HomeGallery locale={locale} />
  <HomeReviews locale={locale} />
  <HomePlaces locale={locale} />
  <HomeBlog locale={locale} />

  <Divider class="cv-auto px-4" />
  <section class="cv-auto mx-auto max-w-6xl px-4 py-16 grid gap-10 md:grid-cols-5" data-home-section="about">
    <div class="reveal md:col-span-2">
      <h2 class="text-2xl md:text-3xl font-bold text-midnight">{locale === 'ar' ? about.heading_ar : about.heading_en}</h2>
    </div>
    <div class="reveal md:col-span-3 prose-armada leading-relaxed" style="--reveal-delay:120ms">
      <div data-about-body>{paragraphs(locale === 'ar' ? about.body_ar : about.body_en).map((p) => <p>{p}</p>)}</div>
      {/* «من نحن» (6 Nov 2026) */}
      <p class="mt-4">
        <a href={localePath(locale, '/about/')} class="inline-flex items-center gap-1.5 font-semibold link-bronze" data-about-more>
          <span>{locale === 'ar' ? about.more_ar : about.more_en}</span>
          <Icon name="arrow" size={18} class="icon-arrow rtl:rotate-180" />
        </a>
      </p>
    </div>
  </section>

  <HomeClub locale={locale} />
</Base>

<script>
  import { bindOnce, cssNumber, onPageLeave, onPageLoad } from '@lib/client';

  // The moving hero (5–6 Nov 2026). Deferred hero media — the video loops and the slideshow's photos after the first —
  // never loads with prefers-reduced-motion, Save-Data or a slow connection (2G / 3G or under 1.5 Mbit/s when the
  // browser tells; iOS Safari does not) and is attached only after the page's `load` event and an idle moment, so it
  // never competes with the page's own content (the first picture is the LCP). One pause / play control (WCAG 2.2.2),
  // shown only while something moves; the motion also holds while the tab is hidden or the hero is off screen.
  type Conn = { saveData?: boolean; effectiveType?: string; downlink?: number };
  const still = () => {
    const conn = (navigator as Navigator & { connection?: Conn }).connection;
    const slow = !!conn && (/(^|-)(2g|3g)$/.test(conn.effectiveType ?? '') || (typeof conn.downlink === 'number' && conn.downlink > 0 && conn.downlink < 1.5));
    return matchMedia('(prefers-reduced-motion: reduce)').matches || !!conn?.saveData || slow;
  };
  const afterLoad = (fn: () => void) => {
    const later = () => {
      const w = window as Window & { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => number };
      if (w.requestIdleCallback) w.requestIdleCallback(fn, { timeout: 2500 });
      else setTimeout(fn, 800);
    };
    if (document.readyState === 'complete') later();
    else window.addEventListener('load', later, { once: true });
  };
  const token = (name: string, fallback: number) => cssNumber(getComputedStyle(document.documentElement).getPropertyValue(name)) || fallback;

  /** pausing: by the visitor (the button), the hidden tab, the hero off screen */
  function control(hero: HTMLElement, onChange: (running: boolean) => void) {
    const btn = hero.querySelector<HTMLButtonElement>('[data-hero-toggle]');
    const why = { user: false, hidden: document.hidden, offscreen: false };
    const apply = () => {
      const running = !why.user && !why.hidden && !why.offscreen;
      hero.classList.toggle('is-paused', !running);
      onChange(running);
    };
    if (btn) {
      btn.hidden = false;
      btn.addEventListener('click', () => {
        why.user = !why.user;
        btn.dataset.paused = String(why.user);
        btn.setAttribute('aria-label', (why.user ? btn.dataset.labelPlay : btn.dataset.labelPause) ?? '');
        apply();
      });
    }
    const onVis = () => {
      why.hidden = document.hidden;
      apply();
    };
    document.addEventListener('visibilitychange', onVis);
    const io = new IntersectionObserver(([e]) => {
      why.offscreen = !e.isIntersecting;
      apply();
    });
    io.observe(hero);
    return () => {
      document.removeEventListener('visibilitychange', onVis);
      io.disconnect();
    };
  }

  /** «صور متتابعة»: each photo stays --motion-hero-hold, the next fades in over --motion-hero-fade, Ken Burns in / out */
  function slideshow(hero: HTMLElement, show: HTMLElement) {
    const slides = [...show.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    if (slides.length < 2) return;
    const hold = token('--motion-hero-hold', 6000);
    const fade = token('--motion-hero-fade', 1200);
    const ready = new Map<number, Promise<void>>();
    /** the photo's real sources, then its decode (a slow photo delays the change, never shows half-loaded) */
    const load = (i: number) => {
      if (!ready.has(i)) {
        const sl = slides[i];
        for (const el of sl.querySelectorAll<HTMLSourceElement | HTMLImageElement>('[data-srcset]')) {
          el.srcset = el.dataset.srcset ?? '';
          el.removeAttribute('data-srcset');
        }
        const img = sl.querySelector<HTMLImageElement>('img');
        if (img?.dataset.src) {
          img.src = img.dataset.src;
          img.removeAttribute('data-src');
        }
        ready.set(i, img ? img.decode().catch(() => {}) : Promise.resolve());
      }
      return ready.get(i)!;
    };
    let cur = 0;
    let timer = 0;
    let due = 0; // when the next change is due (performance.now())
    let left = hold; // what was left of the hold when paused
    let running = false;
    let changing = false;
    // the one scrim layer (7 Nov 2026): while two photos are on screen it holds the stronger of their two measures, then
    // settles on the incoming one's — its opacity eases (global.css), it never fades out or moves
    const scrim = hero.querySelector<HTMLElement>('[data-hero-scrim]');
    const VARS = ['--scrim-m', '--scrim-md', '--scrim-lg-rtl', '--scrim-lg-ltr'];
    const measure = (sl: HTMLElement) => (sl.dataset.scrim ?? '').split(',').map(Number);
    const setScrim = (vals: number[]) => {
      if (!scrim || vals.length !== VARS.length || vals.some((v) => !Number.isFinite(v))) return;
      VARS.forEach((name, i) => scrim.style.setProperty(name, String(vals[i])));
    };
    const kb = (sl: HTMLElement, n: number) => {
      sl.classList.remove('kb-in', 'kb-out');
      void sl.offsetWidth; // restart the move
      sl.classList.add(n % 2 === 0 ? 'kb-in' : 'kb-out');
    };
    const schedule = (ms: number) => {
      clearTimeout(timer);
      due = performance.now() + ms;
      timer = window.setTimeout(change, ms);
    };
    async function change() {
      if (!running || changing) return;
      changing = true;
      const n = (cur + 1) % slides.length;
      await load(n);
      if (!running) {
        changing = false;
        left = 0;
        return;
      }
      const from = slides[cur];
      const to = slides[n];
      const a = measure(from);
      const b = measure(to);
      setScrim(b.map((v, i) => Math.max(v, a[i] ?? v)));
      kb(to, n);
      to.removeAttribute('aria-hidden');
      to.classList.add('is-next');
      window.setTimeout(() => {
        from.classList.remove('is-active', 'kb-in', 'kb-out');
        from.setAttribute('aria-hidden', 'true');
        to.classList.add('is-active');
        to.classList.remove('is-next');
        setScrim(b);
        cur = n;
        changing = false;
        load((n + 1) % slides.length); // one ahead
        if (running) schedule(hold);
        else left = hold;
      }, fade);
    }
    const stop = control(hero, (r) => {
      if (r === running) return;
      running = r;
      if (r) schedule(left);
      else {
        clearTimeout(timer);
        left = Math.max(0, due - performance.now());
      }
    });
    kb(slides[0], 0);
    load(1);
    onPageLeave(() => {
      clearTimeout(timer);
      running = false;
      stop();
    });
  }

  /** the video: from 768 px the desktop loop (WebM first), below it the 4:5 phone loop (MP4 first); fades in over the
   *  poster — the loop's own first frame at the same position, so nothing jumps */
  function video(hero: HTMLElement, v: HTMLVideoElement) {
    const phone = !matchMedia('(min-width: 768px)').matches;
    const sources = (
      phone
        ? [['video/mp4', v.dataset.mp4M], ['video/webm', v.dataset.webmM]]
        : [['video/webm', v.dataset.webm], ['video/mp4', v.dataset.mp4]]
    ).filter((x): x is [string, string] => !!x[1]);
    if (!sources.length) return;
    for (const [type, src] of sources) {
      const s = document.createElement('source');
      s.src = src;
      s.type = type;
      v.appendChild(s);
    }
    v.muted = true; // iOS plays inline only muted (the attribute alone is not always reflected)
    v.load();
    v.play()
      .then(() => {
        v.classList.add('is-playing');
        const stop = control(hero, (running) => {
          if (running) v.play().catch(() => {});
          else v.pause();
        });
        onPageLeave(stop);
      })
      .catch(() => {});
  }

  onPageLoad(() => {
    const hero = document.querySelector<HTMLElement>('section.hero');
    if (!hero || !bindOnce(hero, 'hero-bound')) return;
    const show = hero.querySelector<HTMLElement>('[data-hero-show]');
    const v = hero.querySelector<HTMLVideoElement>('video.hero-video');
    if ((!show && !v) || still()) return;
    afterLoad(() => (show ? slideshow(hero, show) : v && video(hero, v)));
  });
</script>
