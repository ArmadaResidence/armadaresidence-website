---
import Base from '@layouts/Base.astro';
import BranchCard from '@components/BranchCard.astro';
import Icon from '@components/Icon.astro';
import { langPaths } from '@lib/paths';
import { organization } from '@lib/jsonld';
import { existsSync } from 'node:fs';
import {
  branches,
  fill,
  heroPriceLine,
  localePath,
  pageSeo,
  paragraphs,
  policies,
  siteTexts,
  ui,
  type Locale,
} from '@lib/content';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const s = pageSeo(locale, 'home');
const hero = siteTexts.hero;

// Hero video: content/images/hero/{hero.webm, hero.mp4, hero-poster.webp} (synced to public/images/ by build.py).
// Until the files arrive the grey placeholder acts as poster with a slow Ken Burns move. TODO(photo)
const heroDir = new URL('../../../content/images/hero/', import.meta.url);
const hasHeroVideo = ['hero.webm', 'hero.mp4', 'hero-poster.webp'].every((f) => existsSync(new URL(f, heroDir)));
const heroPosterAlt = fill(t.photo_pending_alt, { subject: locale === 'ar' ? hero.title_ar : hero.title_en });
const about = siteTexts.about;
const why = siteTexts.why_armada;
const slogan = locale === 'ar' ? siteTexts.slogan_ar : siteTexts.slogan_en;
const quickFacts = fill(t.home.quick_facts, {
  check_in: locale === 'ar' ? policies.check_in_ar : policies.check_in_en,
  check_out: locale === 'ar' ? policies.check_out_ar : policies.check_out_en,
  hours: policies.cancellation.free_until_hours_before_arrival,
});
---

<Base locale={locale} path="/" title={s.title} description={s.description} jsonld={[organization(locale)]}>
  <section class="hero relative bg-midnight text-porcelain overflow-hidden lg:min-h-[560px] flex items-center">
    <div class="absolute inset-0" aria-hidden="true">
      {
        hasHeroVideo ? (
          <video
            class="hero-media hero-kenburns"
            muted
            autoplay
            loop
            playsinline
            preload="none"
            poster="/images/hero/hero-poster.webp"
            data-webm="/images/hero/hero.webm"
            data-mp4="/images/hero/hero.mp4"
            tabindex="-1"
          />
        ) : (
          <div class="hero-media hero-poster hero-kenburns" role="img" aria-label={heroPosterAlt}>
            <svg viewBox="0 0 1841.6 1985.194" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <g fill="currentColor">
                <path d="M 0 1985.194 L 0 766.244 A 240 240 0 0 1 96.456 573.903 L 425 328.71 L 425 1985.194 Z" />
                <path d="M 475.5 1985.194 L 475.5 291.022 L 645.5 164.151 L 645.5 1985.194 Z" />
                <path d="M 696 1985.194 L 696 126.463 L 821.097 33.103 A 166.7 166.7 0 0 1 1020.503 33.103 L 1145.6 126.463 L 1145.6 1985.194 L 1010.2 1985.194 L 1010.2 1538.194 A 89.4 74.7 0 0 0 831.4 1538.194 L 831.4 1985.194 Z" />
                <path d="M 1196.1 1985.194 L 1196.1 164.151 L 1366.1 291.022 L 1366.1 1985.194 Z" />
                <path d="M 1841.6 1985.194 L 1841.6 766.244 A 240 240 0 0 0 1745.144 573.903 L 1416.6 328.71 L 1416.6 1985.194 Z" />
              </g>
            </svg>
          </div>
        )
      }
      <div class="absolute inset-0 bg-midnight/60"></div>
      <div class="absolute inset-0 pattern-bg"></div>
    </div>
    <div class="relative w-full mx-auto max-w-6xl px-4 py-14 md:py-28">
      <p class="text-bronze font-semibold tracking-wide mb-4">{slogan}</p>
      <h1 class="text-3xl md:text-5xl font-bold leading-tight max-w-3xl">{locale === 'ar' ? hero.title_ar : hero.title_en}</h1>
      <p class="mt-5 text-lg md:text-xl text-porcelain/85 max-w-2xl leading-relaxed">
        {locale === 'ar' ? hero.subtitle_ar : hero.subtitle_en}
      </p>
      <p class="mt-3 text-base md:text-lg font-semibold text-white">{heroPriceLine(locale)}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={localePath(locale, '/booking/')}
          class="inline-flex items-center gap-2 bg-bronze text-white font-semibold px-6 py-3 rounded hover:bg-bronze-deep transition-colors"
        >
          <span>{locale === 'ar' ? hero.cta_primary_ar : hero.cta_primary_en}</span>
          <Icon name="arrow" size={18} class="rtl:rotate-180" />
        </a>
        <a
          href="#branches"
          class="inline-flex items-center gap-2 border border-porcelain/50 text-porcelain font-semibold px-6 py-3 rounded hover:bg-porcelain hover:text-midnight transition-colors"
        >
          {locale === 'ar' ? hero.cta_secondary_ar : hero.cta_secondary_en}
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white border-b border-line">
    <p class="mx-auto max-w-6xl px-4 py-4 text-sm text-ink-muted flex items-center gap-2">
      <Icon name="clock" size={16} class="text-bronze shrink-0" />
      <span>{quickFacts}</span>
    </p>
  </section>

  <section id="branches" class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl md:text-3xl font-bold text-midnight">{t.home.branches_heading}</h2>
    <p class="mt-3 text-ink-muted max-w-2xl">{t.home.branches_intro}</p>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {branches.map((b) => <BranchCard locale={locale} branch={b} />)}
    </div>
  </section>

  <section class="bg-white border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl md:text-3xl font-bold text-midnight">{locale === 'ar' ? why.heading_ar : why.heading_en}</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          why.items.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 shrink-0 w-8 h-8 rounded-full bg-porcelain text-bronze grid place-items-center">
                <Icon name="check" size={18} />
              </span>
              <div>
                <h3 class="font-semibold text-midnight">{locale === 'ar' ? item.title_ar : item.title_en}</h3>
                <p class="text-sm text-ink-muted mt-1 leading-relaxed">{locale === 'ar' ? item.body_ar : item.body_en}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 grid gap-10 md:grid-cols-5">
    <div class="md:col-span-2">
      <h2 class="text-2xl md:text-3xl font-bold text-midnight">{locale === 'ar' ? about.heading_ar : about.heading_en}</h2>
    </div>
    <div class="md:col-span-3 prose-armada leading-relaxed">
      {paragraphs(locale === 'ar' ? about.body_ar : about.body_en).map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="bg-midnight text-porcelain">
    <div class="mx-auto max-w-6xl px-4 py-12 flex flex-wrap items-center justify-between gap-6">
      <p class="text-xl font-semibold">{slogan}</p>
      <div class="flex flex-wrap gap-3">
        <a href={localePath(locale, '/booking/')} class="bg-bronze text-white font-semibold px-6 py-3 rounded hover:bg-bronze-deep transition-colors">
          {t.nav.book}
        </a>
        <a href="#branches" class="border border-porcelain/50 font-semibold px-6 py-3 rounded hover:bg-porcelain hover:text-midnight transition-colors">
          {t.home.rooms_cta}
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Hero video: desktop only, never with prefers-reduced-motion or Save-Data, attached after `load` so it cannot
  // affect LCP. Otherwise the poster stays with the Ken Burns move.
  const v = document.querySelector<HTMLVideoElement>('video.hero-media');
  if (v) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const allowed =
      matchMedia('(min-width: 1024px)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches && !(conn && conn.saveData);
    if (allowed) {
      const attach = () => {
        for (const [type, src] of [
          ['video/webm', v.dataset.webm],
          ['video/mp4', v.dataset.mp4],
        ] as const) {
          if (!src) continue;
          const s = document.createElement('source');
          s.src = src;
          s.type = type;
          v.appendChild(s);
        }
        v.load();
        v.play()
          .then(() => v.classList.remove('hero-kenburns'))
          .catch(() => {});
      };
      if (document.readyState === 'complete') attach();
      else window.addEventListener('load', attach, { once: true });
    }
  }
</script>
