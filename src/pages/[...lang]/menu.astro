---
/**
 * /menu/ — the café's interactive menu (legacy single-file site kept as is: scroll-driven frame scenes, cart,
 * WhatsApp ordering), scoped under .legacy-menu with the site header/footer around it.
 *   data   content/menu.json (+ contact.json → cafe.whatsapp)           generated by scripts/legacy-menu-port.py
 *   css    src/styles/legacy-menu.css (scoped by scripts/legacy-css.py)  + legacy-overrides.css (header offset, FAB)
 *   js     public/legacy/menu.js (reads #armada-menu-cfg)
 *   frames public/menu/frames/<section>/{desktop,mobile}/frame_NNNN.webp (copied without re-encoding)
 * Language comes from the page (/menu/ = ar, /en/menu/ = en); the legacy AR/EN toggle links between the two.
 * Favicon on this page = the café favicon (brand/cafe identity); logo = the café name logo, porcelain on dark.
 */
import '../../styles/legacy-menu.css';
import '../../styles/legacy-overrides.css';
import Base from '@layouts/Base.astro';
import { langPaths } from '@lib/paths';
import { branchBySlug, branchPath, contact, footerLine, L, localePath, pageSeo, ui, waHref, type Locale } from '@lib/content';
import menuJson from '../../../content/menu.json';

export const getStaticPaths = langPaths;
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const m = t.menu_page;
const s = pageSeo(locale, 'menu');
const site = menuJson.site;
const cfg = {
  lang: locale,
  config: {
    whatsappNumber: contact.cafe.whatsapp.replace(/\D/g, ''),
    showPendingItems: site.show_pending_items,
    hiddenItems: site.hidden_items,
    vipOverride: site.vip_override,
    sceneLength: site.scene_length,
    snacksLength: site.snacks_length,
    // v19: section order by Riyadh time (breakfast first until 11), breakfast chip outside its service hours
    morningOrder: site.morning_order,
    dayOrder: site.day_order,
    breakfastFirstUntilHour: site.breakfast_first_until_hour,
    timeZone: site.time_zone,
    serviceHours: site.service_hours,
  },
  data: { sections: menuJson.sections, items: menuJson.items, subcats_en: menuJson.subcats_en, vip: menuJson.vip, catalog_version: menuJson.catalog_version },
  // video_mode (content/menu.json → site): off = the original frame engine; on = per-scene WebM scrubbed by scroll
  frames: site.video_mode ? menuJson.frames : Object.fromEntries(Object.entries(menuJson.frames).map(([k, v]) => [k, Object.fromEntries(Object.entries(v).filter(([kk]) => kk !== 'video'))])),
};
const frames = menuJson.frames as Record<string, { sets: { desktop: { pattern: string } } }>;
const firstFrame = frames[menuJson.sections[0].folder].sets.desktop.pattern.replace('%04d', '0000');
const icons = { svg: '/brand/cafe/favicon.svg', png32: '/brand/cafe/favicon-32.png', apple: '/brand/cafe/apple-touch-icon.png' };
// Café footer (the legacy menu footer, café identity) — every line from contact.json → cafe / branches.json / legal.json
const cafe = contact.cafe as typeof contact.cafe & { room_extension_ar: string; room_extension_en: string; linktree: string };
const airport = branchBySlug('airport-road');
const linktreeShort = cafe.linktree.replace(/^https?:\/\//, '');
const ICON = {
  download: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>',
  wa: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>',
};
---

<Base locale={locale} path="/menu/" title={s.title} description={s.description} icons={icons} hideFooter>
  <link slot="head" rel="preload" as="image" href={firstFrame} />
  <div class="legacy-menu">
    <h1 class="sr">{m.h1}</h1>
    <a class="sr" href="#scenes" data-i18n="skip">{locale === 'ar' ? 'تخطَّ إلى القائمة' : 'Skip to menu'}</a>

    <header class="top">
      <div class="tools start">
        <button class="cartbtn clear" id="clearTop" hidden><span data-i18n="clear">{locale === 'ar' ? 'مسح' : 'Clear'}</span></button>
        <a class="cartbtn pdf" id="pdfTop" href={site.pdf} target="_blank" rel="noopener" download><Fragment set:html={ICON.download} /><span>PDF</span></a>
      </div>
      <a class="brand" href="#" id="home" aria-label={m.logo_alt}><img src="/brand/cafe/logo-porcelain.svg" alt={m.logo_alt} width="1744" height="598" /></a>
      <div class="tools">
        <div class="lang" role="group" aria-label={m.lang_label}>
          <a href={localePath('ar', '/menu/')} hreflang="ar" lang="ar" aria-current={locale === 'ar' ? 'page' : undefined}>AR</a><a href={localePath('en', '/menu/')} hreflang="en" lang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
        </div>
      </div>
    </header>
    <nav class="rail" id="rail" aria-label={locale === 'ar' ? 'الأقسام' : 'Sections'}></nav>

    <div id="scenes" class="scenes"></div>

    <button class="fab" id="cartBtn" aria-controls="drawer" aria-expanded="false" aria-label={m.cart}>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 8H6.2"/><circle cx="9" cy="20" r="1"/><circle cx="17" cy="20" r="1"/></svg>
      <span class="count" id="cartCount"></span>
    </button>

    <div class="dim" id="dim"></div>
    <aside class="drawer" id="drawer" aria-label={m.cart} aria-hidden="true">
      <header><h2 data-i18n="yourOrder">{locale === 'ar' ? 'طلبك' : 'Your order'}</h2><button class="x" id="closeCart" aria-label={m.close}>×</button></header>
      <div class="list" id="cartList"></div>
      <footer>
        <div class="tot"><span data-i18n="total">{locale === 'ar' ? 'الإجمالي' : 'Total'}</span><span class="price" id="cartTotal"></span></div>
        <a class="btn primary" id="waBtn" target="_blank" rel="noopener" href="#"></a>
        <button class="btn ghost" id="copyBtn"></button>
        <button class="btn ghost clearbtn" id="clearBtn"></button>
        <p class="hint" id="cartHint"></p>
      </footer>
    </aside>
    <div class="toast" id="toast"></div>

    <footer class="site">
      <img src="/brand/cafe/logo-porcelain.svg" alt={m.logo_alt} width="1744" height="598" />
      <div>{locale === 'ar' ? cafe.room_extension_ar : cafe.room_extension_en}</div>
      <div class="hair"></div>
      <div>
        <a href={branchPath(locale, 'airport-road')}>
          <span class="en">{cafe.name}</span> — {L(locale, airport, 'name')}
        </a>
      </div>
      <div class="social">
        <a class="sbtn wa" href={waHref(cafe.whatsapp)} target="_blank" rel="noopener"><Fragment set:html={ICON.wa} /><span>{m.footer_whatsapp}</span></a>
        <a class="sbtn" href={cafe.linktree} target="_blank" rel="noopener"><span>{m.footer_follow}</span> <span class="en" dir="ltr">{linktreeShort}</span></a>
        <a class="sbtn" id="footPdf" href={site.pdf} target="_blank" rel="noopener" download><Fragment set:html={ICON.download} /><span>{m.footer_pdf}</span></a>
      </div>
      <div class="cfg">{footerLine(locale)}</div>
    </footer>

    <script type="application/json" id="armada-menu-cfg" set:html={JSON.stringify(cfg).replace(/</g, '\\u003c')} />
  </div>
  <script src="/legacy/menu.js" defer is:inline></script>
</Base>
