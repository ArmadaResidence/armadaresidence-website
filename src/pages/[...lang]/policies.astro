---
import Base from '@layouts/Base.astro';
import { langPaths } from '@lib/paths';
import { localePath, pageSeo, paragraphs, policies, stripBrackets, ui, withFees, type Locale } from '@lib/content';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const s = pageSeo(locale, 'policies');
const page = policies.page;
// Editorial brackets (e.g. the phase-3 payment note) are stripped — nothing in [ … ] reaches the visitor. The fees
// ({extra_bed}, {breakfast}) come from the dashboard Settings at build time, through the riyal formatter (2 Nov 2026).
const sections = page.sections.map((sec) => ({
  id: sec.id,
  heading: stripBrackets(locale === 'ar' ? sec.heading_ar : sec.heading_en),
  paragraphs: paragraphs(withFees(locale, locale === 'ar' ? sec.body_ar : sec.body_en)),
}));
// another section named in quotes («نادي أرمادا ريزيدنس والتسويق» / "Armada Residence Club and marketing") links to its
// anchor (4 Nov 2026); the quotes stay outside the link
const esc = (x: string) => x.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const linkable = (selfId: string) => sections.filter((x) => x.id !== selfId && x.heading);
function parts(text: string, selfId: string): { text: string; href?: string }[] {
  const others = linkable(selfId);
  if (!others.length) return [{ text }];
  const re = new RegExp(`(?<=[«"“])(${others.map((x) => esc(x.heading)).join('|')})(?=[»"”])`, 'g');
  const out: { text: string; href?: string }[] = [];
  let at = 0;
  for (const m of text.matchAll(re)) {
    if (m.index! > at) out.push({ text: text.slice(at, m.index) });
    out.push({ text: m[1], href: `#${others.find((x) => x.heading === m[1])!.id}` });
    at = m.index! + m[1].length;
  }
  if (at < text.length) out.push({ text: text.slice(at) });
  return out;
}
---

<Base locale={locale} path="/policies/" title={s.title} description={s.description}>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-14 grid gap-10 lg:grid-cols-4">
    <div class="lg:col-span-3">
      <h1 class="text-3xl md:text-4xl font-bold text-midnight">{stripBrackets(locale === 'ar' ? page.title_ar : page.title_en)}</h1>
      <p class="mt-3 text-ink-muted">{stripBrackets(locale === 'ar' ? page.intro_ar : page.intro_en)}</p>
      <p class="mt-2 text-ink-muted" data-faq-link-line>
        {t.faq.link_lead}
        <a href={localePath(locale, '/faq/')} class="font-semibold link-bronze ms-1">{t.faq.link_text}</a>
      </p>

      <details class="lg:hidden mt-6 bg-white border border-line rounded-card px-5 py-3">
        <summary class="cursor-pointer text-sm font-semibold uppercase tracking-wide text-bronze-text py-1">{t.policies.toc}</summary>
        <ol class="mt-3 mb-2 space-y-2 text-sm">
          {
            sections.map((sec) => (
              <li>
                <a href={`#${sec.id}`} class="text-ink-muted hover:text-midnight">
                  {sec.heading}
                </a>
              </li>
            ))
          }
        </ol>
      </details>

      <div class="mt-10 space-y-10">
        {
          sections.map((sec, i) => (
            <section id={sec.id} class:list={['reveal scroll-mt-24', i < 4 && 'enter']}>
              <h2 class="text-xl font-semibold text-midnight">{sec.heading}</h2>
              <div class="mt-3 prose-armada leading-relaxed text-ink">
                {sec.paragraphs.map((p) => (
                  <p>{parts(p, sec.id).map((x) => (x.href ? <a href={x.href} class="link-bronze underline underline-offset-2">{x.text}</a> : x.text))}</p>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
    <nav class="hidden lg:block lg:col-span-1 lg:sticky lg:top-24 self-start bg-white border border-line rounded-card p-5" aria-label={t.policies.toc}>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-bronze-text">{t.policies.toc}</h2>
      <ol class="mt-3 space-y-2 text-sm">
        {
          sections.map((sec) => (
            <li>
              <a href={`#${sec.id}`} class="text-ink-muted hover:text-midnight">
                {sec.heading}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>
</Base>
