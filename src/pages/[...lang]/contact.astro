---
import Base from '@layouts/Base.astro';
import Icon from '@components/Icon.astro';
import { langPaths } from '@lib/paths';
import {
  branchContact,
  branchPath,
  branches,
  contact,
  L,
  localePath,
  mailHref,
  pageSeo,
  policies,
  telHref,
  ui,
  waHref,
  type Locale,
} from '@lib/content';

export const getStaticPaths = langPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const s = pageSeo(locale, 'contact');

const social: { name: string; url: string }[] = [
  { name: 'Instagram', url: contact.social.instagram },
  { name: 'Facebook', url: contact.social.facebook },
  { name: 'TikTok', url: contact.social.tiktok },
  { name: 'Snapchat', url: contact.social.snapchat },
  { name: 'YouTube', url: contact.social.youtube },
];
---

<Base locale={locale} path="/contact/" title={s.title} description={s.description}>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-14">
    <h1 class="text-3xl md:text-4xl font-bold text-midnight">{t.contact.heading}</h1>
    <p class="mt-3 text-ink-muted max-w-2xl">
      {t.contact.intro}
      <a href={localePath(locale, '/offers/')} class="font-semibold text-bronze hover:text-bronze-deep ms-1">{t.nav.offers}</a>
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        branches.map((b) => {
          const c = branchContact(b.slug);
          const na = b.national_address;
          return (
            <section class="bg-white border border-line rounded-card p-6">
              <p class="text-xs font-semibold uppercase tracking-wide text-bronze">{L(locale, b, 'type')}</p>
              <h2 class="mt-1 text-xl font-semibold text-midnight">
                <a href={branchPath(locale, b.slug)} class="hover:text-bronze">
                  {L(locale, b, 'name')}
                </a>
              </h2>
              <dl class="mt-5 space-y-4 text-sm">
                <div class="flex gap-3">
                  <Icon name="map" size={18} class="text-bronze shrink-0 mt-0.5" />
                  <div>
                    <dt class="font-semibold text-midnight">{t.branch.address}</dt>
                    <dd class="text-ink-muted">{L(locale, b, 'address')}</dd>
                    <dd class="text-ink-muted latin mt-1" dir="ltr">
                      {t.contact.national_address}: {na.short_code} · {t.contact.additional_number}: {na.additional_number} · {t.contact.postal_code}: {na.postal_code}
                    </dd>
                    <dd class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
                      <a href={b.maps_url} rel="noopener" target="_blank" class="font-semibold text-bronze hover:text-bronze-deep">
                        {t.cta.maps}
                      </a>
                      <a href={b.google_business_url} rel="noopener" target="_blank" class="font-semibold text-bronze hover:text-bronze-deep">
                        {t.cta.google_reviews}
                      </a>
                    </dd>
                  </div>
                </div>
                <div class="flex gap-3">
                  <Icon name="phone" size={18} class="text-bronze shrink-0 mt-0.5" />
                  <div>
                    <dt class="font-semibold text-midnight">{t.contact.phone} / {t.cta.whatsapp}</dt>
                    <dd class="flex flex-wrap gap-x-4 gap-y-1">
                      <a href={telHref(c.phone)} class="latin text-ink-muted hover:text-midnight" dir="ltr">
                        {c.phone_display}
                      </a>
                      <a href={waHref(c.whatsapp)} rel="noopener" target="_blank" class="font-semibold text-bronze hover:text-bronze-deep">
                        {t.cta.whatsapp_title}
                      </a>
                    </dd>
                  </div>
                </div>
                <div class="flex gap-3">
                  <Icon name="mail" size={18} class="text-bronze shrink-0 mt-0.5" />
                  <div>
                    <dt class="font-semibold text-midnight">{t.contact.reservations_email}</dt>
                    <dd>
                      <a href={mailHref(b.email)} class="latin text-ink-muted hover:text-midnight" dir="ltr">
                        {b.email}
                      </a>
                    </dd>
                  </div>
                </div>
                <div class="flex gap-3">
                  <Icon name="clock" size={18} class="text-bronze shrink-0 mt-0.5" />
                  <div>
                    <dt class="font-semibold text-midnight">{t.contact.hours}</dt>
                    <dd class="text-ink-muted">
                      {locale === 'ar' ? contact.working_hours_ar : contact.working_hours_en}
                      <br />
                      {locale === 'ar' ? policies.check_in_ar : policies.check_in_en} · {locale === 'ar' ? policies.check_out_ar : policies.check_out_en}
                    </dd>
                  </div>
                </div>
              </dl>
            </section>
          );
        })
      }
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <section class="bg-white border border-line rounded-card p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-bronze">{t.cta.email}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <span class="text-ink-muted">{t.contact.reservations_email}: </span>
            <a href={mailHref(contact.emails.reservations)} class="latin font-medium hover:text-bronze" dir="ltr">{contact.emails.reservations}</a>
          </li>
          <li>
            <span class="text-ink-muted">{t.contact.general_email}: </span>
            <a href={mailHref(contact.emails.info)} class="latin font-medium hover:text-bronze" dir="ltr">{contact.emails.info}</a>
          </li>
          <li>
            <a href={contact.menu_url} rel="noopener" class="font-medium text-bronze hover:text-bronze-deep">{t.cta.menu_link}</a>
          </li>
        </ul>
      </section>
      <section class="bg-white border border-line rounded-card p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-bronze">{t.contact.social_heading}</h2>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {
            social.map((x) => (
              <li>
                <a href={x.url} rel="noopener" class="latin font-medium hover:text-bronze">
                  {x.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>
</Base>
