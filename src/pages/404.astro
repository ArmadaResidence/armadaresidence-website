---
/**
 * Single 404 for GitHub Pages (served for any missing path). Arabic first, English below, both branches linked.
 * Old /branches/<uuid> URLs: the 2 branch and 10 room IDs have exact redirect pages (4 Nov 2026); this page sends any
 * other /branches/*, /admin/*, /offers/<id> and /blog/<slug> hit to its closest page (redirects.json `via: 404`).
 */
import Base from '@layouts/Base.astro';
import Icon from '@components/Icon.astro';
import { branchPath, branches, L, localePath, pageSeo, sectionVisible, ui, type Locale } from '@lib/content';
import { galleryLive } from '@lib/gallery';

const ar = ui('ar');
const en = ui('en');
const s = pageSeo('ar', '404');
const locales: Locale[] = ['ar', 'en'];
// the old /gallery (Horizons) → home only while /gallery/ is not built and not hidden (hidden: astro.config.mjs redirects it)
const galleryHome = !galleryLive && sectionVisible('gallery');
---

<Base locale="ar" path="/404/" switchPath="/" title={s.title} description={s.description} noindex={true} notFound>
  <script is:inline define:vars={{ galleryHome }}>
    // no ^ anchor: also matches under a review sub-path (scripts/base-path.py rewrites the quoted site paths). The old
    // Horizons wildcards (redirects.json `via: 404`, 4 Nov 2026): /branches/* → home, /admin/* → the dashboard's
    // sign-in, an unknown /offers/<id> → /offers/, an unknown /blog/<slug> → /blog/.
    (function () {
      var p = location.pathname;
      if (/\/branches(\/|$)/.test(p)) location.replace('/');
      else if (/\/admin(\/|$)/.test(p)) location.replace('https://admin.armadaresidence.com/');
      else if (p.indexOf('/offers/') === 0) location.replace('/offers/');
      else if (p.indexOf('/blog/') === 0) location.replace('/blog/');
      else if (galleryHome && /\/gallery\/?$/.test(p) && !/\/en\/gallery/.test(p)) location.replace('/');
    })();
  </script>
  <section class="mx-auto max-w-3xl px-4 py-20 space-y-12">
    {
      locales.map((locale) => {
        const t = locale === 'ar' ? ar : en;
        return (
          <div lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'} class:list={[locale === 'en' ? 'font-en border-t border-line pt-10' : '']}>
            {locale === 'ar' ? (
              <h1 class="text-3xl font-bold text-midnight">{t.not_found.heading}</h1>
            ) : (
              <h2 class="text-2xl font-bold text-midnight">{t.not_found.heading}</h2>
            )}
            <p class="mt-3 text-ink-muted">{t.not_found.body}</p>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
              {branches.map((b) => (
                <li>
                  <a
                    href={branchPath(locale, b.slug)}
                    class="flex items-center justify-between gap-3 bg-white border border-line rounded-card px-4 py-3 hover:border-bronze"
                  >
                    <span>
                      <span class="block text-xs font-semibold uppercase tracking-wide text-bronze-text">{L(locale, b, 'type')}</span>
                      <span class="block font-semibold text-midnight">{L(locale, b, 'name')}</span>
                    </span>
                    <Icon name="arrow" size={18} class={locale === 'ar' ? 'rotate-180 text-bronze' : 'text-bronze'} />
                  </a>
                </li>
              ))}
            </ul>
            <a
              href={localePath(locale, '/')}
              class="mt-6 inline-block border border-midnight text-midnight font-semibold px-5 py-3 rounded hover:bg-midnight hover:text-white"
            >
              {t.not_found.home}
            </a>
          </div>
        );
      })
    }
  </section>
</Base>
